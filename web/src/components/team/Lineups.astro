---
// The Lineups tab: the club's best duos and five-man units, by net rating per 100 possessions.
// Data: seasons/{season}/units.json (stats/units.py), this club's rows for every published season.
import { lines, PAIR_SIZE, sortLines, UNIT_SIZE, type ClubUnits } from "../../lib/lineups";
import { lineupRowsHtml, type PlayerName } from "../../lib/lineups_html";
import { tip } from "../../lib/tip";

interface Props {
  /** The club's code (source-independent URL key for the per-season data file). */
  code: string;
  /** The page's season: the one shown first, and the one the page's season select starts on. */
  season: number;
  /** This season's lineups only; other seasons are fetched when the visitor switches to them. */
  seasons: ClubUnits;
  names: Record<string, PlayerName>;
}

const { code, season, seasons, names } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const current = seasons[String(season)];
const duos = current ? sortLines(lines(current.pairs, PAIR_SIZE), "net") : [];
const units = current ? sortLines(lines(current.units, UNIT_SIZE), "net") : [];
const payload = JSON.stringify({ code, seasons, names, base, initial: season });
---

<section class="band lineups" id="lineups" aria-labelledby="lineups-title">
  <header class="sec-head">
    <h2 id="lineups-title">Lineups</h2>
    <p>The club's best duos and five-man units, from the stints. Net rating is points scored minus points allowed per 100 possessions played together.</p>
  </header>
  <p class="note" id="lineups-caveat">Lineup ratings are noisy: a few possessions can swing them far. The ± is a rough 95% range from the possession count alone.</p>
  <p class="note" id="lineups-note" hidden={!!current}>Lineups are not published for this season: too few of its stints pass the checks.</p>
  <script type="application/json" id="lineups-data" set:html={payload} />

  <div id="duos-wrap" hidden={!current}>
    <h3 class="lineups-title">Best duos</h3>
    <div class="scroll">
      <table class="grid lineups-table" data-table="duos">
        <caption class="sr-only">Best duos, two players on court together: minutes, possessions and net rating per 100 possessions</caption>
        <thead>
          <tr>
            <th scope="col">Players</th>
            <th scope="col" class="num"><button type="button" class="sort" data-table="duos" data-by="minutes" aria-pressed="false"><span data-tip={tip`<b>Minutes</b><br>Time the two players were on court together`}>Minutes</span></button></th>
            <th scope="col" class="num">Poss</th>
            <th scope="col" class="num"><button type="button" class="sort" data-table="duos" data-by="net" aria-pressed="true"><span data-tip={tip`<b>Net rating</b><br>Points scored minus points allowed per 100 possessions played together`}>Net</span></button></th>
            <th scope="col" class="num"><span data-tip={tip`<b>Range</b><br>A rough 95% range either side of the net rating, from the possession count alone`}>Range (±)</span></th>
          </tr>
        </thead>
        <tbody id="duos-body" set:html={lineupRowsHtml(duos, names, base)} />
      </table>
    </div>
  </div>

  <div id="units-wrap" hidden={!current}>
    <h3 class="lineups-title">Best units</h3>
    <div class="scroll">
      <table class="grid lineups-table" data-table="units">
        <caption class="sr-only">Best five-man units: minutes, possessions and net rating per 100 possessions</caption>
        <thead>
          <tr>
            <th scope="col">Players</th>
            <th scope="col" class="num"><button type="button" class="sort" data-table="units" data-by="minutes" aria-pressed="false"><span data-tip={tip`<b>Minutes</b><br>Time the five were on court together`}>Minutes</span></button></th>
            <th scope="col" class="num">Poss</th>
            <th scope="col" class="num"><button type="button" class="sort" data-table="units" data-by="net" aria-pressed="true"><span data-tip={tip`<b>Net rating</b><br>Points scored minus points allowed per 100 possessions played together`}>Net</span></button></th>
            <th scope="col" class="num"><span data-tip={tip`<b>Range</b><br>A rough 95% range either side of the net rating, from the possession count alone`}>Range (±)</span></th>
          </tr>
        </thead>
        <tbody id="units-body" set:html={lineupRowsHtml(units, names, base)} />
      </table>
    </div>
  </div>
</section>

<script>
  import { lines, PAIR_SIZE, sortLines, UNIT_SIZE, type ClubUnits, type LineupSort } from "../../lib/lineups";
  import { lineupRowsHtml, type PlayerName } from "../../lib/lineups_html";

  interface Data {
    code: string;
    seasons: ClubUnits;
    names: Record<string, PlayerName>;
    base: string;
    initial: number;
  }

  const data: Data = JSON.parse(document.getElementById("lineups-data")?.textContent || "null");
  const sortBy: Record<string, LineupSort> = { duos: "net", units: "net" };
  let season = data.initial;
  const select = document.getElementById("season") as HTMLSelectElement | null;
  if (select) season = Number(select.value) || season;

  // Other seasons come from data/lineups/{code}/{season}.json when the team page switches season.
  async function load(s: number): Promise<void> {
    if (data.seasons[String(s)] !== undefined) return;
    const r = await fetch(`${data.base}/data/lineups/${data.code.toLowerCase()}/${s}.json`);
    if (!r.ok) {
      data.seasons[String(s)] = undefined as never;
      return;
    }
    const part = (await r.json()) as { seasons: ClubUnits; names: Record<string, PlayerName> };
    Object.assign(data.seasons, part.seasons);
    Object.assign(data.names, part.names);
  }

  document.addEventListener("season:change", (e) => {
    const s = Number((e as CustomEvent<string>).detail);
    load(s).then(() => {
      season = s;
      render();
    });
  });

  function render(): void {
    const current = data.seasons[String(season)];
    document.getElementById("duos-wrap")!.hidden = !current;
    document.getElementById("units-wrap")!.hidden = !current;
    document.getElementById("lineups-note")!.hidden = !!current;
    for (const table of ["duos", "units"]) {
      const rows = current
        ? lines(table === "duos" ? current.pairs : current.units, table === "duos" ? PAIR_SIZE : UNIT_SIZE)
        : [];
      document.getElementById(`${table}-body`)!.innerHTML = lineupRowsHtml(sortLines(rows, sortBy[table]), data.names, data.base);
      for (const button of document.querySelectorAll<HTMLButtonElement>(`button.sort[data-table="${table}"]`)) {
        button.setAttribute("aria-pressed", String(button.dataset.by === sortBy[table]));
      }
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>("button.sort")) {
    button.addEventListener("click", () => {
      sortBy[button.dataset.table!] = button.dataset.by as LineupSort;
      render();
    });
  }
  select?.addEventListener("change", () => {
    season = Number(select.value);
    render();
  });
  render();
</script>

<style>
  .lineups-title {
    margin: 1.25rem 0 0.5rem;
    font-size: inherit;
    font-weight: 600;
  }
  .sort {
    font: inherit;
    color: inherit;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline dotted;
  }
  .sort[aria-pressed="true"] {
    font-weight: 600;
  }
</style>
