---
// A metric's difference from the league average under the Delta Rule (lib/delta.ts).
import { deltaHtml, type BetterIs } from "../lib/delta";

interface Props {
  /** Subject minus league. */
  value: number;
  better?: BetterIs;
  digits?: number;
  unit?: string;
  versus?: string;
}
const { value, better = "higher", digits = 1, unit = "", versus = "the league" } = Astro.props;
---

<Fragment set:html={deltaHtml(value, { better, digits, unit, versus })} />
