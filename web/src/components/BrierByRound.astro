---
import type { Competition } from "../lib/format";
import { brierChart, groupLabel, score3, shortGroup, type ChartSpec } from "../lib/forecasts";
import { tip } from "../lib/tip";

interface Props {
  comp: Competition;
}
const { comp } = Astro.props;
const fc = comp.forecasts;
const model = fc ? (fc.published ?? fc.models[0]?.key) : undefined;
const label = fc?.models.find((m) => m.key === model)?.label ?? "Our forecast";
const acc = fc?.accuracy ?? [];

// One size for every chart in the scoring row (see index.astro): a card a third of the page wide.
const spec: ChartSpec = { w: 320, h: 240, l: 40, r: 48, t: 14, b: 36 };
const chart = acc.length ? brierChart(acc, spec) : null;
const c = chart;
---

{
  c && (
    <section class="chart-card" aria-labelledby={`fc-chart-${comp.key}`}>
      <div class="chart-head">
        <div class="cap-row">
          <h3 id={`fc-chart-${comp.key}`}>Brier score by round</h3>
          <span class="dir">Better ↓</span>
        </div>
        <div class="help" id={`fc-chart-${comp.key}-help`}>
          <p>How close our win chances were to the results, season to date after each round.</p>
          <p>
            Lower is better: 0 is perfect, 0.25 is a coin flip. A point at 0.20 after round 5 means our
            chances have been closer than a coin flip so far.
          </p>
        </div>
      </div>
      <div class="legend-row">
        <ul class="legend">
          <li>
            <span class="key model" aria-hidden="true" />
            {label}
          </li>
        </ul>
      </div>
      <div class="plot-area">
        <svg
          class="chart"
          viewBox={`0 0 ${c.spec.w} ${c.spec.h}`}
          role="img"
          aria-labelledby={`fc-chart-${comp.key} fc-chart-${comp.key}-help`}
        >
          <rect
            class="plot"
            x={c.spec.l}
            y={c.spec.t}
            width={c.spec.w - c.spec.l - c.spec.r}
            height={c.spec.h - c.spec.t - c.spec.b}
          />
          {c.ticks.map((t) => (
            <>
              <line class="grid" x1={c.spec.l} x2={c.spec.w - c.spec.r} y1={t.y} y2={t.y} />
              <text class="tick" x={c.spec.l - 8} y={t.y + 4} text-anchor="end">
                {t.label}
              </text>
            </>
          ))}
          {c.coin !== null && (
            <>
              <line class="ref" x1={c.spec.l} x2={c.spec.w - c.spec.r} y1={c.coin} y2={c.coin} />
              <text class="tick" x={c.spec.w - c.spec.r - 4} y={c.coin - 5} text-anchor="end">
                coin flip
              </text>
            </>
          )}
          {c.xs.map((x) => (
            <text class="tick" x={x.x} y={c.spec.h - c.spec.b + 20} text-anchor="middle">
              {x.label}
            </text>
          ))}
          {c.model.d && <path class="ln model" d={c.model.d} />}
          {c.model.pts.map((p) => (
            <circle class="dot model" cx={p.x} cy={p.y} r="4" />
          ))}
          {c.ends.map((e) => (
            <text class="end" x={c.spec.w - c.spec.r + 10} y={e.y + 4}>
              {e.text}
            </text>
          ))}
          {acc.map((a, i) => {
            const x = c.xs[i].x;
            const half = acc.length > 1 ? (c.spec.w - c.spec.l - c.spec.r) / (acc.length - 1) / 2 : 40;
            return (
              <rect
                class="hit"
                x={x - half}
                y={c.spec.t}
                width={half * 2}
                height={c.spec.h - c.spec.t - c.spec.b}
                tabindex="0"
                data-tip={tip`<b>${groupLabel(a.phase, a.round)}</b>, after ${a.to_date.games} games<br>${label}: ${score3(a.to_date.model.brier)}`}
                aria-label={`${groupLabel(a.phase, a.round)}, after ${a.to_date.games} games. ${label} ${score3(a.to_date.model.brier)}.`}
              />
            );
          })}
          <text class="axis-label" x={c.spec.l + (c.spec.w - c.spec.l - c.spec.r) / 2} y={c.spec.h - 4} text-anchor="middle">
            Rounds played · Brier score, season to date
          </text>
        </svg>
      </div>
      <table class="sr-only">
        <caption>{comp.title}: Brier score to date after each round</caption>
        <thead>
          <tr>
            <th scope="col">Round</th>
            <th scope="col">Games to date</th>
            <th scope="col">{label}</th>
          </tr>
        </thead>
        <tbody>
          {acc.map((a) => (
            <tr>
              <th scope="row">{groupLabel(a.phase, a.round)}</th>
              <td>{a.to_date.games}</td>
              <td>{score3(a.to_date.model.brier)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )
}

<style>
  .cap-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  /* Which way is better, in the chart's top-right corner: muted, never a data colour. */
  .dir {
    flex: none;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .help p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  /* Same height in every card, so the plots start on one line. */
  .legend-row {
    min-height: 24px;
    margin-bottom: 8px;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .axis-label {
    fill: var(--muted);
    font-size: 11px;
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .key {
    width: 18px;
    height: 0;
    border-top: 2px solid var(--data-1);
    border-radius: 1px;
  }
  .chart {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .plot {
    fill: var(--surface);
  }
  .grid {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .ref {
    stroke: var(--axis);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .tick {
    fill: var(--muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .end {
    fill: var(--ink);
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .ln {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ln.model {
    stroke: var(--data-1);
  }
  .dot {
    stroke: var(--page);
    stroke-width: 2;
  }
  .dot.model {
    fill: var(--data-1);
  }
  .hit {
    fill: transparent;
    outline: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .hit:hover {
      fill: var(--data-1-wash);
    }
  }
  .hit:focus-visible {
    fill: var(--data-1-wash);
  }
</style>
