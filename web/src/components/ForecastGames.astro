---
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import check from "@phosphor-icons/core/assets/bold/check-bold.svg?raw";
import cross from "@phosphor-icons/core/assets/bold/x-bold.svg?raw";
import { athensDay, pct, signed } from "../lib/format";
import { dash, groupKey, groupLabel, type FcGame } from "../lib/forecasts";

interface Props {
  title: string;
  games: FcGame[];
  /** Key of the model whose call each row shows. */
  model: string;
  /** Adds the round filter above the table. */
  filter?: boolean;
}
const { title, games, model, filter = false } = Astro.props;
const keyOf = (g: FcGame) => groupKey(g.phase, g.phase === "RS" ? g.round : null);
const groups = [...new Map(games.map((g) => [keyOf(g), g])).entries()].map(([value, g]) => ({
  value,
  text: groupLabel(g.phase, g.phase === "RS" ? g.round : null),
}));
---

<div class="fcg" data-fcg style="min-width:0">
  {
    filter && (
      <form class="filters" aria-label={`${title} filters`} onsubmit="return false">
        <label class="field">
          <span>Round</span>
          <span class="select">
            <select name="round" style="--select-w: 9.5rem">
              <option value="">All rounds</option>
              {groups.map((g) => <option value={g.value}>{g.text}</option>)}
            </select>
            <span class="caret" set:html={caret} />
          </span>
        </label>
        <p class="count" aria-live="polite">
          <b data-count>{games.length}</b> games shown
        </p>
      </form>
    )
  }
  <div class="scroll">
    <table class="games">
      <caption class="sr-only">{title}</caption>
      <thead>
        <tr>
          <th scope="col" class="w-round">Round</th>
          <th scope="col" class="w-date">Date</th>
          <th scope="col" class="r">Home</th>
          <th scope="col" class="c">Score</th>
          <th scope="col">Away</th>
          <th scope="col">
            Our model
            <span class="sub-h">home win chance, expected margin</span>
          </th>
        </tr>
      </thead>
      <tbody>
        {
          games.map((g) => {
            const homeWon = g.home_score > g.away_score;
            const c = g.models[model];
            return (
              <tr data-group={keyOf(g)}>
                <td class="date rd">{groupLabel(g.phase, g.phase === "RS" ? g.round : null).replace("Round ", "")}</td>
                <td class="date">{athensDay(g.tipoff_utc)}</td>
                <td class:list={["team r", { won: homeWon }]}>
                  <span class="name">{g.home.name}</span>
                  <b>{g.home.code}</b>
                </td>
                <td class="c score">
                  <span class:list={{ won: homeWon }}>{g.home_score}</span>
                  <span class="dash">-</span>
                  <span class:list={{ won: !homeWon }}>{g.away_score}</span>
                </td>
                <td class:list={["team", { won: !homeWon }]}>
                  <b>{g.away.code}</b>
                  <span class="name">{g.away.name}</span>
                </td>
                <td class="call">
                  {c ? (
                    <>
                      {pct(c.p_home)} <span class="mg">{signed(c.exp_margin)}</span>
                      {c.right === null ? (
                        <span class="dash">{dash}</span>
                      ) : (
                        <span class:list={["pill", c.right ? "hit" : "miss"]}>
                          <span class="icon" set:html={c.right ? check : cross} />
                          {c.right ? "Right" : "Wrong"}
                        </span>
                      )}
                    </>
                  ) : (
                    dash
                  )}
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
</div>

<style is:global>
  /* Global and nested under .fcg, so the rows the round picker prints by script are styled too. */
  .fcg {
  .scroll {
    overflow-x: auto;
  }
  table {
    width: auto;
    min-width: 640px;
    border-collapse: collapse;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  th {
    text-align: left;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    padding: 0 14px 10px 0;
    border-bottom: 1px solid var(--rule-strong);
    white-space: nowrap;
    vertical-align: bottom;
  }
  td {
    padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }
  .count {
    margin: 0;
    align-self: center;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .count b {
    color: var(--ink);
    font-weight: 600;
  }
  .filters {
    margin-bottom: 16px;
  }
  .sub-h {
    display: block;
    font-weight: 400;
    font-size: 0.6875rem;
  }
  .games .r {
    text-align: right;
  }
  .games .c {
    text-align: center;
  }
  .date {
    color: var(--muted);
  }
  .team {
    color: var(--ink-2);
    min-width: 11rem;
  }
  .team b {
    font-weight: 500;
  }
  .team.r b {
    margin-inline: 8px 0;
  }
  .team:not(.r) b {
    margin-inline: 0 8px;
  }
  .team .name {
    color: var(--muted);
  }
  .team.won,
  .team.won b {
    color: var(--ink);
    font-weight: 600;
  }
  .score {
    color: var(--muted);
  }
  .score .won {
    color: var(--ink);
    font-weight: 600;
  }
  .dash {
    margin-inline: 6px;
    color: var(--rule-strong);
  }
  .call {
    font-weight: 500;
  }
  .call span {
    color: var(--muted);
    font-weight: 400;
  }
  .call .pill {
    margin-left: 8px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 9px 2px 7px;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--ink) !important;
  }
  .pill .icon {
    display: inline-grid;
    font-size: 11px;
  }
  .hit {
    background: var(--data-1-wash);
  }
  .hit .icon {
    color: var(--data-1);
  }
  .miss {
    background: var(--data-neg-wash);
  }
  .miss .icon {
    color: var(--data-neg);
  }
  tr[hidden] {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .games tbody tr:hover {
      background: var(--sunk);
    }
  }
  @media (max-width: 560px) {
    table {
      min-width: 0;
    }
    .mg,
    .sub-h {
      display: none;
    }
    .w-round,
    td.rd {
      display: none;
    }
    td,
    th {
      padding-right: 8px;
    }
  }
  @media (max-width: 720px) {
    .team .name {
      display: none;
    }
    .team {
      min-width: 0;
    }
  }
  }
</style>

<script>
  // Filter a game list by round group. Without script every game shows.
  for (const root of document.querySelectorAll<HTMLElement>("[data-fcg]")) {
    const form = root.querySelector<HTMLFormElement>("form.filters");
    const table = root.querySelector<HTMLTableElement>("table.games");
    if (!form || !table) continue;
    const count = root.querySelector<HTMLElement>("[data-count]");
    form.addEventListener("change", () => {
      const group = (form.elements.namedItem("round") as HTMLSelectElement).value;
      let shown = 0;
      for (const row of table.tBodies[0].rows) {
        const ok = !group || row.dataset.group === group;
        row.hidden = !ok;
        if (ok) shown += 1;
      }
      if (count) count.textContent = String(shown);
    });
  }
</script>
