---
// The RAPM leaderboard: the latest EuroLeague season's players at the minimum minutes, by total.
// Points per 100 possessions against an average player; each figure with its 90% interval.
import { displayCode, seasonLabel, thousands, type RapmBoard } from "../lib/m6";
import { signed } from "../lib/format";
import { intervalHint, tip } from "../lib/tip";
import InfoTip from "./InfoTip.astro";

interface Props {
  board: RapmBoard;
  /** Source person id (P:...) -> player page slug, for the players the site has a page for. */
  slugs: Record<string, string>;
  base: string;
}
const { board, slugs, base } = Astro.props;
const rows = board.players
  .filter((p) => p.rank !== null)
  .sort((a, b) => (b.total - a.total) || a.name.localeCompare(b.name));
const range = (r: [number, number]) => `${signed(r[0])} to ${signed(r[1])}`;
const season = seasonLabel(board.season);
const cols = [
  ["o", "O-RAPM", `Offensive RAPM: points per 100 possessions his offense adds against an average player, with his 90% interval.`],
  ["d", "D-RAPM", `Defensive RAPM: points per 100 possessions his defense saves against an average player (positive is better), with his 90% interval.`],
  ["total", "Total", `Offensive plus defensive RAPM, with its 90% interval. Zero is average.`],
  ["minutes", "Minutes", `Box-score minutes in ${season}, the whole season.`],
] as const;
---

<figure class="standings-fig rapm-fig" data-figure>
  <figcaption class="cap">
    <h3>{season} RAPM, EuroLeague</h3>
    <p class="rapm-note">
      Players with at least {thousands(board.minimum_minutes)} minutes, ranked by total. Points per 100 possessions against an average player; intervals are 90%. Sorted by total until a header is picked. A short sample has a wide interval.
    </p>
  </figcaption>
  <div class="scroll">
    <table class="grid standings rapm" id="rapm">
      <caption class="sr-only">{season} RAPM, EuroLeague players with at least {thousands(board.minimum_minutes)} minutes</caption>
      <thead>
        <tr>
          <th scope="col" class="num">#</th>
          <th scope="col" aria-sort="none"><button type="button" data-sort="name">Player</button></th>
          <th scope="col" aria-sort="none"><button type="button" data-sort="team">Team</button></th>
          {cols.map(([k, head, about]) => (
            <th scope="col" class="num" aria-sort={k === "total" ? "descending" : "none"} class:list={{ on: k === "total" }}>
              {k === "minutes" || k === "total" || k === "o" || k === "d" ? (
                <button type="button" data-sort={k} data-tip={tip`<b>${head}</b><br>${about}`}>{head}</button>
              ) : (
                head
              )}
            </th>
          ))}
          <th scope="col" class="num">90% interval<InfoTip text={intervalHint(90)} /></th>
        </tr>
      </thead>
      <tbody>
        {rows.map((p, i) => (
          <tr data-name={p.name}>
            <td class="num rk">{i + 1}</td>
            <td>
              {slugs[p.person_id] ? <a href={`${base}/players/${slugs[p.person_id]}/`}>{p.name}</a> : p.name}
            </td>
            <td class="code">{displayCode("euroleague", p.team)}</td>
            <td class="num" data-k="o" data-v={p.o}>{signed(p.o)}</td>
            <td class="num" data-k="d" data-v={p.d}>{signed(p.d)}</td>
            <td class="num strong" data-k="total" data-v={p.total}>{signed(p.total)}</td>
            <td class="num" data-k="minutes" data-v={p.minutes}>{thousands(p.minutes)}</td>
            <td class="num">{range(p.ci90_total)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</figure>

<script>
  // Sort by a header button: names A to Z first, numbers high to low first; the rank column renumbers.
  document.querySelectorAll<HTMLTableElement>("table.rapm").forEach((table) => {
    const body = table.tBodies[0];
    table.tHead!.addEventListener("click", (e) => {
      const button = (e.target as Element).closest<HTMLButtonElement>("button[data-sort]");
      if (!button) return;
      const key = button.dataset.sort!;
      const th = button.parentElement as HTMLTableCellElement;
      const text = key === "name" || key === "team";
      const now = th.getAttribute("aria-sort");
      const next = now === "none" ? (text ? "ascending" : "descending") : now === "ascending" ? "descending" : "ascending";
      const sign = next === "ascending" ? 1 : -1;
      const value = (row: HTMLTableRowElement) =>
        key === "name"
          ? row.dataset.name!
          : key === "team"
            ? row.querySelector("td.code")!.textContent!
            : Number(row.querySelector<HTMLElement>(`[data-k="${key}"]`)!.dataset.v);
      const rows = [...body.rows].sort((a, b) => {
        const [x, y] = [value(a), value(b)];
        return sign * (typeof x === "string" ? x.localeCompare(y as string) : x - (y as number));
      });
      body.append(...rows);
      rows.forEach((row, i) => (row.querySelector(".rk")!.textContent = String(i + 1)));
      table.querySelectorAll("thead th").forEach((h) => {
        h.setAttribute("aria-sort", "none");
        h.classList.remove("on");
      });
      th.classList.add("on");
      th.setAttribute("aria-sort", next);
      button.focus();
    });
  });
</script>
