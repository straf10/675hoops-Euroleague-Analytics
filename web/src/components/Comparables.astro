---
// Shot twins: the five closest EuroLeague player-seasons to the player's own latest season, across
// the whole profile (box-score rates, shooting and shot zones), by cosine similarity. The headline
// comparison; its percentage is the similarity score.
import { COMPETITIONS, seasonLabel, type SimilarReport } from "../lib/m6";

interface Props {
  report: SimilarReport | null;
  name: string;
  /** EuroLeague person id ("P:P001") -> player page slug. */
  slugs: Record<string, string>;
  base: string;
}
const { report, name, slugs, base } = Astro.props;
const top = (report?.similar ?? []).slice(0, 5);
const query = top[0]?.query_season ?? report?.season;
---

{
  report && top.length > 0 && (
    <section class="wrap band" id="twin" aria-labelledby="twin-title">
      <header class="sec-head">
        <h2 id="twin-title">Shot twins</h2>
        <p>
          {`${name}'s ${seasonLabel(query!)} season is closest to these EuroLeague player-seasons`}, across the whole
          profile: box-score rates, shooting and shot zones. The percentage is the similarity, where 100% is an
          identical profile.
        </p>
      </header>
      <figure class="proj-fig" data-figure>
        <ol class="proj-like">
          {top.map((r) => (
            <li>
              <span class="rk">{r.rank}</span>
              <span class="nm">
                {slugs[r.person_id] ? <a href={`${base}/players/${slugs[r.person_id]}/`}>{r.name}</a> : r.name}
                <small>
                  {seasonLabel(r.season)}, {COMPETITIONS[r.competition] ?? r.competition}
                </small>
              </span>
              <span class="val">
                <b data-num>{Math.round(100 * r.score)}%</b>
                <small>similar</small>
              </span>
            </li>
          ))}
        </ol>
      </figure>
    </section>
  )
}
