---
import type { Competition } from "../lib/format";
import {
  dash,
  groupKey,
  groupLabel,
  rightText,
  score3,
  share,
  type FcGame,
  type Headline,
} from "../lib/forecasts";
import { tip } from "../lib/tip";
import ForecastGames from "./ForecastGames.astro";
import Tonight from "./Tonight.astro";

interface Props {
  comp: Competition;
}
const { comp } = Astro.props;
const fc = comp.forecasts;
// The page leads with one model, named only by `forecasts.published`.
const model = fc ? (fc.published ?? fc.models[0]?.key) : undefined;
const label = fc?.models.find((m) => m.key === model)?.label ?? "Our forecast";
const season = fc?.season.find((r) => r.model === model);
const ours: Headline | null = season
  ? {
      n: season.n,
      picks: season.picks,
      right: season.right,
      right_pct: season.right_pct,
      brier: season.brier,
      log_loss: season.log_loss,
    }
  : null;
const keyOf = (g: FcGame) => groupKey(g.phase, g.phase === "RS" ? g.round : null);
const called = fc && model ? fc.games.filter((g) => g.models[model]) : [];
const latestKey = called.length ? keyOf(called[0]) : null;
const latest = called.filter((g) => keyOf(g) === latestKey);
const latestName = called.length ? groupLabel(called[0].phase, called[0].phase === "RS" ? called[0].round : null) : "";

const rounds = fc && model ? [...fc.rounds].reverse().filter((g) => g.models[model]) : [];
// Every model with a scored round, the published one first: a side-by-side view, not a verdict.
const roundModels = fc && model
  ? [model, ...fc.models.map((m) => m.key).filter((k) => k !== model && rounds.some((g) => g.models[k]))]
  : [];


const others = fc && fc.shared.rows.length > 1 ? fc.shared : null;
const labelOf = (key: string) => fc?.models.find((m) => m.key === key)?.label ?? key;
const hasContent = !!(fc && model && season && season.n > 0 && ours);
---

<div class="fc" data-fc={comp.key}>
  {
    !hasContent || !ours || !model ? (
      <p class="none">No {comp.title} game has finished yet.</p>
    ) : (
      <>
        <section class="lead" aria-labelledby={`fc-lead-${comp.key}`}>
          <h3 id={`fc-lead-${comp.key}`} class="sr-only">
            Season so far
          </h3>
          <div class="stat">
            <p class="who">{label}</p>
            <p class="big">{share(ours.right_pct)}</p>
            <p class="what">
              Picked the winner in <b>{rightText(ours)}</b> games
            </p>
          </div>
        </section>

        <Tonight comp={comp} />

        {latest.length > 0 && (
          <section aria-labelledby={`fc-latest-${comp.key}`}>
            <h3 id={`fc-latest-${comp.key}`}>Latest round</h3>
            <p class="sub">{latestName}: each forecast beside the result.</p>
            <ForecastGames title={`${comp.title}: ${latestName}`} games={latest} model={model} />
          </section>
        )}

        <section aria-labelledby={`fc-season-${comp.key}`}>
          <h3 id={`fc-season-${comp.key}`}>Season scores</h3>
          <p class="sub">
            {`On all ${ours.n} finished games.`}
          </p>
          <div class="scroll">
            <table class="plain">
              <caption class="sr-only">
                {comp.title}: season scores
              </caption>
              <thead>
                <tr>
                  <th scope="col" />
                  <th scope="col" class="n">
                    Games
                  </th>
                  <th scope="col" class="n">
                    Picked the winner
                  </th>
                  <th
                    scope="col"
                    class="n"
                    tabindex="0"
                    data-tip={tip`<b>Brier score</b><br>The squared gap between the home-win chance and what happened, averaged. Lower is better.`}
                  >
                    Brier score
                  </th>
                  <th
                    scope="col"
                    class="n"
                    tabindex="0"
                    data-tip={tip`<b>Log loss</b><br>Like the Brier score, but it punishes a confident wrong call hardest. Lower is better.`}
                  >
                    Log loss
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">{label}</th>
                  <td class="n">{ours.n}</td>
                  <td class="n">
                    {rightText(ours)} ({share(ours.right_pct)})
                  </td>
                  <td class="n">{score3(ours.brier)}</td>
                  <td class="n">{score3(ours.log_loss)}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        {others && (
          <section aria-labelledby={`fc-others-${comp.key}`}>
            <h3 id={`fc-others-${comp.key}`}>Other models</h3>
            <p class="sub">Scored on the {others.n} games all of them called.</p>
            <div class="scroll">
              <table class="plain">
                <caption class="sr-only">
                  {comp.title}: models on the games they share
                </caption>
                <thead>
                  <tr>
                    <th scope="col" />
                    <th scope="col" class="n">
                      Games
                    </th>
                    <th scope="col" class="n">
                      Picked the winner
                    </th>
                    <th scope="col" class="n">
                      Brier score
                    </th>
                    <th scope="col" class="n">
                      Log loss
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {others.rows.map((r) => (
                    <tr>
                      <th scope="row">{labelOf(r.model)}</th>
                      <td class="n">{r.n}</td>
                      <td class="n">
                        {rightText(r)} ({share(r.right_pct)})
                      </td>
                      <td class="n">{score3(r.brier)}</td>
                      <td class="n">{score3(r.log_loss)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <section aria-labelledby={`fc-rounds-${comp.key}`}>
          <h3 id={`fc-rounds-${comp.key}`}>Round by round</h3>
          <p class="sub">
            Newest first. Each cell is the winners picked, then the Brier score (lower is better). Every model
            is counted on the games it called.
          </p>
          <div class="scroll">
            <table class="plain">
              <caption class="sr-only">
                {comp.title}: forecast record per round
              </caption>
              <thead>
                <tr>
                  <th scope="col">Round</th>
                  <th scope="col" class="n">
                    Games
                  </th>
                  {roundModels.map((k) => (
                    <th scope="col" class="n">
                      {k === model ? label : labelOf(k)}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rounds.map((g) => {
                  return (
                    <tr>
                      <th scope="row">{groupLabel(g.phase, g.round)}</th>
                      <td class="n">{g.models[model].n}</td>
                      {roundModels.map((k) => {
                        const r = g.models[k];
                        return (
                          <td class="n">
                            {r ? (
                              <>
                                {rightText(r)}
                                <span class="bri">{score3(r.brier)}</span>
                              </>
                            ) : (
                              dash
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          {roundModels.length > 1 && (
            <p class="note">
              A round is eight to ten games, so one result moves these numbers a lot. This view is for
              watching trends; the models are compared formally, as declared before the season, after
              round 19.
            </p>
          )}
        </section>

        <details class="log" id="every-game">
          <summary>Every game in the log ({called.length})</summary>
          <p class="sub">Each forecast beside the result, newest first.</p>
          <ForecastGames title={`${comp.title}: every game with its forecast`} games={called} model={model} filter />
        </details>
        <p class="rawlink">
          <a href="#every-game" data-open-log>
            Read the log
          </a>
        </p>
      </>
    )
  }
</div>

<style>
  .fc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 44px;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 6px;
  }
  .mid {
    font-size: 2.5rem;
    font-weight: 620;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .fc h3 {
    font-size: 1.0625rem;
  }
  .lead {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 24px 48px;
  }
  .stat {
    border-top: 1px solid var(--rule-strong);
    padding-top: 14px;
  }
  .who {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .big {
    margin-top: 6px;
    font-size: 3.25rem;
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .what {
    margin-top: 8px;
    color: var(--ink-2);
  }
  .what b {
    color: var(--ink);
    font-weight: 600;
  }
  .aside {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .sub {
    margin: 4px 0 14px;
    color: var(--ink-2);
    font-size: 0.875rem;
    max-width: 68ch;
  }
  .note,
  .none {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 70ch;
  }
  .scroll {
    overflow-x: auto;
  }
  .bri {
    display: block;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  table.plain {
    width: auto;
    min-width: 28rem;
    border-collapse: collapse;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  table.plain th {
    text-align: left;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    padding: 0 18px 10px 0;
    border-bottom: 1px solid var(--rule-strong);
    vertical-align: bottom;
  }
  table.plain tbody th {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    vertical-align: middle;
  }
  table.plain td,
  table.plain tbody th {
    padding: 10px 18px 10px 0;
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }
  table.plain .n {
    text-align: right;
  }
  table.plain th[data-tip] {
    cursor: help;
  }

  @media (max-width: 560px) {
    .big {
      font-size: 2.75rem;
    }
    .mid {
      font-size: 2rem;
    }
  }

  /* The raw log */
  .log > summary {
    cursor: pointer;
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
  }
  .log[open] > summary {
    margin-bottom: 8px;
  }
  .rawlink {
    margin-top: -24px;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .rawlink a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 3px;
  }
</style>

<script>
  // The log sits closed; its link, and a #every-game address, open it.
  const log = document.getElementById("every-game") as HTMLDetailsElement | null;
  const openLog = () => {
    if (log && location.hash === "#every-game") log.open = true;
  };
  openLog();
  addEventListener("hashchange", openLog);
  document.querySelector("[data-open-log]")?.addEventListener("click", () => {
    if (log) log.open = true;
  });
</script>
