---
import type { Competition } from "../lib/format";
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import {
  dash,
  groupLabel,
  headlineText,
  rightText,
  score3,
  share,
  type Headline,
} from "../lib/forecasts";
import { leadModel, roundGroups } from "../lib/forecast_rounds";
import { tip } from "../lib/tip";
import Calibration from "./Calibration.astro";
import ForecastGames from "./ForecastGames.astro";
import Tonight from "./Tonight.astro";

interface Props {
  comp: Competition;
}
const { comp } = Astro.props;
const fc = comp.forecasts;
// The page leads with one model, named only by `forecasts.published`.
const model = leadModel(fc);
const label = fc?.models.find((m) => m.key === model)?.label ?? "Our model";
const season = fc?.season.find((r) => r.model === model);
const ours: Headline | null = season
  ? {
      n: season.n,
      picks: season.picks,
      right: season.right,
      right_pct: season.right_pct,
      brier: season.brier,
      log_loss: season.log_loss,
    }
  : null;
const called = fc && model ? fc.games.filter((g) => g.models[model]) : [];
// Every round the model called, the latest first; the page prints the first one and the picker fetches the rest.
const groups = fc && model ? roundGroups(fc.games, model) : [];
const current = groups[0] ?? null;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const rounds = fc && model ? [...fc.rounds].reverse().filter((g) => g.models[model]) : [];
// Every model with a scored round, the published one first: a side-by-side view, not a verdict.
const roundModels = fc && model
  ? [model, ...fc.models.map((m) => m.key).filter((k) => k !== model && rounds.some((g) => g.models[k]))]
  : [];


const others = fc && fc.shared.rows.length > 1 ? fc.shared : null;
const labelOf = (key: string) => fc?.models.find((m) => m.key === key)?.label ?? key;
const hasContent = !!(fc && model && season && season.n > 0 && ours);
---

<div class="fc" data-fc={comp.key}>
  {
    !hasContent || !ours || !model ? (
      <p class="none">No {comp.title} game has finished yet.</p>
    ) : (
      <>
        <section class="lead" aria-labelledby={`fc-lead-${comp.key}`}>
          <h3 id={`fc-lead-${comp.key}`} class="sr-only">
            Season so far
          </h3>
          <div class="stat">
            <p class="who">{label}</p>
            <p class="big">{share(ours.right_pct)}</p>
            <p class="what">
              Picked the winner in <b>{rightText(ours)}</b> games
            </p>
          </div>
        </section>

        <Tonight comp={comp} />

        {fc?.headline && (
          <p class="headline">{headlineText(fc.headline, groupLabel(fc.headline.phase, fc.headline.round))}</p>
        )}

        {current && (
          <section
            aria-labelledby={`fc-round-${comp.key}`}
            data-round-comp={comp.key}
            data-round-title={comp.title}
            data-round-base={base}
            data-round-model={model}
            data-round-default={current.id}
          >
            <h3 id={`fc-round-${comp.key}`}>{current.label}</h3>
            <form class="filters" aria-label={`${comp.title}: round`} onsubmit="return false">
              <label class="field">
                <span>Round</span>
                <span class="select">
                  <select name="round" style="--select-w: 9.5rem">
                    {groups.map((g) => (
                      <option value={g.id} selected={g.id === current.id}>
                        {g.label}
                      </option>
                    ))}
                  </select>
                  <span class="caret" set:html={caret} />
                </span>
              </label>
            </form>
            <p class="sub">Each forecast beside the result.</p>
            <p class="note" data-round-status hidden></p>
            <ForecastGames title={`${comp.title}: ${current.label}`} games={current.games} model={model} />
          </section>
        )}

        <section aria-labelledby={`fc-season-${comp.key}`}>
          <h3 id={`fc-season-${comp.key}`}>Season scores</h3>
          <p class="sub">
            {`On all ${ours.n} finished games.`}
          </p>
          <div class="scroll">
            <table class="plain">
              <caption class="sr-only">
                {comp.title}: season scores
              </caption>
              <thead>
                <tr>
                  <th scope="col" />
                  <th scope="col" class="n">
                    Games
                  </th>
                  <th scope="col" class="n">
                    Picked the winner
                  </th>
                  <th
                    scope="col"
                    class="n"
                    tabindex="0"
                    data-tip={tip`<b>Brier score</b><br>The squared gap between the home-win chance and what happened, averaged. Lower is better.`}
                  >
                    Brier score
                  </th>
                  <th
                    scope="col"
                    class="n"
                    tabindex="0"
                    data-tip={tip`<b>Log loss</b><br>Like the Brier score, but it punishes a confident wrong call hardest. Lower is better.`}
                  >
                    Log loss
                  </th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row">{label}</th>
                  <td class="n">{ours.n}</td>
                  <td class="n">
                    {rightText(ours)} ({share(ours.right_pct)})
                  </td>
                  <td class="n">{score3(ours.brier)}</td>
                  <td class="n">{score3(ours.log_loss)}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <Calibration comp={comp} />

        {others && (
          <section aria-labelledby={`fc-others-${comp.key}`}>
            <h3 id={`fc-others-${comp.key}`}>Other models</h3>
            <p class="sub">Scored on the {others.n} games all of them called.</p>
            <div class="scroll">
              <table class="plain">
                <caption class="sr-only">
                  {comp.title}: models on the games they share
                </caption>
                <thead>
                  <tr>
                    <th scope="col" />
                    <th scope="col" class="n">
                      Games
                    </th>
                    <th scope="col" class="n">
                      Picked the winner
                    </th>
                    <th scope="col" class="n">
                      Brier score
                    </th>
                    <th scope="col" class="n">
                      Log loss
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {others.rows.map((r) => (
                    <tr>
                      <th scope="row">{labelOf(r.model)}</th>
                      <td class="n">{r.n}</td>
                      <td class="n">
                        {rightText(r)} ({share(r.right_pct)})
                      </td>
                      <td class="n">{score3(r.brier)}</td>
                      <td class="n">{score3(r.log_loss)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <section aria-labelledby={`fc-rounds-${comp.key}`}>
          <h3 id={`fc-rounds-${comp.key}`}>Round by round</h3>
          <p class="sub">
            Newest first. Each cell is the winners picked, then the Brier score (lower is better). Every model
            is counted on the games it called.
          </p>
          <div class="scroll">
            <table class="plain">
              <caption class="sr-only">
                {comp.title}: forecast record per round
              </caption>
              <thead>
                <tr>
                  <th scope="col">Round</th>
                  <th scope="col" class="n">
                    Games
                  </th>
                  {roundModels.map((k) => (
                    <th scope="col" class="n">
                      {k === model ? label : labelOf(k)}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rounds.map((g) => {
                  return (
                    <tr>
                      <th scope="row">{groupLabel(g.phase, g.round)}</th>
                      <td class="n">{g.models[model].n}</td>
                      {roundModels.map((k) => {
                        const r = g.models[k];
                        return (
                          <td class="n">
                            {r ? (
                              <>
                                {rightText(r)}
                                <span class="bri">{score3(r.brier)}</span>
                              </>
                            ) : (
                              dash
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          {roundModels.length > 1 && (
            <p class="note">
              A round is eight to ten games, so one result moves these numbers a lot. This view is for
              watching trends; the models are compared formally, as declared before the season, after
              round 19.
            </p>
          )}
        </section>

        <details class="log" id="every-game">
          <summary>Every game in the log ({called.length})</summary>
          <p class="sub">Each forecast beside the result, newest first.</p>
          <ForecastGames title={`${comp.title}: every game with its forecast`} games={called} model={model} filter />
        </details>
        <p class="rawlink">
          <a href="#every-game" data-open-log>
            Read the log
          </a>
        </p>
      </>
    )
  }
</div>

<style>
  .fc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 44px;
  }
  .headline {
    margin: 0;
    color: var(--ink);
    font-size: 1rem;
    line-height: 1.5;
    max-width: 72ch;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 6px;
  }
  .mid {
    font-size: 2.5rem;
    font-weight: 620;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .fc h3 {
    font-size: 1.0625rem;
  }
  .lead {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 24px 48px;
  }
  .stat {
    border-top: 1px solid var(--rule-strong);
    padding-top: 14px;
  }
  .who {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .big {
    margin-top: 6px;
    font-size: 3.25rem;
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .what {
    margin-top: 8px;
    color: var(--ink-2);
  }
  .what b {
    color: var(--ink);
    font-weight: 600;
  }
  .aside {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .sub {
    margin: 4px 0 14px;
    color: var(--ink-2);
    font-size: 0.875rem;
    max-width: 68ch;
  }
  .note,
  .none {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 70ch;
  }
  .scroll {
    overflow-x: auto;
  }
  .bri {
    display: block;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  table.plain {
    width: auto;
    min-width: 28rem;
    border-collapse: collapse;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  table.plain th {
    text-align: left;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    padding: 0 18px 10px 0;
    border-bottom: 1px solid var(--rule-strong);
    vertical-align: bottom;
  }
  table.plain tbody th {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    vertical-align: middle;
  }
  table.plain td,
  table.plain tbody th {
    padding: 10px 18px 10px 0;
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }
  table.plain .n {
    text-align: right;
  }
  table.plain th[data-tip] {
    cursor: help;
  }

  @media (max-width: 560px) {
    .big {
      font-size: 2.75rem;
    }
    .mid {
      font-size: 2rem;
    }
  }

  /* The raw log */
  .log > summary {
    cursor: pointer;
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
  }
  .log[open] > summary {
    margin-bottom: 8px;
  }
  .rawlink {
    margin-top: -24px;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .rawlink a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 3px;
  }
</style>

<script>
  import check from "@phosphor-icons/core/assets/bold/check-bold.svg?raw";
  import cross from "@phosphor-icons/core/assets/bold/x-bold.svg?raw";
  import type { FcGame } from "../lib/forecasts";
  import { gameRowHtml, roundFromQuery, roundParam, roundSearch } from "../lib/forecast_rounds";

  // The round picker. The page prints the default round; any other round's games come from its per-round
  // file and replace the table's rows. The chosen round is kept in the URL, one parameter per competition.
  for (const sec of document.querySelectorAll<HTMLElement>("section[data-round-comp]")) {
    const compKey = sec.dataset.roundComp ?? "";
    const title = sec.dataset.roundTitle ?? "";
    const base = sec.dataset.roundBase ?? "";
    const model = sec.dataset.roundModel ?? "";
    const defaultId = sec.dataset.roundDefault ?? "";
    const select = sec.querySelector<HTMLSelectElement>("select[name=round]");
    const heading = sec.querySelector<HTMLElement>("h3");
    const table = sec.querySelector<HTMLTableElement>("table.games");
    const status = sec.querySelector<HTMLElement>("[data-round-status]");
    const body = table?.tBodies[0];
    if (!select || !heading || !table || !body) continue;
    const param = roundParam(compKey);
    const options = [...select.options].map((o) => ({ id: o.value, label: (o.textContent ?? "").trim() }));
    const icons = { hit: check, miss: cross };
    const cache = new Map<string, FcGame[]>();
    let wanted = "";

    const paint = (id: string, games: FcGame[]) => {
      if (id !== wanted) return;
      body.innerHTML = games.map((g) => gameRowHtml(g, model, icons)).join("");
      if (status) status.hidden = true;
      table.removeAttribute("aria-busy");
    };

    const show = (id: string) => {
      const label = options.find((o) => o.id === id)?.label ?? id;
      wanted = id;
      select.value = id;
      heading.textContent = label;
      const caption = table.querySelector("caption");
      if (caption) caption.textContent = `${title}: ${label}`;
      history.replaceState(null, "", location.pathname + roundSearch(location.search, param, id, defaultId) + location.hash);
      const held = cache.get(id);
      if (held) return paint(id, held);
      table.setAttribute("aria-busy", "true");
      fetch(`${base}/data/forecasts/${compKey}/${id}.json`)
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.json() as Promise<{ games: FcGame[] }>;
        })
        .then(({ games }) => {
          cache.set(id, games);
          paint(id, games);
        })
        .catch(() => {
          if (wanted !== id) return;
          table.removeAttribute("aria-busy");
          if (status) {
            status.textContent = `${label} could not be loaded. Reload the page to try again.`;
            status.hidden = false;
          }
        });
    };

    select.addEventListener("change", () => show(select.value));
    // A valid round in the URL is shown; a missing or unknown one leaves the latest round, with the URL tidied.
    const asked = roundFromQuery(location.search, param, options);
    if (asked && asked.id !== defaultId) show(asked.id);
    else history.replaceState(null, "", location.pathname + roundSearch(location.search, param, defaultId, defaultId) + location.hash);
  }

  // The log sits closed; its link, and a #every-game address, open it.
  const log = document.getElementById("every-game") as HTMLDetailsElement | null;
  const openLog = () => {
    if (log && location.hash === "#every-game") log.open = true;
  };
  openLog();
  addEventListener("hashchange", openLog);
  document.querySelector("[data-open-log]")?.addEventListener("click", () => {
    if (log) log.open = true;
  });
</script>
