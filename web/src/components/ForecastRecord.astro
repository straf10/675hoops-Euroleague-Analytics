---
import type { Competition } from "../lib/format";
import {
  brierChart,
  dash,
  groupKey,
  groupLabel,
  rightText,
  score3,
  share,
  type ChartSpec,
  type FcGame,
  type Headline,
} from "../lib/forecasts";
import { tip } from "../lib/tip";
import ForecastGames from "./ForecastGames.astro";
import Tonight from "./Tonight.astro";

interface Props {
  comp: Competition;
}
const { comp } = Astro.props;
const fc = comp.forecasts;
// The page leads with one model, named only by `forecasts.published`.
const model = fc ? (fc.published ?? fc.models[0]?.key) : undefined;
const label = fc?.models.find((m) => m.key === model)?.label ?? "Our forecast";
const season = fc?.season.find((r) => r.model === model);
const market = fc?.market ?? null;
const marketName = market?.label ?? "Bookmakers";
const acc = fc?.accuracy ?? [];
const both = acc.at(-1)?.to_date ?? null;
const ours: Headline | null = season
  ? {
      n: season.n,
      picks: season.picks,
      right: season.right,
      right_pct: season.right_pct,
      brier: season.brier,
      log_loss: season.log_loss,
    }
  : null;
const sameGames = both !== null && ours !== null && both.model.n !== ours.n;

const keyOf = (g: FcGame) => groupKey(g.phase, g.phase === "RS" ? g.round : null);
const called = fc && model ? fc.games.filter((g) => g.models[model]) : [];
const latestKey = called.length ? keyOf(called[0]) : null;
const latest = called.filter((g) => keyOf(g) === latestKey);
const latestName = called.length ? groupLabel(called[0].phase, called[0].phase === "RS" ? called[0].round : null) : "";

const rounds = fc && model ? [...fc.rounds].reverse().filter((g) => g.models[model]) : [];
const lineOf = (phase: string, round: number | null) => acc.find((a) => a.phase === phase && a.round === round);

const wide: ChartSpec = { w: 720, h: 280, l: 46, r: 64, t: 16, b: 34 };
const narrow: ChartSpec = { w: 340, h: 250, l: 40, r: 52, t: 16, b: 34 };
const charts = acc.length ? [brierChart(acc, wide), brierChart(acc, narrow)] : [];

const others = fc && fc.shared.rows.length > 1 ? fc.shared : null;
const labelOf = (key: string) => fc?.models.find((m) => m.key === key)?.label ?? key;
const hasContent = !!(fc && model && season && season.n > 0 && ours);
---

<div class="fc" data-fc={comp.key}>
  {
    !hasContent || !ours || !model ? (
      <p class="none">No {comp.title} game has finished yet.</p>
    ) : (
      <>
        <section class="lead" aria-labelledby={`fc-lead-${comp.key}`}>
          <h3 id={`fc-lead-${comp.key}`} class="sr-only">
            Season so far
          </h3>
          <div class="stat">
            <p class="who">{label}</p>
            <p class="big">{share(ours.right_pct)}</p>
            <p class="what">
              Picked the winner in <b>{rightText(ours)}</b> games
            </p>
          </div>
          {market && both && (
            <div class="stat">
              <p class="who">Against the bookmakers</p>
              <div class="pair">
                <div>
                  <p class="mid">{share(both.model.right_pct)}</p>
                  <p class="what">
                    {label}: <b>{rightText(both.model)}</b>
                  </p>
                </div>
                <div>
                  <p class="mid">{share(both.market.right_pct)}</p>
                  <p class="what">
                    {marketName}: <b>{rightText(both.market)}</b>
                  </p>
                </div>
              </div>
              <p class="aside">
                Picked the winner, on the {both.games} games with a bookmakers' line.
              </p>
            </div>
          )}
        </section>

        <Tonight comp={comp} />

        {latest.length > 0 && (
          <section aria-labelledby={`fc-latest-${comp.key}`}>
            <h3 id={`fc-latest-${comp.key}`}>Latest round</h3>
            <p class="sub">{latestName}: each forecast beside the result.</p>
            <ForecastGames title={`${comp.title}: ${latestName}`} games={latest} model={model} />
          </section>
        )}

        {charts.length > 0 && (
          <section aria-labelledby={`fc-chart-${comp.key}`}>
            <h3 id={`fc-chart-${comp.key}`}>Brier score by round</h3>
            <p class="sub">
              Season to date, after each round. Lower is better: 0 is a perfect forecast, 0.25 is a coin flip.
            </p>
            <ul class="legend">
              <li>
                <span class="key model" aria-hidden="true" />
                {label}
              </li>
              <li>
                <span class="key market" aria-hidden="true" />
                {marketName}
              </li>
            </ul>
            {charts.map((c, k) => (
              <svg
                class:list={["chart", k === 0 ? "wide" : "narrow"]}
                viewBox={`0 0 ${c.spec.w} ${c.spec.h}`}
                role="img"
                aria-label={`Brier score by round, ${label} against ${marketName}. The table below has the figures.`}
              >
                <rect
                  class="plot"
                  x={c.spec.l}
                  y={c.spec.t}
                  width={c.spec.w - c.spec.l - c.spec.r}
                  height={c.spec.h - c.spec.t - c.spec.b}
                />
                {c.ticks.map((t) => (
                  <>
                    <line class="grid" x1={c.spec.l} x2={c.spec.w - c.spec.r} y1={t.y} y2={t.y} />
                    <text class="tick" x={c.spec.l - 8} y={t.y + 4} text-anchor="end">
                      {t.label}
                    </text>
                  </>
                ))}
                {c.coin !== null && (
                  <>
                    <line class="ref" x1={c.spec.l} x2={c.spec.w - c.spec.r} y1={c.coin} y2={c.coin} />
                    <text class="tick" x={c.spec.w - c.spec.r - 4} y={c.coin - 5} text-anchor="end">
                      coin flip
                    </text>
                  </>
                )}
                {c.xs.map((x) => (
                  <text class="tick" x={x.x} y={c.spec.h - c.spec.b + 20} text-anchor="middle">
                    {x.label}
                  </text>
                ))}
                {c.market.d && <path class="ln market" d={c.market.d} />}
                {c.model.d && <path class="ln model" d={c.model.d} />}
                {c.market.pts.map((p) => (
                  <circle class="dot market" cx={p.x} cy={p.y} r="4" />
                ))}
                {c.model.pts.map((p) => (
                  <circle class="dot model" cx={p.x} cy={p.y} r="4" />
                ))}
                {c.ends.map((e) => (
                  <text class="end" x={c.spec.w - c.spec.r + 10} y={e.y + 4}>
                    {e.text}
                  </text>
                ))}
                {acc.map((a, i) => {
                  const x = c.xs[i].x;
                  const half = acc.length > 1 ? (c.spec.w - c.spec.l - c.spec.r) / (acc.length - 1) / 2 : 40;
                  return (
                    <rect
                      class="hit"
                      x={x - half}
                      y={c.spec.t}
                      width={half * 2}
                      height={c.spec.h - c.spec.t - c.spec.b}
                      tabindex="0"
                      data-tip={tip`<b>${groupLabel(a.phase, a.round)}</b>, after ${a.to_date.games} games<br>${label}: ${score3(a.to_date.model.brier)}<br>${marketName}: ${score3(a.to_date.market.brier)}`}
                      aria-label={`${groupLabel(a.phase, a.round)}, after ${a.to_date.games} games. ${label} ${score3(a.to_date.model.brier)}, ${marketName} ${score3(a.to_date.market.brier)}.`}
                    />
                  );
                })}
              </svg>
            ))}
            <p class="note">
              Scored on the games where both had a call. A few rounds is a small sample, so early lines move a lot.
            </p>
            <table class="sr-only">
              <caption>
                {comp.title}: Brier score to date after each round
              </caption>
              <thead>
                <tr>
                  <th scope="col">Round</th>
                  <th scope="col">Games to date</th>
                  <th scope="col">{label}</th>
                  <th scope="col">{marketName}</th>
                </tr>
              </thead>
              <tbody>
                {acc.map((a) => (
                  <tr>
                    <th scope="row">{groupLabel(a.phase, a.round)}</th>
                    <td>{a.to_date.games}</td>
                    <td>{score3(a.to_date.model.brier)}</td>
                    <td>{score3(a.to_date.market.brier)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </section>
        )}

        <section aria-labelledby={`fc-season-${comp.key}`}>
          <h3 id={`fc-season-${comp.key}`}>Season scores</h3>
          <p class="sub">
            {both ? `On the ${both.games} games with a bookmaker line.` : `On all ${ours.n} finished games.`}
          </p>
          <div class="scroll">
            <table class="plain">
              <caption class="sr-only">
                {comp.title}: season scores
              </caption>
              <thead>
                <tr>
                  <th scope="col" />
                  <th scope="col" class="n">
                    Games
                  </th>
                  <th scope="col" class="n">
                    Picked the winner
                  </th>
                  <th
                    scope="col"
                    class="n"
                    tabindex="0"
                    data-tip={tip`<b>Brier score</b><br>The squared gap between the home-win chance and what happened, averaged. Lower is better.`}
                  >
                    Brier score
                  </th>
                  <th
                    scope="col"
                    class="n"
                    tabindex="0"
                    data-tip={tip`<b>Log loss</b><br>Like the Brier score, but it punishes a confident wrong call hardest. Lower is better.`}
                  >
                    Log loss
                  </th>
                </tr>
              </thead>
              <tbody>
                {both && (
                  <>
                    <tr>
                      <th scope="row">{label}</th>
                      <td class="n">{both.model.n}</td>
                      <td class="n">
                        {rightText(both.model)} ({share(both.model.right_pct)})
                      </td>
                      <td class="n">{score3(both.model.brier)}</td>
                      <td class="n">{score3(both.model.log_loss)}</td>
                    </tr>
                    <tr>
                      <th scope="row">{marketName}</th>
                      <td class="n">{both.market.n}</td>
                      <td class="n">
                        {rightText(both.market)} ({share(both.market.right_pct)})
                      </td>
                      <td class="n">{score3(both.market.brier)}</td>
                      <td class="n">{score3(both.market.log_loss)}</td>
                    </tr>
                  </>
                )}
                {(!both || sameGames) && (
                  <tr>
                    <th scope="row">
                      {label}
                      {both ? ", every game" : ""}
                    </th>
                    <td class="n">{ours.n}</td>
                    <td class="n">
                      {rightText(ours)} ({share(ours.right_pct)})
                    </td>
                    <td class="n">{score3(ours.brier)}</td>
                    <td class="n">{score3(ours.log_loss)}</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
          {!market && <p class="note">No bookmaker line is recorded for these games yet.</p>}
        </section>

        {others && (
          <section aria-labelledby={`fc-others-${comp.key}`}>
            <h3 id={`fc-others-${comp.key}`}>Other models</h3>
            <p class="sub">Scored on the {others.n} games all of them called.</p>
            <div class="scroll">
              <table class="plain">
                <caption class="sr-only">
                  {comp.title}: models on the games they share
                </caption>
                <thead>
                  <tr>
                    <th scope="col" />
                    <th scope="col" class="n">
                      Games
                    </th>
                    <th scope="col" class="n">
                      Picked the winner
                    </th>
                    <th scope="col" class="n">
                      Brier score
                    </th>
                    <th scope="col" class="n">
                      Log loss
                    </th>
                  </tr>
                </thead>
                <tbody>
                  {others.rows.map((r) => (
                    <tr>
                      <th scope="row">{labelOf(r.model)}</th>
                      <td class="n">{r.n}</td>
                      <td class="n">
                        {rightText(r)} ({share(r.right_pct)})
                      </td>
                      <td class="n">{score3(r.brier)}</td>
                      <td class="n">{score3(r.log_loss)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <section aria-labelledby={`fc-rounds-${comp.key}`}>
          <h3 id={`fc-rounds-${comp.key}`}>Round by round</h3>
          <p class="sub">Newest first. {marketName} are counted on the games with a recorded line.</p>
          <div class="scroll">
            <table class="plain">
              <caption class="sr-only">
                {comp.title}: forecast record per round
              </caption>
              <thead>
                <tr>
                  <th scope="col">Round</th>
                  <th scope="col" class="n">
                    Games
                  </th>
                  <th scope="col" class="n">
                    {label} picked the winner
                  </th>
                  {market && (
                    <th scope="col" class="n">
                      {marketName} picked the winner
                    </th>
                  )}
                </tr>
              </thead>
              <tbody>
                {rounds.map((g) => {
                  const m = lineOf(g.phase, g.round)?.market;
                  return (
                    <tr>
                      <th scope="row">{groupLabel(g.phase, g.round)}</th>
                      <td class="n">{g.models[model].n}</td>
                      <td class="n">
                        {rightText(g.models[model])} ({share(g.models[model].right_pct)})
                      </td>
                      {market && <td class="n">{m ? `${rightText(m)} (${share(m.right_pct)})` : dash}</td>}
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>

        <details class="log" id="every-game">
          <summary>Every game in the log ({called.length})</summary>
          <p class="sub">Each forecast beside the result, newest first.</p>
          <ForecastGames title={`${comp.title}: every game with its forecast`} games={called} model={model} filter />
        </details>
        <p class="rawlink">
          <a href="#every-game" data-open-log>
            Read the log
          </a>
        </p>
      </>
    )
  }
</div>

<style>
  .fc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 44px;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 6px;
  }
  .mid {
    font-size: 2.5rem;
    font-weight: 620;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .fc h3 {
    font-size: 1.0625rem;
  }
  .lead {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 24px 48px;
  }
  .stat {
    border-top: 1px solid var(--rule-strong);
    padding-top: 14px;
  }
  .who {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .big {
    margin-top: 6px;
    font-size: 3.25rem;
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .what {
    margin-top: 8px;
    color: var(--ink-2);
  }
  .what b {
    color: var(--ink);
    font-weight: 600;
  }
  .aside {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .sub {
    margin: 4px 0 14px;
    color: var(--ink-2);
    font-size: 0.875rem;
    max-width: 68ch;
  }
  .note,
  .none {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 70ch;
  }
  .scroll {
    overflow-x: auto;
  }
  table.plain {
    width: auto;
    min-width: 28rem;
    border-collapse: collapse;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }
  table.plain th {
    text-align: left;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
    padding: 0 18px 10px 0;
    border-bottom: 1px solid var(--rule-strong);
    vertical-align: bottom;
  }
  table.plain tbody th {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
    vertical-align: middle;
  }
  table.plain td,
  table.plain tbody th {
    padding: 10px 18px 10px 0;
    border-bottom: 1px solid var(--rule);
    white-space: nowrap;
  }
  table.plain .n {
    text-align: right;
  }
  table.plain th[data-tip] {
    cursor: help;
  }

  /* Chart */
  .legend {
    display: flex;
    gap: 20px;
    list-style: none;
    margin: 0 0 8px;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .key {
    width: 18px;
    height: 0;
    border-top: 2px solid var(--data-1);
    border-radius: 1px;
  }
  .key.market {
    border-top-color: var(--data-2);
  }
  .chart {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    overflow: visible;
  }
  .chart.narrow {
    display: none;
    max-width: 380px;
  }
  .plot {
    fill: var(--surface);
  }
  .grid {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .ref {
    stroke: var(--axis);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .tick {
    fill: var(--muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .end {
    fill: var(--ink);
    font-size: 12px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .ln {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ln.model {
    stroke: var(--data-1);
  }
  .ln.market {
    stroke: var(--data-2);
  }
  .dot {
    stroke: var(--page);
    stroke-width: 2;
  }
  .dot.model {
    fill: var(--data-1);
  }
  .dot.market {
    fill: var(--data-2);
  }
  .hit {
    fill: transparent;
    outline: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .hit:hover {
      fill: var(--data-1-wash);
    }
  }
  .hit:focus-visible {
    fill: var(--data-1-wash);
  }
  @media (max-width: 560px) {
    .chart.wide {
      display: none;
    }
    .chart.narrow {
      display: block;
    }
    .big {
      font-size: 2.75rem;
    }
    .mid {
      font-size: 2rem;
    }
  }

  /* The raw log */
  .log > summary {
    cursor: pointer;
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 500;
    padding: 10px 0;
    border-top: 1px solid var(--rule);
  }
  .log[open] > summary {
    margin-bottom: 8px;
  }
  .rawlink {
    margin-top: -24px;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .rawlink a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 3px;
  }
</style>

<script>
  // The log sits closed; its link, and a #every-game address, open it.
  const log = document.getElementById("every-game") as HTMLDetailsElement | null;
  const openLog = () => {
    if (log && location.hash === "#every-game") log.open = true;
  };
  openLog();
  addEventListener("hashchange", openLog);
  document.querySelector("[data-open-log]")?.addEventListener("click", () => {
    if (log) log.open = true;
  });
</script>
