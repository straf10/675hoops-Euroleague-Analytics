---
// Points: each game's predicted home margin against the final home margin, in tip-off order. The
// bars are what happened, the line is what the model said; they meet where the model was right.
import { tip } from "../lib/tip";

export interface MarginGame {
  n: number;
  label: string;
  predicted: number;
  actual: number;
}

interface Props {
  id: string;
  title: string;
  /** What the chart shows, in plain words (first help line). */
  what: string;
  /** How to read it, with a concrete example (second help line). */
  how: string;
  games: MarginGame[];
  /** The corner label: which way is better, e.g. "Closer = better". */
  better: string;
}
const { id, title, what, how, games, better } = Astro.props;
const capId = `${id}-cap`;

// Same viewBox as the other scoring charts, so the three cards share one size.
const S = 320;
const H = 240;
const PAD = { left: 44, right: 12, top: 14, bottom: 36 };
const innerW = S - PAD.left - PAD.right;
const innerH = H - PAD.top - PAD.bottom;
const n = games.length;
const values = games.flatMap((g) => [g.predicted, g.actual, 0]);
const reach = Math.max(5, ...values.map((v) => Math.abs(v)));
const step = reach <= 10 ? 5 : reach <= 25 ? 10 : 20;
const top = Math.ceil(reach / step) * step;
const yMin = -top;
const yMax = top;
const ticks: number[] = [];
for (let v = yMin; v <= yMax; v += step) ticks.push(v);
const slot = n ? innerW / n : innerW;
const barW = Math.max(2, Math.min(14, slot * 0.6));
const x = (i: number) => PAD.left + slot * (i + 0.5);
const y = (v: number) => PAD.top + ((yMax - v) / (yMax - yMin)) * innerH;
const line = games.map((g, i) => `${i ? "L" : "M"}${x(i).toFixed(1)},${y(g.predicted).toFixed(1)}`).join("");
const sign = (v: number) => (v > 0 ? `+${Math.round(v)}` : `${Math.round(v)}`.replace("-", "−"));
const xTicks = [1, 10, 20, 30, 40, 50].filter((t) => t <= n);
---

<figure class="chart-card">
  <figcaption class="chart-head">
    <div class="cap-row">
      <h3 id={id}>{title}</h3>
      <span class="dir">{better}</span>
    </div>
    <div class="help" id={capId}>
      <p>{what}</p>
      <p>{how}</p>
    </div>
  </figcaption>
  <div class="plot-area">
    <ul class="legend" aria-hidden="true">
      <li><i class="sw actual" />Final margin</li>
      <li><i class="sw predicted" />Predicted margin</li>
    </ul>
    {
      n === 0 ? (
        <p class="empty">No finished games yet.</p>
      ) : (
        <svg viewBox={`0 0 ${S} ${H}`} role="img" aria-labelledby={`${id} ${capId}`} class="chart">
          <rect class="plot" x={PAD.left} y={PAD.top} width={innerW} height={innerH} />
          {ticks.map((v) => (
            <g class="grid">
              <line x1={PAD.left} x2={PAD.left + innerW} y1={y(v)} y2={y(v)} class={v === 0 ? "zero" : ""} />
              <text class="tick" x={PAD.left - 8} y={y(v) + 4} text-anchor="end">
                {sign(v)}
              </text>
            </g>
          ))}
          {games.map((g, i) => (
            <rect
              class={`bar ${g.actual >= 0 ? "up" : "down"}`}
              x={x(i) - barW / 2}
              y={Math.min(y(0), y(g.actual))}
              width={barW}
              height={Math.max(1, Math.abs(y(g.actual) - y(0)))}
            />
          ))}
          <path class="series" d={line} />
          {games.map((g, i) => (
            <g class="hit" tabindex="0" data-tip={tip`<b>Game ${g.n}</b><br>${g.label}<br>Predicted ${sign(g.predicted)}, final ${sign(g.actual)}`}>
              <circle class="target" cx={x(i)} cy={y(g.predicted)} r="7" />
              <circle class="dot" cx={x(i)} cy={y(g.predicted)} r="2.5" />
            </g>
          ))}
          {xTicks.map((t) => (
            <text class="tick" x={x(t - 1)} y={PAD.top + innerH + 18} text-anchor="middle">
              {t}
            </text>
          ))}
          <text class="axis-label" x={PAD.left + innerW / 2} y={H - 4} text-anchor="middle">
            Games played, in tip-off order · points, home side
          </text>
        </svg>
      )
    }
  </div>
  <table class="sr-only">
    <caption>{title}</caption>
    <thead>
      <tr>
        <th scope="col">Game</th>
        <th scope="col">Predicted margin</th>
        <th scope="col">Final margin</th>
      </tr>
    </thead>
    <tbody>
      {
        games.map((g) => (
          <tr>
            <td>{g.label}</td>
            <td>{sign(g.predicted)}</td>
            <td>{sign(g.actual)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</figure>

<style>
  .cap-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  /* Which way is better, in the chart's top-right corner: muted, never a data colour. */
  .dir {
    flex: none;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .help p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .legend {
    display: flex;
    gap: 18px;
    margin: 0 0 8px;
    padding: 0;
    list-style: none;
    color: var(--ink-2);
    font-size: 0.8125rem;
  }
  .sw {
    display: inline-block;
    width: 14px;
    height: 3px;
    margin-right: 6px;
    vertical-align: middle;
    border-radius: 2px;
  }
  .sw.actual {
    background: var(--data-2);
  }
  .sw.predicted {
    background: var(--data-1);
  }
  .chart {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .plot {
    fill: var(--surface);
  }
  .grid line {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .grid line.zero {
    stroke: var(--ink-2);
    stroke-dasharray: 4 4;
    opacity: 0.7;
  }
  .tick {
    fill: var(--muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .axis-label {
    fill: var(--muted);
    font-size: 11px;
  }
  .bar.up {
    fill: var(--data-2);
    fill-opacity: 0.45;
  }
  .bar.down {
    fill: var(--data-2);
    fill-opacity: 0.25;
  }
  .series {
    fill: none;
    stroke: var(--data-1);
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .dot {
    fill: var(--data-1);
    transition: transform 160ms var(--ease-out);
    transform-box: fill-box;
    transform-origin: center;
  }
  .target {
    fill: transparent;
  }
  .hit {
    cursor: default;
    outline: none;
  }
  .hit:hover .dot,
  .hit:focus-visible .dot {
    transform: scale(2.4);
  }
  .hit:focus-visible .target {
    stroke: var(--data-1);
    stroke-width: 1.5;
  }
  .empty {
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
