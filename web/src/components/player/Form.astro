---
// Form: his last five games as a trend of points, with the full log folded below.
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import LogTable from "./LogTable.astro";
import { logHtml, totalsOf } from "../../lib/player";
import { recentGames, trendHtml } from "../../lib/form";
import type { PlayerSeason } from "../../lib/stats";

interface Props {
  season: PlayerSeason;
  /** Every season with a log, newest first, for the full log's switch. */
  options: { value: number; label: string; selected: boolean }[];
}
const { season, options } = Astro.props;
const games = recentGames(season, 5);
const t = totalsOf(season.fields, season.totals);
const seasonAvg = t.gp ? t.pts / t.gp : 0;
---

{
  games.length > 0 && (
    <section class="wrap band" id="form" aria-labelledby="form-title">
      <header class="sec-head">
        <h2 id="form-title">Form</h2>
        <p>
          His last {games.length} game{games.length === 1 ? "" : "s"} in {season.label}, oldest to newest. Bars are points; the dashed line is his season average.
        </p>
      </header>
      <figure class="form-trend">
        <Fragment set:html={trendHtml(games, seasonAvg)} />
        <figcaption class="sr-only">Points in each of his last {games.length} games</figcaption>
      </figure>
      <div class="log-recent">
        <LogTable rows={logHtml(season, 5)} name="fc" />
      </div>
      <details class="more" id="full-log" data-view-root>
        <summary>
          Full game log
          <span class="chev" aria-hidden="true" set:html={caret} />
        </summary>
        {
          options.length > 1 && (
            <div class="more-pick">
              <label class="pick">
                <span class="sr-only">Season</span>
                <span class="select">
                  <select data-view="log">
                    {options.map((o) => (
                      <option value={o.value} selected={o.selected}>
                        {o.label}
                      </option>
                    ))}
                  </select>
                  <span class="caret" set:html={caret} />
                </span>
              </label>
            </div>
          )
        }
        <LogTable rows={logHtml(season)} name="lc" bodyId="log-body" />
      </details>
    </section>
  )
}
