---
// On/off: his team's net rating with him on court and off it, and the difference. One panel per
// season the stints cover; the season switch (the page script) shows the chosen one.
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import { signed } from "../../lib/format";
import { deltaHtml, signClass } from "../../lib/delta";
import type { OnOffView } from "../../lib/onoff";
import { tip } from "../../lib/tip";

export interface OnOffPanel {
  season: number;
  label: string;
  /** null when he has no possessions on court or off it that season. */
  view: OnOffView | null;
}

interface Props {
  panels: OnOffPanel[];
  chosen: number;
}
const { panels, chosen } = Astro.props;
const shown = (net: boolean, v: number | null) => (v === null ? "–" : net ? signed(v) : v.toFixed(1));
const rowsOf = (view: OnOffView) => {
  const { on, off } = view;
  return [
    { name: "Net rating", about: "Points scored minus points allowed per 100 possessions", on: on.net, off: off.net, better: "higher" as const, net: true },
    { name: "Scored", about: "Points scored per 100 possessions", on: on.off, off: off.off, better: "higher" as const, net: false },
    { name: "Allowed", about: "Points allowed per 100 possessions", on: on.def, off: off.def, better: "lower" as const, net: false },
  ];
};
const options = panels.map((p) => ({ value: p.season, label: p.label, selected: p.season === chosen }));
---

<section class="wrap band" id="onoff" aria-labelledby="onoff-title">
  <header class="sec-head split">
    <div>
      <h2 id="onoff-title">On/off</h2>
      {
        panels.map((p) => (
          <p data-stint={p.season} hidden={p.season !== chosen}>
            {p.label}: his team per 100 possessions with him on court and with him off it.
            {p.view && ` ${Math.round(p.view.on.minutes)} minutes on, ${Math.round(p.view.off.minutes)} off.`}
          </p>
        ))
      }
    </div>
    {
      panels.length > 1 && (
        <label class="pick">
          <span class="sr-only">Season</span>
          <span class="select">
            <select data-view="stint">
              {options.map((o) => (
                <option value={o.value} selected={o.selected}>
                  {o.label}
                </option>
              ))}
            </select>
            <span class="caret" set:html={caret} />
          </span>
        </label>
      )
    }
  </header>
  {
    panels.map((p) => (
      <div class="scroll" data-stint={p.season} hidden={p.season !== chosen}>
        {p.view ? (
          <table class="grid onoff">
            <caption class="sr-only">His team's rating with him on and off court, {p.label}</caption>
            <thead>
              <tr>
                <th scope="col">Per 100 possessions</th>
                <th scope="col" class="num">On</th>
                <th scope="col" class="num">Off</th>
                <th scope="col" class="num">
                  <span data-tip="On minus off" tabindex="0">Difference</span>
                </th>
              </tr>
            </thead>
            <tbody>
              {rowsOf(p.view).map((r) => (
                <tr>
                  <th scope="row" data-tip={tip`${r.about}`} tabindex="0">{r.name}</th>
                  <td class="num strong"><span class={r.net ? signClass(r.on) : undefined}>{shown(r.net, r.on)}</span></td>
                  <td class="num"><span class={r.net ? signClass(r.off) : undefined}>{shown(r.net, r.off)}</span></td>
                  <td class="num diff">
                    {r.on !== null && r.off !== null ? <Fragment set:html={deltaHtml(r.on - r.off, { better: r.better, versus: "off the floor" })} /> : "–"}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="note">No possessions on or off court that season.</p>
        )}
      </div>
    ))
  }
</section>
