---
// One competition's matchday on the home page. While any round is open (a forecast logged and a game
// still to play) it shows each open round, earliest first: played games with their result, unplayed
// ones with the forecast. With none open it shows the latest finished round's recap and the next
// round's fixtures. The choice is made at build time by matchdayPlan (lib/matchday.ts).
import type { Competition } from "../lib/format";
import { athensDay } from "../lib/format";
import { averageMiss, marginCheck, matchdayPlan, scorecard, type MatchdayRound } from "../lib/matchday";
import MatchRow from "./MatchRow.astro";

interface Props {
  comp: Competition;
}
const { comp } = Astro.props;
const { open, recap, next } = matchdayPlan(
  comp.matchday.rounds,
  comp.open_rounds.map((r) => r.round),
);
const card = recap ? scorecard(recap) : null;
// The published model's expected home margin per game, by game id (the home page's Points chart uses the same).
const fc = comp.forecasts;
const model = fc ? (fc.published ?? fc.models[0]?.key) : undefined;
const expMargin = new Map((fc && model ? fc.games : []).map((g) => [g.game_id, g.models[model]?.exp_margin]));
const recapChecks = recap ? recap.games.map((g) => marginCheck(g, expMargin.get(g.game_id))) : [];
const recapMiss = averageMiss(recapChecks);
// "Sat 24 Oct to Sun 25 Oct" style: the first and last day the round is played on.
const dayRange = (r: MatchdayRound) => {
  const days = [...new Set(r.games.map((g) => athensDay(g.tipoff_utc)))];
  return days.length > 2 ? `${days[0]} to ${days.at(-1)}` : days.join(" and ");
};
---

<div class="matchday" data-matchday={comp.key}>
  <h3 class="comp">{comp.title}</h3>

  {
    open.map((r) => (
      <div class="block">
        <header class="head">
          <h4>Round {r.round}</h4>
          <p>{r.games.some((g) => g.played) ? "On now" : `Starts ${dayRange(r)}, Athens time`}</p>
        </header>
        <ol class="rows">
          {r.games.map((g) => <MatchRow game={g} comp={comp.key} />)}
        </ol>
      </div>
    ))
  }

  {
    open.length === 0 && (
      <div class="block">
        <header class="head">
          <h4>{recap ? `Round ${recap.round}` : "Last round"}</h4>
          <div class="tally">
            <p>{card && card.scored > 0 ? `We picked ${card.right} of ${card.scored} right` : "No round has finished yet"}</p>
            {recapMiss !== null && <p class="miss">Average miss: {recapMiss.toFixed(1)} points</p>}
          </div>
        </header>
        {
          recap ? (
            <ol class="rows">
              {recap.games.map((g, i) => <MatchRow game={g} comp={comp.key} margin={recapChecks[i]} />)}
            </ol>
          ) : (
            <p class="none">The first round tips off {next ? dayRange(next) : "soon"}.</p>
          )
        }
        <header class="head next">
          <h4>{next ? `Next round: ${next.round}` : "Next round"}</h4>
          <p>{next ? `${dayRange(next)}, Athens time` : "No more games are scheduled this season"}</p>
        </header>
        {
          next && (
            <ol class="rows">
              {next.games.map((g) => <MatchRow game={g} comp={comp.key} />)}
            </ol>
          )
        }
      </div>
    )
  }
</div>

<style>
  .matchday,
  .rows {
    min-width: 0;
    max-width: 100%;
  }
  .matchday + .matchday {
    margin-top: 48px;
  }
  .block + .block {
    margin-top: 32px;
  }
  .comp {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    flex-wrap: wrap;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .head h4 {
    font-size: 1rem;
    font-weight: 600;
  }
  .head p {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .tally {
    text-align: right;
  }
  .tally .miss {
    margin-top: 2px;
  }
  .head.next {
    margin-top: 32px;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .none {
    margin-top: 14px;
    color: var(--muted);
    font-size: 0.875rem;
  }
</style>
