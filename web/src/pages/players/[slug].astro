---
import Base from "../../layouts/Base.astro";
import "../../styles/stats.css";
import "../../styles/player.css";
import { teamHref as linkTeam } from "../../lib/players";
import { perGame, totalsOf, ts, type Totals } from "../../lib/player";
import { meta, onOffData, playerData, playerIndex, season, twinData, type PlayerIndexRow } from "../../lib/stats";
import { displayCode, playerM6, playerSlugs } from "../../lib/m6";
import { leagueBoard } from "../../lib/league";
import { clutchView, onOffView } from "../../lib/onoff";
import { seasonEndFor } from "../../lib/season_end_page";
import { position } from "../../lib/position";
import ShotTwin from "../../components/ShotTwin.astro";
import Comparables from "../../components/Comparables.astro";
import ProjectionImpact from "../../components/ProjectionImpact.astro";
import Strip from "../../components/player/Strip.astro";
import AgainstLeague from "../../components/player/AgainstLeague.astro";
import Form from "../../components/player/Form.astro";
import ShotSections from "../../components/player/ShotSections.astro";
import OnOff from "../../components/player/OnOff.astro";
import Clutch from "../../components/player/Clutch.astro";
import SeasonEnd from "../../components/player/SeasonEnd.astro";
import Seasons from "../../components/player/Seasons.astro";

export async function getStaticPaths() {
  return (await playerIndex()).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: PlayerIndexRow };
const m = (await meta())!;
const data = await playerData(p);
const twins = await twinData(p.id);
const m6 = await playerM6(p.id);
const slugs = await playerSlugs();
const seasons = data.seasons;
const latest = seasons[seasons.length - 1];
const withShots = seasons.filter((s) => s.hex.length > 0);
const shotSeason = withShots[withShots.length - 1];
const radius = m.hex_radius_m;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const rows = seasons.map((s) => ({ s, t: totalsOf(s.fields, s.totals) }));
const career: Totals = {};
for (const { t } of rows) for (const [k, v] of Object.entries(t)) career[k] = (career[k] ?? 0) + v;
const clubs = [...new Set(seasons.flatMap((s) => s.teams))];
const lt = rows[rows.length - 1].t;
const span = seasons.length === 1 ? seasons[0].label : `${seasons[0].label} to ${latest.label}`;
const seasonCount = `${seasons.length} EuroLeague season${seasons.length === 1 ? "" : "s"}`;
const reb = perGame(lt, lt.oreb + lt.dreb);
const lede = `In ${latest.label}: ${perGame(lt, lt.pts)} points, ${reb} rebounds and ${perGame(lt, lt.ast)} assists a game over ${lt.gp} game${lt.gp === 1 ? "" : "s"}, on ${ts(lt)}% true shooting.`;
const description = `${data.name}: EuroLeague season-by-season stats, shot chart and game log, ${span}.`;
const teamHref = (code: string, year?: number) => linkTeam(base, code, year);
const seasonOptions = (list: typeof seasons, chosen: number) =>
  [...list].reverse().map((s) => ({ value: s.season, label: s.label, selected: s.season === chosen }));
const pos = position(latest.pos);

// 1. Against the league (his latest season)
const board = leagueBoard(await season(latest.season, "players"), p.id);

// 5-6. On/off and clutch, when the stints cover his latest season
const onoff = await onOffData();
const stints = onoff?.seasons.includes(latest.season) ? onoff.players[p.id]?.[String(latest.season)] : undefined;
const onOff = stints ? onOffView(stints) : null;
const clutch = stints ? clutchView(stints) : null;

// 7. Season-end projection: only for the live season, and only with an M6 projection
const live = m.seasons.find((s) => s.live);
const projection = m6.projection;
const proj = projection?.projections[0];
const end =
  live && projection && proj && projection.season === live.season
    ? await seasonEndFor({
        live: live.season,
        per100: proj.stats.pts?.mean ?? 0,
        fallbackTeam: displayCode(proj.competition, proj.team),
        rows: seasons,
      })
    : null;
---

<Base title={data.name} description={description} current="players">
  <header class="wrap head">
    <h1>{data.name}</h1>
    <p class="facts">
      {latest.dorsal && <span>#{latest.dorsal}</span>}
      <span>
        {latest.teams.map((t, i) => (
          <>
            {i > 0 && ", "}
            <a href={teamHref(t, latest.season)}>{m.teams[t] ?? t}</a>
          </>
        ))}
      </span>
      {pos && <span>{pos}</span>}
      <span>{seasonCount}, {span}</span>
      <a href={`${base}/compare/?p=${data.slug}:${latest.season}`}>Compare with others</a>
    </p>
    <p class="lede">{lede}</p>
    {
      clubs.length > 1 && (
        <p class="clubs">
          EuroLeague clubs:{" "}
          {clubs.map((t, i) => (
            <>
              {i > 0 && ", "}
              <a href={teamHref(t)}>{t}</a>
            </>
          ))}
        </p>
      )
    }
  </header>

  <div id="pdata" data-slug={data.slug} data-base={base} data-radius={radius} hidden></div>

  <Strip totals={lt} label={latest.label} />

  {board && <AgainstLeague board={board} slug={data.slug} label={latest.label} base={base} />}

  <Form season={latest} options={seasonOptions(seasons, latest.season)} />

  <ShotSections
    shotSeason={shotSeason}
    options={withShots.length > 1 ? seasonOptions(withShots, shotSeason.season) : []}
    radius={radius}
    index={m6.index}
  />

  {onOff && <OnOff view={onOff} label={latest.label} />}

  {
    clutch && onoff && (
      <Clutch clutch={clutch} label={latest.label} minutes={Math.round(onoff.clutch.last_seconds / 60)} margin={onoff.clutch.margin} />
    )
  }

  {end && projection && <SeasonEnd end={end.figures} report={projection} gamesPlayed={end.gamesPlayed} total={end.total} />}

  <ShotTwin data={twins} name={data.name} base={base} />

  {
    (m6.projection || m6.index) && (
      <section class="wrap band" id="impact" aria-labelledby="impact-title">
        <header class="sec-head">
          <h2 id="impact-title">Impact</h2>
          <p>Net points per 100 possessions against an average player, offence plus defence. Dashed line: average.</p>
        </header>
        <ProjectionImpact report={m6.projection} index={m6.index} />
      </section>
    )
  }

  <Comparables report={m6.similar} name={data.name} slugs={slugs} base={base} />

  <Seasons rows={rows} career={career} teamHref={teamHref} />
</Base>

<script>
  import up from "@phosphor-icons/core/assets/fill/caret-up-fill.svg?raw";
  import down from "@phosphor-icons/core/assets/fill/caret-down-fill.svg?raw";
  import { bandsHtml, logHtml, shotChart, unpackPlayer, type PackedPlayer } from "../../lib/player";
  import { countLine, dotLabel, freqChart, markChart } from "../../lib/shotmarks";
  import type { Bands, PlayerData } from "../../lib/stats";

  const root = document.getElementById("pdata");
  if (root) {
    const { slug, base, radius } = root.dataset;
    const fetchJson = <T,>(url: string): Promise<T> =>
      fetch(url).then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      });
    let data: Promise<PlayerData> | null = null;
    const load = () => (data ??= fetchJson<PackedPlayer>(`${base}/data/player/${slug}.json`).then(unpackPlayer));
    const league = new Map<number, Promise<Bands>>();
    const bandsOf = (season: number) => {
      if (!league.has(season)) league.set(season, fetchJson<{ bands: Bands }>(`${base}/data/season/${season}.json`).then((x) => x.bands));
      return league.get(season)!;
    };
    const html = (id: string, markup: string) => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = markup;
    };

    document.addEventListener("change", async (e) => {
      const select = e.target as HTMLSelectElement;
      const target = select.dataset?.view;
      if (!target) return;
      const section = select.closest("section") as HTMLElement;
      const linked = target === "shots" ? [...document.querySelectorAll<HTMLSelectElement>('select[data-view="shots"]')] : [select];
      for (const other of linked) other.value = select.value;
      const busy = linked.map((x) => (x.closest("section") as HTMLElement | null) ?? section);
      for (const el of busy) el.setAttribute("aria-busy", "true");
      try {
        const year = Number(select.value);
        const [d, bands] = await Promise.all([load(), target === "shots" ? bandsOf(year) : null]);
        const s = d.seasons.find((x) => x.season === year);
        if (!s) return;
        if (target === "shots") {
          s.leagueBands = bands!;
          html("court-dots", markChart(s.dots, dotLabel(s.label, s.dots)));
          html("court-freq", freqChart(s.hex, Number(radius), `${s.label} shot frequency: ${countLine(s.dots)}`));
          html("court-fg", shotChart(s, Number(radius)));
          html("bands", bandsHtml(s, up, down));
          const count = document.querySelector<HTMLElement>('[data-f="count"]');
          if (count) count.textContent = countLine(s.dots);
          const approx = document.querySelector<HTMLElement>('[data-f="approx"]');
          if (approx) approx.hidden = s.validated;
        } else {
          html("log-body", logHtml(s));
        }
      } catch {
        select.setCustomValidity("Could not load this season");
        select.reportValidity();
      } finally {
        for (const el of busy) el.removeAttribute("aria-busy");
      }
    });
  }
</script>
