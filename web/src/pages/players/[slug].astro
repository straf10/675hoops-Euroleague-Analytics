---
import Base from "../../layouts/Base.astro";
import { shotPair } from "../../lib/heat";
import "../../styles/stats.css";
import "../../styles/player.css";
import { teamHref as linkTeam } from "../../lib/players";
import { perGame, totalsOf, ts, type Totals } from "../../lib/player";
import { meta, onOffData, playerData, playerIndex, season, type PlayerIndexRow } from "../../lib/stats";
import { playerM6, rapmBoard } from "../../lib/m6";
import { leagueBoard } from "../../lib/league";
import { clutchView, onOffView } from "../../lib/onoff";
import { analysisSeason } from "../../lib/analysis";
import { position } from "../../lib/position";
import ProjectionImpact from "../../components/ProjectionImpact.astro";
import Rapm from "../../components/player/Rapm.astro";
import Strip from "../../components/player/Strip.astro";
import AgainstLeague from "../../components/player/AgainstLeague.astro";
import Form from "../../components/player/Form.astro";
import ShotSections from "../../components/player/ShotSections.astro";
import OnOff from "../../components/player/OnOff.astro";
import Clutch from "../../components/player/Clutch.astro";
import Seasons from "../../components/player/Seasons.astro";
import JsonLd from "../../components/JsonLd.astro";
import { person } from "../../lib/jsonld";

export async function getStaticPaths() {
  return (await playerIndex()).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: PlayerIndexRow };
const m = (await meta())!;
const data = await playerData(p);
const m6 = await playerM6(p.id);
// EuroLeague RAPM of the latest rated season (the board holds EuroLeague players only).
const rapm = await rapmBoard();
const rapmRow = rapm?.players.find((r) => r.person_id === `P:${p.id}`) ?? null;
const seasons = data.seasons;
const latest = seasons[seasons.length - 1];
const withShots = seasons.filter((s) => s.hex.length > 0);
const analysis = analysisSeason(seasons);
const shotSeason = withShots.find((s) => s.season === analysis.season) ?? withShots[withShots.length - 1];
// The page's orange details take the colour of the player's current club: his latest season's last club.
const pair = shotPair(latest.teams.at(-1));
const accent = pair.make;
const accentStyle = `--data-1: ${accent}; --data-1-wash: color-mix(in srgb, ${accent} 12%, transparent); --make: ${pair.make}; --miss: ${pair.miss}`;
const radius = m.hex_radius_m;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const rows = seasons.map((s) => ({ s, t: totalsOf(s.fields, s.totals) }));
const career: Totals = {};
for (const { t } of rows) for (const [k, v] of Object.entries(t)) career[k] = (career[k] ?? 0) + v;
const clubs = [...new Set(seasons.flatMap((s) => s.teams))];
const lt = rows[rows.length - 1].t;
const span = seasons.length === 1 ? seasons[0].label : `${seasons[0].label} to ${latest.label}`;
const seasonCount = `${seasons.length} EuroLeague season${seasons.length === 1 ? "" : "s"}`;
const reb = perGame(lt, lt.oreb + lt.dreb);
const lede = `In ${latest.label}: ${perGame(lt, lt.pts)} points, ${reb} rebounds and ${perGame(lt, lt.ast)} assists a game over ${lt.gp} game${lt.gp === 1 ? "" : "s"}, on ${ts(lt)}% true shooting.`;
const description = `${data.name}: EuroLeague season-by-season stats, shot chart and game log, ${span}.`;
const teamHref = (code: string, year?: number) => linkTeam(base, code, year);
const seasonOptions = (list: typeof seasons, chosen: number) =>
  [...list].reverse().map((s) => ({ value: s.season, label: s.label, selected: s.season === chosen }));
const pos = position(latest.pos);
const abs = (path: string) => new URL(path, Astro.site ?? "https://675hoops.com").href;

// 1. Against the league (his analysis season: a full-enough sample)
const board = leagueBoard(await season(analysis.season, "players"), p.id);

// 5-6. On/off and clutch for every season the stints cover for him, newest first (onoff.json). The
// live season is not in the file while its stints are short of the 90% pass rate, so it has no panel.
const onoff = await onOffData();
const stintRows = onoff?.players[p.id] ?? {};
const stintSeasons = (onoff?.seasons ?? []).filter((y) => stintRows[String(y)]).sort((a, b) => b - a);
const stintChosen = stintSeasons.includes(analysis.season) ? analysis.season : (stintSeasons[0] ?? 0);
const stintLabel = (y: number) => m.seasons.find((s) => s.season === y)?.label ?? String(y);
const onOffPanels = stintSeasons.map((y) => ({ season: y, label: stintLabel(y), view: onOffView(stintRows[String(y)]) }));
const clutchPanels = stintSeasons.map((y) => ({ season: y, label: stintLabel(y), clutch: clutchView(stintRows[String(y)]) }));
const onOffAny = onOffPanels.some((x) => x.view !== null);
const clutchAny = clutchPanels.some((x) => x.clutch !== null);
const clutchRule = onoff?.clutch;

const live = m.seasons.find((s) => s.live);
// A player in the live season has a share card, and his schema.org affiliation is his current clubs.
const current = live !== undefined && latest.season === live.season;
const card = current ? { path: `/cards/players/${data.slug}.png`, width: 1080, height: 1350 } : undefined;
---

<Base title={data.name} description={description} current="players" image={card} section={[{ name: "Players", href: `${base}/players/` }]}>
  <JsonLd
    slot="head"
    data={person({
      name: data.name,
      url: abs(`${base}/players/${data.slug}/`),
      affiliation: current
        ? latest.teams.map((code) => ({
            name: m.teams[code] ?? code,
            url: abs(`${base}/teams/${code.toLowerCase()}/`),
          }))
        : undefined,
    })}
  />
  <div class="accented" style={accentStyle}>
  <header class="wrap head">
    <h1>{data.name}</h1>
    <p class="facts">
      {latest.dorsal && <span>#{latest.dorsal}</span>}
      <span>
        {latest.teams.map((t, i) => (
          <>
            {i > 0 && ", "}
            <a href={teamHref(t, latest.season)}>{m.teams[t] ?? t}</a>
          </>
        ))}
      </span>
      {pos && <span>{pos}</span>}
      <span>{seasonCount}, {span}</span>
      <a href={`${base}/compare/?p=${data.slug}:${latest.season}`}>Compare with others</a>
      {card && <a href={`${base}/cards/players/${data.slug}/`}>Share card</a>}
    </p>
    <p class="lede">{lede}</p>
    {
      clubs.length > 1 && (
        <p class="clubs">
          EuroLeague clubs:{" "}
          {clubs.map((t, i) => (
            <>
              {i > 0 && ", "}
              <a href={teamHref(t)}>{t}</a>
            </>
          ))}
        </p>
      )
    }
  </header>

  <div id="pdata" data-slug={data.slug} data-base={base} data-radius={radius} data-shot={shotSeason?.season} hidden></div>

  <Strip totals={lt} label={latest.label} />

  {board && <AgainstLeague board={board} label={analysis.label} />}

  <Form season={latest} options={seasonOptions(seasons, latest.season)} />

  <ShotSections
    shotSeason={shotSeason}
    options={withShots.length > 1 ? seasonOptions(withShots, shotSeason.season) : []}
    radius={radius}
    index={m6.index}
  />

  {onOffAny && <OnOff panels={onOffPanels} chosen={stintChosen} />}

  {
    clutchAny && clutchRule && (
      <Clutch panels={clutchPanels} chosen={stintChosen} minutes={Math.round(clutchRule.last_seconds / 60)} margin={clutchRule.margin} />
    )
  }

  {
    (m6.projection || m6.index || (rapm && rapmRow)) && (
      <section class="wrap band" id="impact" aria-labelledby="impact-title">
        <header class="sec-head">
          <h2 id="impact-title">Impact</h2>
          <p>Net points per 100 possessions against an average player, offense plus defense. Dashed line: average.</p>
        </header>
        {rapm && rapmRow && <Rapm board={rapm} row={rapmRow} />}
        <ProjectionImpact report={m6.projection} index={m6.index} />
      </section>
    )
  }

  <Seasons rows={rows} career={career} teamHref={teamHref} />
  </div>
</Base>

<script>
  import up from "@phosphor-icons/core/assets/fill/caret-up-fill.svg?raw";
  import down from "@phosphor-icons/core/assets/fill/caret-down-fill.svg?raw";
  import { bandsHtml, logHtml, qualityChart, qualityStripHtml, unpackPlayer, type PackedPlayer } from "../../lib/player";
  import { countLine, dotLabel, markChart, type ShotFilter } from "../../lib/shotmarks";
  import { freqHeat, peakShots } from "../../lib/heat";
  import { pointsFilter, zoneDots, zoneLineText, zoneLit, type Zone } from "../../lib/zones";
  import type { Bands, PlayerData } from "../../lib/stats";

  const root = document.getElementById("pdata");
  if (root) {
    const { slug, base, radius } = root.dataset;
    const fetchJson = <T,>(url: string): Promise<T> =>
      fetch(url).then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      });
    let data: Promise<PlayerData> | null = null;
    const load = () => (data ??= fetchJson<PackedPlayer>(`${base}/data/player/${slug}.json`).then(unpackPlayer));
    const league = new Map<number, Promise<Bands>>();
    const bandsOf = (season: number) => {
      if (!league.has(season)) league.set(season, fetchJson<{ bands: Bands }>(`${base}/data/season/${season}.json`).then((x) => x.bands));
      return league.get(season)!;
    };
    const html = (id: string, markup: string) => {
      const el = document.getElementById(id);
      if (el) el.innerHTML = markup;
    };

    // Attempts: the filter shows only when the Attempts view is on; the dots and the count follow it.
    let shotYear = Number(root.dataset.shot);
    const shotFilter = (): ShotFilter =>
      document.querySelector<HTMLInputElement>('input[name="shot-view"]:checked')?.value === "dots"
        ? ((document.querySelector<HTMLInputElement>('input[name="shot-filter"]:checked')?.value as ShotFilter | undefined) ?? "all")
        : "all";
    // Zone chips (multi-select; none picked = all) narrow the attempts, and dim the heatmap squares outside
    // the picked zones. The 2PT / 3PT switch narrows the same attempts (AND). Every shot view redraws together.
    const picked = new Set<Zone>();
    const drawShots = (s: PlayerData["seasons"][number]) => {
      const all = pointsFilter(s.dots, shotFilter());
      const dots = zoneDots(all, picked);
      const lit = zoneLit(picked);
      html("court-dots", markChart(dots, dotLabel(s.label, dots)));
      html("court-freq", freqHeat(s.hex, Number(radius), `${s.label} shot frequency: ${countLine(s.dots)}`, lit));
      html("court-quality", qualityChart(s, Number(radius), lit));
      const count = document.querySelector<HTMLElement>('[data-f="count"]');
      if (count) count.textContent = countLine(dots);
      const zone = document.querySelector<HTMLElement>('[data-f="zone"]');
      if (zone) {
        zone.textContent = zoneLineText(all, picked);
        zone.hidden = picked.size === 0;
      }
    };
    document.querySelectorAll<HTMLButtonElement>("#shots .chip").forEach((chip) =>
      chip.addEventListener("click", async () => {
        const z = chip.dataset.zone as Zone | "";
        if (!z) picked.clear();
        else if (picked.has(z)) picked.delete(z);
        else picked.add(z);
        document.querySelectorAll<HTMLButtonElement>("#shots .chip").forEach((c) =>
          c.setAttribute("aria-pressed", String(c.dataset.zone ? picked.has(c.dataset.zone as Zone) : picked.size === 0)),
        );
        const s = (await load()).seasons.find((x) => x.season === shotYear);
        if (s) drawShots(s);
      }),
    );
    document.addEventListener("change", async (e) => {
      const input = e.target as HTMLInputElement;
      if (input.name === "shot-filter" || input.name === "shot-view") {
        const s = (await load()).seasons.find((x) => x.season === shotYear);
        if (s) drawShots(s);
        return;
      }
      const select = e.target as HTMLSelectElement;
      const target = select.dataset?.view;
      if (!target) return;
      if (target === "stint") {
        // On/off and clutch: one season for both sections; every season's panel is in the page.
        for (const other of document.querySelectorAll<HTMLSelectElement>('select[data-view="stint"]')) other.value = select.value;
        document.querySelectorAll<HTMLElement>("[data-stint]").forEach((el) => {
          el.hidden = el.dataset.stint !== select.value;
        });
        return;
      }
      const section = select.closest("section") as HTMLElement;
      const linked = target === "shots" ? [...document.querySelectorAll<HTMLSelectElement>('select[data-view="shots"]')] : [select];
      for (const other of linked) other.value = select.value;
      const busy = linked.map((x) => (x.closest("section") as HTMLElement | null) ?? section);
      for (const el of busy) el.setAttribute("aria-busy", "true");
      try {
        const year = Number(select.value);
        const [d, bands] = await Promise.all([load(), target === "shots" ? bandsOf(year) : null]);
        const s = d.seasons.find((x) => x.season === year);
        if (!s) return;
        if (target === "shots") {
          s.leagueBands = bands!;
          shotYear = year;
          drawShots(s);
          const peak = document.querySelector<HTMLElement>('[data-f="peak"]');
          if (peak) peak.textContent = String(peakShots(s.hex, Number(radius)));
          html("bands", bandsHtml(s, up, down));
          html("qstrip", qualityStripHtml(s.bands, s.leagueBands));
          const approx = document.querySelector<HTMLElement>('[data-f="approx"]');
          if (approx) approx.hidden = s.validated;
        } else {
          html("log-body", logHtml(s));
        }
      } catch {
        select.setCustomValidity("Could not load this season");
        select.reportValidity();
      } finally {
        for (const el of busy) el.removeAttribute("aria-busy");
      }
    });
  }
</script>
