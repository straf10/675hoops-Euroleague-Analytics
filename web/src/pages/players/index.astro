---
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import Base from "../../layouts/Base.astro";
import {
  BY_KEY,
  METRIC_GROUPS,
  MIN_PRESETS,
  POSITION_CHOICES,
  RATE_CHOICES,
  TOPS,
  bodyHtml,
  countText,
  DEFAULT_VIEW,
  dotsHtml,
  gridHtml,
  headHtml,
  lines,
  rapmData,
  shown,
  strip,
  ticksHtml,
  topLabel,
  type RapmData,
  type View,
} from "../../lib/players";
import { rapmBoard } from "../../lib/m6";
import { defaultSeason, meta, season } from "../../lib/stats";
import { GROUPS, colsHtml } from "../../lib/cols";

const m = await meta();
const base = import.meta.env.BASE_URL;
const first = m ? defaultSeason(m) : null;
const data = first ? await season(first.season, "players") : null;
const view: View = { ...DEFAULT_VIEW, season: first?.season ?? 0 };
const seasons = m ? [...m.seasons].reverse() : [];
const label = (year: number) => seasons.find((x) => x.season === year)?.label ?? `${year}-${String((year + 1) % 100).padStart(2, "0")}`;
const board = await rapmBoard();
const rapm: RapmData | null = board ? rapmData(board, label(board.season)) : null;
const hasRapm = (year: number) => rapm !== null && rapm.season === year;
const ls = data ? lines(data, view, rapm) : [];
const rows = shown(ls, view);
const plot = strip(ls, view);
const early = seasons.filter((x) => !x.coords_validated).map((x) => x.label);
const cfg = {
  base,
  defaultSeason: first?.season ?? 0,
  seasons: seasons.map((x) => x.season),
  rapm,
};
const description =
  "Every EuroLeague player of the season ranked on any measure, per game, by position and minutes.";
---

<Base title="Players" description={description} current="players">
  <section class="wrap head" aria-labelledby="players-title">
    <h1 id="players-title">Players</h1>
    <p>Every EuroLeague player, ranked on any measure. Click a column to re-rank.</p>
  </section>

  {
    !m || !data ? (
      <section class="wrap">
        <p class="empty-state">
          The stats data has not been exported yet. Run <code>eurohoops export-stats</code> and
          rebuild.
        </p>
      </section>
    ) : (
      <section class="wrap" id="players" data-cfg={JSON.stringify(cfg)} data-set={view.set}>
        <form class="filters" id="filters" aria-label="Filters">
          <label class="field">
            <span>Metric</span>
            <span class="select">
              <select name="metric" style="--select-w: 11.5rem">
                {METRIC_GROUPS.map((g) => (
                  <optgroup label={g.label}>
                    {g.keys
                      .filter((k) => k !== "rapm" || hasRapm(view.season))
                      .map((k) => (
                        <option value={k} selected={k === view.metric}>
                          {BY_KEY[k].name}
                        </option>
                      ))}
                  </optgroup>
                ))}
              </select>
              <span class="caret" set:html={caret} />
            </span>
          </label>

          <label class="field">
            <span>Season</span>
            <span class="select">
              <select name="season" style="--select-w: 7.875rem">
                {seasons.map((s) => (
                  <option value={s.season} selected={s.season === view.season}>
                    {s.label}
                  </option>
                ))}
              </select>
              <span class="caret" set:html={caret} />
            </span>
          </label>

          <fieldset class="field">
            <legend>Min/game</legend>
            <div class="seg" role="radiogroup" aria-label="Minutes per game, at least">
              {MIN_PRESETS.map((n) => (
                <>
                  <input type="radio" name="minPreset" id={`mp-${n}`} value={n} checked={n === view.minMin} />
                  <label for={`mp-${n}`}>{n}</label>
                </>
              ))}
            </div>
          </fieldset>

          <fieldset class="field">
            <legend>Rate</legend>
            <div class="seg" role="radiogroup" aria-label="Rate: per game, per 36 minutes or per 100 possessions">
              {RATE_CHOICES.map((r) => (
                <>
                  <input type="radio" name="rate" id={`rate-${r.key}`} value={r.key} checked={r.key === view.rate} />
                  <label for={`rate-${r.key}`}>{r.label}</label>
                </>
              ))}
            </div>
          </fieldset>

          <label class="field">
            <span>Show top</span>
            <span class="select">
              <select name="top" style="--select-w: 5.5rem">
                {TOPS.map((n) => (
                  <option value={n} selected={n === view.top}>
                    {topLabel(n)}
                  </option>
                ))}
              </select>
              <span class="caret" set:html={caret} />
            </span>
          </label>

          <fieldset class="field">
            <legend>Position</legend>
            <div class="seg">
              {POSITION_CHOICES.map((p) => (
                <>
                  <input type="radio" name="pos" id={`pos-${p.label}`} value={p.key} checked={p.key === view.pos} />
                  <label for={`pos-${p.label}`}>{p.label}</label>
                </>
              ))}
            </div>
          </fieldset>
        </form>

        <div class="board">
          <div class="list">
            <div class="list-tools">
              <fieldset class="seg" aria-label="Columns">
                <input type="radio" name="set" id="set-box" value="box" form="filters" checked />
                <label for="set-box">Box score</label>
                <input type="radio" name="set" id="set-shooting" value="shooting" form="filters" />
                <label for="set-shooting">Shooting</label>
                <input type="radio" name="set" id="set-advanced" value="advanced" form="filters" />
                <label for="set-advanced">Advanced</label>
              </fieldset>
              <Fragment set:html={colsHtml("cols", GROUPS.players)} />
              <p class="count" id="count" aria-live="polite">
                {countText(rows.length, ls.length)}
              </p>
            </div>
            <div class="scroll" id="scroll">
              <table id="table">
                <caption class="sr-only">
                  Players, sorted by the chosen measure
                </caption>
                <thead id="thead" set:html={headHtml(view, hasRapm(view.season))} />
                <tbody id="tbody" set:html={bodyHtml(rows, view, base, hasRapm(view.season))} />
              </table>
            </div>
            <button type="button" class="more" id="more" hidden>Show all {rows.length} players</button>
          </div>

          <figure class="rank" aria-labelledby="rank-title">
            <figcaption>
              <h2 id="rank-title">{plot.title}</h2>
              <p class="legend" id="rank-legend">
                <i class="k-dot" aria-hidden="true" />
                <span id="top-text">{view.top ? `Top ${view.top}` : "All ranked"}</span>
                <span class="key" id="key-rest" hidden={view.top === 0}>
                  <i class="k-rest" aria-hidden="true" />
                  Others
                </span>
                <i class="k-avg" aria-hidden="true" />
                <span id="avg-text">
                  {plot.avg ? `Average of the ${plot.avg.n} players ranked, ${plot.avg.text}` : "No players ranked"}
                </span>
              </p>
            </figcaption>
            <div class="strip" id="strip">
              <span class="ticks" id="ticks" aria-hidden="true" set:html={ticksHtml(plot)} />
              <span class="gridlines" id="gridlines" aria-hidden="true" set:html={gridHtml(plot)} />
              <i class="avg" id="avg" aria-hidden="true" hidden={!plot.avg} style={`--y:${plot.avg?.y.toFixed(2) ?? 0}`} />
              <div class="plot" id="plot" set:html={dotsHtml(plot, base)} />
            </div>
          </figure>
        </div>

        <p class="note">
          Players need at least a quarter of the most games played; a percentage ranks only players with enough
          attempts.{early.length > 0 && ` Shot locations for ${early[early.length - 1]} to ${early[0]} are approximate.`}
        </p>
        <p class="note" id="rapm-note" hidden={hasRapm(view.season)}>
          RAPM is published for finished seasons only, so it is hidden for this one. The latest season with a board is{" "}
          {rapm?.label ?? "none yet"}.
        </p>
      </section>
    )
  }
</Base>

<script>
  import { DEFAULT_HALF_WIDTH } from "../../lib/strip";
  import {
    bodyHtml,
    countText,
    dirOf,
    dotHtml,
    fromQuery,
    gridHtml,
    headHtml,
    lines,
    PHONE_GROUPS,
    setOf,
    shown,
    strip,
    ticksHtml,
    toQuery,
    type Rate,
    type RapmData,
    type Strip,
    type View,
  } from "../../lib/players";
  import type { SeasonPlayers } from "../../lib/stats";

  const host = document.getElementById("players");
  if (host) {
    const cfg = JSON.parse(host.dataset.cfg ?? "{}") as {
      base: string;
      defaultSeason: number;
      seasons: number[];
      rapm: RapmData | null;
    };
    const form = document.getElementById("filters") as HTMLFormElement;
    const plot = document.getElementById("plot") as HTMLDivElement;
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const cache = new Map<number, Promise<SeasonPlayers>>();
    const root = cfg.base.replace(/\/$/, "");
    const loadSeason = (s: number) => {
      if (!cache.has(s)) {
        cache.set(
          s,
          fetch(`${root}/data/players/${s}.json`).then((r) => {
            if (!r.ok) throw new Error(`season ${s}: ${r.status}`);
            return r.json();
          }),
        );
      }
      return cache.get(s)!;
    };

    let view: View = fromQuery(location.search, cfg.seasons, cfg.defaultSeason);

    const setField = (name: string, value: string) => {
      const el = form.elements.namedItem(name);
      if (el instanceof RadioNodeList) el.value = value;
      else if (el instanceof HTMLSelectElement || el instanceof HTMLInputElement) el.value = value;
    };
    // Min/game is the preset radios alone: the checked one is the view's minimum.
    const syncMinutes = () => {
      for (const r of form.querySelectorAll<HTMLInputElement>('input[name="minPreset"]')) {
        r.checked = Number(r.value) === view.minMin;
      }
    };

    // RAPM is offered only for the season that has a board. Its option is added and removed as the
    // season changes; a view on RAPM in another season falls back to points.
    const hasRapm = () => cfg.rapm !== null && cfg.rapm.season === view.season;
    const advanced = form.querySelector<HTMLOptGroupElement>('optgroup[label="Advanced"]')!;
    const rapmOption =
      advanced.querySelector<HTMLOptionElement>('option[value="rapm"]') ??
      Object.assign(document.createElement("option"), { value: "rapm", textContent: "RAPM" });
    const syncRapm = () => {
      const on = hasRapm();
      if (on && !rapmOption.isConnected) advanced.append(rapmOption);
      if (!on && rapmOption.isConnected) rapmOption.remove();
      $("rapm-note").hidden = on;
      if (!on && view.metric === "rapm") {
        view = { ...view, metric: "pts", dir: dirOf("pts"), set: setOf("pts") };
        setField("metric", view.metric);
        setField("set", view.set);
      }
    };
    const syncForm = () => {
      setField("season", String(view.season));
      setField("metric", view.metric);
      setField("top", String(view.top));
      setField("pos", view.pos);
      setField("set", view.set);
      setField("rate", view.rate);
      syncMinutes();
    };

    const syncAvg = (s: Strip) => {
      const avg = $("avg");
      avg.hidden = !s.avg;
      if (s.avg) avg.style.setProperty("--y", s.avg.y.toFixed(2));
      $("avg-text").textContent = s.avg ? `Average of the ${s.avg.n} players ranked, ${s.avg.text}` : "No players ranked";
    };

    // Dots are kept by player, so a change slides them (CSS transition) instead of redrawing.
    const syncDots = (s: Strip) => {
      const old = new Map<string, HTMLAnchorElement>();
      plot.querySelectorAll<HTMLAnchorElement>("a.dot").forEach((a) => old.set(a.dataset.id!, a));
      const template = document.createElement("template");
      for (const p of s.points) {
        const id = p.line.row.id;
        template.innerHTML = dotHtml(p, s, cfg.base);
        const next = template.content.firstElementChild as HTMLAnchorElement;
        const prev = old.get(id);
        if (prev) {
          old.delete(id);
          for (const name of ["class", "href", "data-tip", "aria-label"]) {
            prev.setAttribute(name, next.getAttribute(name) ?? "");
          }
          prev.style.setProperty("--dx", String(p.dot.dx));
          prev.style.setProperty("--y", String(p.dot.y));
        } else {
          plot.append(next);
        }
      }
      old.forEach((el) => el.remove());
    };

    // Hovering a dot highlights its row, and a row highlights its dot.
    const hot = (id: string | null) => {
      host.querySelectorAll(".hot").forEach((el) => el.classList.remove("hot"));
      if (id) host.querySelectorAll<HTMLElement>(`[data-id="${id}"]`).forEach((el) => el.classList.add("hot"));
    };
    plot.addEventListener("pointerover", (e) => {
      const dot = (e.target as Element).closest<HTMLElement>("a.dot");
      if (dot) hot(dot.dataset.id!);
    });
    plot.addEventListener("pointerleave", () => hot(null));
    $("tbody").addEventListener("pointerover", (e) => {
      const tr = (e.target as Element).closest<HTMLElement>("tr[data-id]");
      if (tr) hot(tr.dataset.id!);
    });
    $("tbody").addEventListener("pointerleave", () => hot(null));

    // How far a tie may spread: half the plot's real width less a dot's radius (the default before it is laid out).
    const halfWidth = () => (plot.clientWidth ? Math.max(0, plot.clientWidth / 2 - 5) : DEFAULT_HALF_WIDTH);
    let lastData: SeasonPlayers | null = null;
    let lastHalf = -1;
    const paint = (data: SeasonPlayers) => {
      lastData = data;
      lastHalf = halfWidth();
      const ls = lines(data, view, cfg.rapm);
      const top = shown(ls, view);
      const s = strip(ls, view, lastHalf);
      const rapm = hasRapm();
      $("rank-title").textContent = s.title;
      $("top-text").textContent = view.top ? `Top ${view.top}` : "All ranked";
      $("key-rest").hidden = view.top === 0;
      $("ticks").innerHTML = ticksHtml(s);
      $("gridlines").innerHTML = gridHtml(s);
      syncAvg(s);
      syncDots(s);
      $("thead").innerHTML = headHtml(view, rapm);
      $("tbody").innerHTML = bodyHtml(top, view, cfg.base, rapm);
      $("count").textContent = countText(top.length, ls.length);
      shorten(top.length);
      syncCols(false);
      history.replaceState(null, "", location.pathname + toQuery(view, cfg.defaultSeason));
    };

    // Phones list the first PHONE_ROWS rows until asked; wider screens scroll the table in its box.
    const PHONE_ROWS = 50;
    const narrow = matchMedia("(max-width: 1080px)");
    const list = $("scroll").parentElement as HTMLElement;
    const more = $("more") as HTMLButtonElement;
    let all = false;
    const shorten = (n: number) => {
      list.classList.toggle("cut", !all);
      more.hidden = all || !narrow.matches || n <= PHONE_ROWS;
      more.textContent = `Show all ${n} players`;
    };
    more.addEventListener("click", () => {
      all = true;
      shorten(0);
    });
    narrow.addEventListener("change", () => shorten($("tbody").children.length));
    shorten($("tbody").children.length);
    // The fade under the table box says there is more; it lifts at the end.
    const box = $("scroll");
    const atEnd = () => box.classList.toggle("end", box.scrollTop + box.clientHeight >= box.scrollHeight - 2);
    box.addEventListener("scroll", atEnd, { passive: true });
    new ResizeObserver(atEnd).observe(box);

    // A resize changes how far a tie may spread: repaint the dots once the width moves by a pixel.
    window.addEventListener("resize", () => {
      if (lastData && Math.abs(halfWidth() - lastHalf) >= 1) paint(lastData);
    });

    let pending = 0;
    const update = async () => {
      const ticket = ++pending;
      host.setAttribute("aria-busy", "true");
      try {
        const data = await loadSeason(view.season);
        if (ticket !== pending) return;
        paint(data);
      } catch {
        $("count").textContent = "Could not load this season. Reload the page to try again.";
      } finally {
        if (ticket === pending) host.removeAttribute("aria-busy");
      }
    };

    // A new metric starts from its best end and shows in a column set that has it.
    const choose = (metric: string) => {
      view = { ...view, metric, dir: dirOf(metric), set: setOf(metric) };
      setField("set", view.set);
    };

    host.addEventListener("input", (e) => {
      const el = e.target as HTMLInputElement;
      if (el.form !== form) return;
      switch (el.name) {
        case "season":
          view = { ...view, season: Number(el.value) };
          syncRapm();
          break;
        case "metric":
          choose(el.value);
          break;
        case "top":
          view = { ...view, top: Number(el.value) };
          break;
        case "pos":
          view = { ...view, pos: el.value as View["pos"] };
          break;
        case "set":
          view = { ...view, set: el.value as View["set"] };
          break;
        case "minPreset":
          view = { ...view, minMin: Number(el.value) };
          syncMinutes();
          break;
        case "rate":
          view = { ...view, rate: el.value as Rate };
          break;
        default:
          return;
      }
      host.dataset.set = view.set;
      update();
    });
    form.addEventListener("submit", (e) => e.preventDefault());

    $("thead").addEventListener("click", (e) => {
      const button = (e.target as Element).closest<HTMLButtonElement>("button[data-sort]");
      if (!button) return;
      const key = button.dataset.sort!;
      view = { ...view, metric: key, dir: view.metric === key && view.dir === "desc" ? "asc" : "desc" };
      setField("metric", key);
      update().then(() => ($("thead").querySelector(`[data-sort="${key}"]`) as HTMLElement)?.focus());
    });

    // Phones pick one of four column groups (PHONE_GROUPS), two per column set: a group of the
    // other set switches the set. The ranked column shows in every group. The advanced set has no
    // groups on a phone: it shows all its columns, and the group control hides (see the CSS).
    const cols = [...host.querySelectorAll<HTMLInputElement>('input[name="cols"]')];
    const syncCols = (toSort: boolean) => {
      if (view.set === "advanced") return;
      const at = cols.findIndex((c) => c.checked);
      if (!toSort && PHONE_GROUPS[at]?.set === view.set) return;
      const own = PHONE_GROUPS.findIndex((g) => g.set === view.set && g.keys.includes(view.metric));
      cols[own >= 0 ? own : PHONE_GROUPS.findIndex((g) => g.set === view.set)].checked = true;
    };
    cols.forEach((c, i) =>
      c.addEventListener("change", () => {
        const { set } = PHONE_GROUPS[i];
        if (set === view.set) return;
        view = { ...view, set };
        setField("set", set);
        host.dataset.set = set;
        update();
      }),
    );

    host.dataset.set = view.set;
    syncRapm();
    syncForm();
    syncCols(true);
    if (location.search) update();
    // Warm the shown season so the first change is instant.
    else (window.requestIdleCallback ?? setTimeout)(() => loadSeason(view.season));
  }
</script>

<style>
  .head {
    padding-top: 56px;
  }
  h1 {
    font-size: 2.25rem;
    font-weight: 620;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .head p {
    margin-top: 10px;
    max-width: 64ch;
    color: var(--ink-2);
  }

  /* Filters: one row, controls in ink, never colour. */
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 14px 20px;
    margin: 32px 0 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }
  .field {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .field > span:first-child,
  .field legend {
    padding: 0;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--muted);
  }
  .field legend {
    margin-bottom: 6px;
  }
  .select {
    position: relative;
    display: flex;
    align-items: center;
  }
  select {
    appearance: none;
    height: 32px;
    border: 0;
    border-radius: 8px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    color: var(--ink);
    font: 500 0.8125rem/1 var(--font);
    font-variant-numeric: tabular-nums;
    transition: box-shadow 150ms ease;
  }
  select {
    width: var(--select-w, auto); /* pinned to its Geist width, as .seg in global.css */
    max-width: 12rem;
    padding: 0 30px 0 10px;
    cursor: pointer;
    text-overflow: ellipsis;
  }
  @media (hover: hover) and (pointer: fine) {
    select:hover {
      box-shadow: inset 0 0 0 1px var(--ink-2);
    }
  }
  select:focus-visible {
    outline: 2px solid var(--data-1);
    outline-offset: 1px;
  }
  .caret {
    position: absolute;
    display: grid;
    pointer-events: none;
    color: var(--ink-2);
  }
  .caret {
    right: 10px;
    font-size: 11px;
  }
  .caret :global(svg) {
    width: 1em;
    height: 1em;
    fill: currentColor;
  }

  /* Board: players table (7) beside the strip plot (5); stacked, the table comes first. */
  .board {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 48px;
    align-items: start;
  }
  :global(#players[aria-busy]) .board {
    opacity: 0.6;
    transition: opacity 150ms ease 150ms;
  }

  .rank {
    margin: 0;
  }
  figcaption {
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule-strong);
  }
  figcaption h2 {
    font-size: 1rem;
    letter-spacing: -0.01em;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 6px;
    margin-top: 6px;
    font-size: 0.75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .key[hidden] {
    display: none;
  }
  .k-dot,
  .k-rest {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .k-dot {
    background: var(--data-1);
  }
  .k-rest {
    background: var(--muted);
    opacity: 0.45;
  }
  .k-avg {
    width: 0;
    height: 12px;
    margin-left: 10px;
    border-left: 1.5px dashed var(--data-2);
  }

  /* The strip: a value axis on the left (ticks), the dots in the column to its right. Dots are
     placed by lib/strip.ts (px from the top, and an offset from the centre line). */
  .strip {
    position: relative;
    height: 432px; /* STRIP_HEIGHT in lib/strip.ts */
    margin: 12px 0 0 3.25rem;
    font-size: 0.8125rem;
  }
  .ticks {
    position: absolute;
    top: 0;
    right: 100%;
    bottom: 0;
    width: 3rem;
  }
  .ticks :global(span) {
    position: absolute;
    right: 10px;
    top: calc(var(--y) * 1px);
    translate: 0 -50%;
    font-size: 11px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .gridlines :global(i) {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--y) * 1px);
    border-top: 1px solid var(--rule);
  }
  .avg {
