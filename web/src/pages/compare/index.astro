---
import plus from "@phosphor-icons/core/assets/regular/user-plus.svg?raw";
import x from "@phosphor-icons/core/assets/regular/x.svg?raw";
import Base from "../../layouts/Base.astro";
import { MAX, RATES } from "../../lib/compare";
import { PRESETS, presetHref, usablePresets } from "../../lib/compare_presets";
import { seasonLabel } from "../../lib/leaders";
import { cardData, meta, season } from "../../lib/stats";
import { clubRows } from "../../lib/team";
import { TEAM_MAX, teamOptions, withShots, type BandCounts, type TeamSeasonRows } from "../../lib/compare_teams";
import "../../styles/stats.css";
import Polygon from "../../components/compare/Polygon.astro";
import TeamProfile from "../../components/compare/TeamProfile.astro";

const m = await meta();
// Teams mode: every published club-season, with the teams index's figures and the shot shares, embedded
// for the browser (the same rows the Teams index draws from, so the numbers agree).
const teamSeasons: TeamSeasonRows[] = m
  ? await Promise.all(
      m.seasons.map(async (s) => {
        const d = await season(s.season, "teams");
        const bands = Object.fromEntries(d.teams.map((t) => [t.code, t.bands as BandCounts]));
        return { season: s.season, label: s.label, rows: withShots(clubRows(d.fields, d.teams), bands) };
      }),
    )
  : [];
const teamChoices = teamOptions([...teamSeasons].reverse());
const base = import.meta.env.BASE_URL;
// Curated sets: a preset is dropped (with a build warning) when a slug or season is not in the data.
const known = new Map<string, { name: string; seasons: number[] } | null>();
for (const p of PRESETS)
  for (const pick of p.picks) {
    const slug = pick.split(":")[0];
    if (!known.has(slug)) {
      const c = m ? await cardData(slug) : null;
      known.set(slug, c ? { name: c.name, seasons: c.seasons.map((s) => s.season) } : null);
    }
  }
const curated = usablePresets(PRESETS, (slug) => known.get(slug)?.seasons ?? null);
curated.warnings.forEach((w) => console.warn(w));
const presets = curated.ok.map((p) => ({
  label: p.label,
  href: presetHref(base, p),
  names: p.picks
    .map((pick) => {
      const [slug, season] = pick.split(":");
      const name = known.get(slug)?.name ?? slug;
      return season ? `${name} ${seasonLabel(Number(season))}` : name;
    })
    .join(", "),
}));
const cfg = { base, xIcon: x };
const description = "Up to five EuroLeague players side by side, a season each or whole careers, measure by measure.";
---

<Base title="Compare" description={description} current="compare">
  <section class="wrap head" aria-labelledby="compare-title">
    <h1 id="compare-title">Compare</h1>
    <p class="mode-players">
      Up to five players side by side, each in one season or over his whole career. Every measure is
      a row; the orange dot marks who leads it among the players compared.
    </p>
    <p class="mode-teams">
      Up to five club-seasons side by side: ratings, four factors and shot profile. The polygon ranks each club against
      every club of its season. The orange dot marks who leads each measure among those compared.
    </p>
    {
      m && (
        <nav class="mode-switch" aria-label="Compare players or teams">
          <a href="?" data-mode-link="players">Players</a>
          <a href="?mode=teams" data-mode-link="teams">Teams</a>
        </nav>
      )
    }
    <script is:inline>
      // Teams mode comes from the link (?mode=teams). One view shows at a time; the current link is marked.
      const mode = /(^|[?&])mode=teams(&|$)/.test(location.search) ? "teams" : "players";
      document.documentElement.dataset.mode = mode;
      document.querySelectorAll("[data-mode-link]").forEach((a) => a.setAttribute("aria-current", a.dataset.modeLink === mode ? "page" : "false"));
    </script>
  </section>

  {
    !m ? (
      <section class="wrap">
        <p class="empty-state">
          The stats data has not been exported yet. Run <code>eurohoops export-stats</code> and rebuild.
        </p>
      </section>
    ) : (
      <section class="wrap" id="compare" data-cfg={JSON.stringify(cfg)}>
        <div id="players-view">
        <form class="filters" id="filters" aria-label="Players and options">
          <label class="field grow">
            <span>Add a player</span>
            <span class="search">
              <span class="glass" set:html={plus} />
              <input
                type="search"
                name="add"
                id="add"
                list="names"
                placeholder="Type a name"
                autocomplete="off"
                spellcheck="false"
              />
              <datalist id="names" />
            </span>
          </label>

          <fieldset class="field">
            <legend>Scope</legend>
            <div class="seg" style="--seg-w: 8.402rem">
              <input type="radio" name="scope" id="c-season" value="season" checked />
              <label for="c-season">Season</label>
              <input type="radio" name="scope" id="c-career" value="career" />
              <label for="c-career">Career</label>
            </div>
          </fieldset>

          <fieldset class="field">
            <legend>Rate</legend>
            <div class="seg" style="--seg-w: 12.766rem">
              {RATES.map((r) => (
                <>
                  <input type="radio" name="rate" id={`r-${r.key}`} value={r.key} checked={r.key === "game"} />
                  <label for={`r-${r.key}`}>{r.label}</label>
                </>
              ))}
            </div>
          </fieldset>
          <p class="count" id="status" aria-live="polite">Up to {MAX} players.</p>
        </form>

        <script is:inline>
          // Opened with players in the link: the table paints once their cards arrive. Until then
          // the empty state keeps its place unseen and a screen tall, so the footer starts below
          // the fold and nothing jumps when the table replaces it (0.096 CLS before).
          if (/[?&]p=[^&]/.test(location.search)) document.documentElement.dataset.picks = "";
        </script>
        <div class="empty" id="empty">
          <p>Add a player by name, or start from one of these:</p>
          {presets.length > 0 && (
            <>
              <ul class="presets" id="presets">
                {presets.map((p, i) => (
                  <li hidden={i > 2}>
                    <a class="ink-link" href={p.href}>
                      {p.label}
                    </a>
                    <span>{p.names}</span>
                  </li>
                ))}
              </ul>
              <script is:inline>
                // Three presets show at random on each visit. Without JS the first three stay visible.
                (() => {
                  const items = [...document.querySelectorAll("#presets > li")];
                  if (items.length < 4) return;
                  items.forEach((li) => (li.hidden = true));
                  for (let shown = 0; shown < 3; ) {
                    const li = items[Math.floor(Math.random() * items.length)];
                    if (li.hidden) (li.hidden = false), shown++;
                  }
                })();
              </script>
            </>
          )}
        </div>

        <div class="scroll busy-fade" id="board" hidden>
          <table class="grid h2h">
            <caption class="sr-only">Players compared measure by measure</caption>
            <thead id="heads" />
          </table>
        </div>
        <p class="note" id="note" hidden>
          Career numbers add up every EuroLeague season since 2007-08.
        </p>
        <Polygon base={base} />
        </div>

        <div id="teams-view" data-seasons={JSON.stringify(teamSeasons)} data-x={x}>
          <form class="filters" id="team-filters" aria-label="Clubs and seasons">
            <label class="field grow">
              <span>Add a club and season</span>
              <span class="search">
                <span class="glass" set:html={plus} />
                <input
                  type="search"
                  id="team-add"
                  list="team-names"
                  placeholder="Type a club"
                  autocomplete="off"
                  spellcheck="false"
                />
                <datalist id="team-names">
                  {teamChoices.map((c) => (
                    <option value={c.text} />
                  ))}
                </datalist>
              </span>
            </label>
            <p class="count" id="team-status" aria-live="polite">Up to {TEAM_MAX} clubs.</p>
          </form>
          <div class="empty" id="team-empty">
            <p>Add a club and season by name. Each club is one season, so the same club can appear twice.</p>
          </div>
          <div class="scroll busy-fade" id="team-board" hidden>
            <table class="grid h2h" id="team-table">
              <caption class="sr-only">Clubs compared measure by measure</caption>
              <thead id="team-heads" />
            </table>
          </div>
          <p class="note" id="team-note" hidden>
            Small figures are the club's place among all clubs that season. Shot shares are of each club's own shots.
          </p>
          <TeamProfile />
        </div>
      </section>
    )
  }
</Base>

<script>
  import { bodyHtml, column, fromQuery, grid, headHtml, MAX, toQuery, type Card, type CRate, type Pick, type Scope } from "../../lib/compare";

  const host = document.getElementById("compare");
  if (host) {
    const cfg = JSON.parse(host.dataset.cfg ?? "{}") as { base: string; xIcon: string };
    const root = cfg.base.replace(/\/$/, "");
    const form = document.getElementById("filters") as HTMLFormElement;
    const input = document.getElementById("add") as HTMLInputElement;
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const cards = new Map<string, Promise<Card | null>>();
    const card = (slug: string) => {
      if (!cards.has(slug)) cards.set(slug, fetch(`${root}/data/cards/${slug}.json`).then((r) => (r.ok ? r.json() : null)));
      return cards.get(slug)!;
    };
    let names: Map<string, string> | null = null;
    const loadNames = async () => {
      if (names) return names;
      const rows = (await fetch(`${root}/data/names.json`).then((r) => r.json())) as [string, string, number, number][];
      const span = (a: number, b: number) => (a === b ? `${a}-${String((a + 1) % 100).padStart(2, "0")}` : `${a} to ${b + 1}`);
      names = new Map(rows.map(([slug, name, a, b]) => [`${name} (${span(a, b)})`, slug]));
      $("names").replaceChildren(...[...names.keys()].map((k) => new Option(k)));
      return names;
    };

    let { picks, scope, rate } = fromQuery(location.search);
    let shown: { slug: string; season: number }[] = [];

    const syncForm = () => {
      (form.elements.namedItem("scope") as RadioNodeList).value = scope;
      (form.elements.namedItem("rate") as RadioNodeList).value = rate;
      const full = picks.length >= MAX;
      input.disabled = full;
      input.placeholder = full ? "Remove one to add more" : "Type a name";
    };

    let pending = 0;
    const paint = async () => {
      const ticket = ++pending;
      host.setAttribute("aria-busy", "true");
      try {
        const loaded = await Promise.all(picks.map((p) => card(p.slug)));
        if (ticket !== pending) return;
        const found = picks.map((p, i) => ({ p, c: loaded[i] })).filter((x): x is { p: Pick; c: Card } => !!x.c);
        const cols = found.map(({ p, c }) => column(c, scope, p.season));
        if (scope === "career") {
          // One career per player.
          const seen = new Set<string>();
          for (let i = cols.length - 1; i >= 0; i--) if (seen.has(cols[i].card.slug)) cols.splice(i, 1);
          else seen.add(cols[i].card.slug);
        }
        picks = cols.map((c) => ({ slug: c.card.slug, season: scope === "season" ? c.season : 0 }));
        const g = grid(cols, rate);
        $("heads").innerHTML = headHtml(cols, scope, cfg.base, cfg.xIcon);
        const table = $("heads").parentElement!;
        table.querySelectorAll("tbody").forEach((t) => t.remove());
        table.insertAdjacentHTML("beforeend", bodyHtml(g, cols));
        table.style.setProperty("--cols", String(cols.length));
        $("board").hidden = cols.length === 0;
        $("note").hidden = cols.length === 0;
        $("empty").hidden = cols.length > 0;
        const missing = found.length < loaded.length ? " A player in the link was not found." : "";
        $("status").textContent =
          (cols.length === 0 ? `Up to ${MAX} players.` : cols.length === 1 ? "Add another player to compare." : `${cols.length} of ${MAX} players.`) + missing;
        // The leader dots arrive where they now belong.
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches && shown.length)
          table.querySelectorAll<HTMLElement>(".lead-dot").forEach((d) => d.animate([{ transform: "scale(0.4)", opacity: 0 }, { transform: "none", opacity: 1 }], { duration: 160, easing: "ease-out" }));
        shown = picks;
        document.dispatchEvent(new CustomEvent("compare:picks", { detail: { scope, picks: cols.map((c) => ({ slug: c.card.slug, season: c.season, name: c.card.name })) } }));
        syncForm();
        history.replaceState(null, "", location.pathname + toQuery(picks, scope, rate));
      } catch {
        $("status").textContent = "Could not load these players. Reload the page to try again.";
      } finally {
        if (ticket === pending) {
          host.removeAttribute("aria-busy");
          delete document.documentElement.dataset.picks;
        }
      }
    };

    const add = async () => {
      const n = await loadNames();
      const slug = n.get(input.value);
      if (!slug || picks.length >= MAX) return;
      const c = await card(slug);
      if (!c) return;
      if (scope === "career" && picks.some((p) => p.slug === slug)) {
        input.value = "";
        return;
      }
      const season = c.seasons[c.seasons.length - 1].season;
      input.value = "";
      // Enter fires both change and submit: the second call finds the pick already made.
      if (picks.some((p) => p.slug === slug && p.season === season)) return;
      picks = [...picks, { slug, season }];
      await paint();
      input.focus();
    };

    input.addEventListener("focus", () => void loadNames(), { once: true });
    input.addEventListener("change", add);
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      add();
    });
    form.addEventListener("input", (e) => {
      const el = e.target as HTMLInputElement;
      if (el.name === "scope") scope = el.value as Scope;
      else if (el.name === "rate") rate = el.value as CRate;
      else return;
      paint();
    });
    $("board").addEventListener("change", (e) => {
      const el = e.target as HTMLSelectElement;
      if (el.dataset.col === undefined) return;
      const i = Number(el.dataset.col);
      picks = picks.map((p, j) => (j === i ? { ...p, season: Number(el.value) } : p));
      paint().then(() => ($("board").querySelector(`select[data-col="${i}"]`) as HTMLElement | null)?.focus());
    });
    $("board").addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>("button[data-drop]");
      if (!b) return;
      picks = picks.filter((_, j) => j !== Number(b.dataset.drop));
      paint().then(() => input.focus());
    });

    syncForm();
    if (picks.length) paint();
    else delete document.documentElement.dataset.picks;
  }
</script>

<script>
  import { POLYGON_AXES, TEAM_MAX, teamBodyHtml, teamColumns, teamDescription, teamHeadHtml, teamOptions, teamSeries, teamsFromQuery, teamsToQuery, type TeamPick, type TeamSeasonRows } from "../../lib/compare_teams";
  import { profileSvg } from "../../lib/polygon";

  const root = document.getElementById("teams-view");
  const cfg = root ? (JSON.parse(root.dataset.seasons ?? "[]") as TeamSeasonRows[]) : [];
  const parsed = teamsFromQuery(location.search, (code, season) => cfg.some((s) => s.season === season && s.rows.some((r) => r.code === code)));
  if (root && parsed.mode === "teams") {
    const $ = (id: string) => document.getElementById(id) as HTMLElement;
    const input = $("team-add") as HTMLInputElement;
    const choices = new Map(teamOptions(cfg).map((o) => [o.text, o.pick]));
    let picks: TeamPick[] = parsed.picks;

    const paint = () => {
      const cols = teamColumns(picks, cfg);
      picks = cols.map((c) => ({ code: c.code, season: c.season }));
      const table = $("team-table");
      $("team-heads").innerHTML = teamHeadHtml(cols, root.dataset.x ?? "");
      table.querySelectorAll("tbody").forEach((t) => t.remove());
      table.insertAdjacentHTML("beforeend", teamBodyHtml(cols));
      table.style.setProperty("--cols", String(cols.length));
      const series = teamSeries(cols);
      $("team-figure").innerHTML = profileSvg(POLYGON_AXES, series, "Percentile profile, club-seasons", teamDescription(cols), "team-profile-svg");
      $("team-legend").replaceChildren(
        ...series.map((s) => {
          const li = document.createElement("li");
          const sw = document.createElement("i");
          sw.className = "swatch";
          sw.style.background = `var(--series-${s.slot})`;
          sw.setAttribute("aria-hidden", "true");
          const name = document.createElement("span");
          name.className = "series-name";
          name.textContent = s.name;
          const text = document.createElement("span");
          text.className = "series-text";
          text.textContent =
            s.profile.note ?? s.profile.axes.map((a, j) => `${POLYGON_AXES[j].head} ${a.pct === null ? "–" : Math.round(a.pct)}`).join(", ");
          li.append(sw, name, text);
          return li;
        }),
      );
      const full = picks.length >= TEAM_MAX;
      input.disabled = full;
      input.placeholder = full ? "Remove one to add more" : "Type a club";
      $("team-board").hidden = !cols.length;
      $("team-note").hidden = !cols.length;
      $("team-profile").hidden = !cols.length;
      $("team-empty").hidden = cols.length > 0;
      $("team-status").textContent =
        cols.length === 0 ? `Up to ${TEAM_MAX} clubs.` : cols.length === 1 ? "Add another club to compare." : `${cols.length} of ${TEAM_MAX} clubs.`;
      history.replaceState(null, "", location.pathname + teamsToQuery(picks));
    };

    const add = () => {
      const pick = choices.get(input.value);
      input.value = "";
      if (!pick || picks.length >= TEAM_MAX || picks.some((p) => p.code === pick.code && p.season === pick.season)) return;
      picks = [...picks, pick];
      paint();
      input.focus();
    };
    input.addEventListener("change", add);
    $("team-filters").addEventListener("submit", (e) => {
      e.preventDefault();
      add();
    });
    $("team-board").addEventListener("click", (e) => {
      const b = (e.target as Element).closest<HTMLButtonElement>("button[data-drop]");
      if (!b) return;
      picks = picks.filter((_, j) => j !== Number(b.dataset.drop));
      paint();
      input.focus();
    });
    paint();
  }
</script>

<style>
  .head p {
    margin-top: 10px;
    max-width: 64ch;
    color: var(--ink-2);
  }
  .filters {
    margin: 32px 0 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }
  [hidden] {
    display: none !important;
  }
  .grow {
    flex: 1 1 200px;
    max-width: 340px;
  }
  .search {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search :global(svg) {
    position: absolute;
    top: 50%;
    left: 10px;
    transform: translateY(-50%);
    width: 15px;
    height: 15px;
    fill: var(--ink-2);
    pointer-events: none;
  }
  input[type="search"] {
    appearance: none;
    width: 100%;
    height: 32px;
    padding: 0 10px 0 32px;
    border: 0;
    border-radius: 8px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    color: var(--ink);
    font: 500 0.8125rem/1 var(--font);
    transition: box-shadow 150ms ease;
  }
  input[type="search"]::placeholder {
    color: var(--muted);
  }
  input[type="search"]::-webkit-search-cancel-button {
    display: none;
  }
  input[type="search"]:disabled {
    background: var(--sunk);
    box-shadow: inset 0 0 0 1px var(--rule);
    cursor: not-allowed;
  }
  @media (hover: hover) and (pointer: fine) {
    input[type="search"]:not(:disabled):hover {
      box-shadow: inset 0 0 0 1px var(--ink-2);
    }
  }
  input[type="search"]:focus-visible {
    outline: 2px solid var(--data-1);
    outline-offset: 1px;
  }
  .count {
    min-width: 5.782rem; /* "Up to 5 players." in Geist, so the swap never drops it to a new row */
    text-align: right;
    margin-left: auto;
    align-self: flex-end;
    line-height: 32px; /* on the controls' row, not between their labels and them */
    color: var(--muted);
    font-size: 0.8125rem;
  }

  :global(html[data-picks]) .empty {
    visibility: hidden;
    min-height: 100dvh;
  }
  .empty {
    color: var(--ink-2);
  }
  .empty ul {
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .empty li {
    display: grid;
    gap: 2px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }
  .empty li span {
    color: var(--muted);
    font-size: 0.8125rem;
  }

  /* Mode: one view at a time. The page marks data-mode on <html> before the views paint (inline script). */
  .mode-teams {
    display: none;
  }
  .mode-switch {
    display: inline-flex;
    gap: 2px;
    margin-top: 18px;
    padding: 2px;
    border-radius: 9px;
    background: var(--sunk);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  .mode-switch a {
    padding: 6px 16px;
    border-radius: 7px;
    color: var(--ink-2);
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
  }
  .mode-switch a[aria-current="page"] {
    background: var(--page);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }
  .mode-switch a:focus-visible {
    outline: 2px solid var(--data-1);
    outline-offset: 1px;
  }
  :global(html[data-mode="teams"]) .mode-players {
    display: none;
  }
  :global(html[data-mode="teams"]) .mode-teams {
    display: block;
  }
  :global(html[data-mode="teams"]) #players-view {
    display: none;
  }
  #teams-view {
    display: none;
  }
  :global(html[data-mode="teams"]) #teams-view {
    display: block;
  }
  #teams-view .filters {
    margin-top: 32px;
  }
  .h2h :global(th.card .tcode) {
    display: block;
    color: var(--ink);
    font-size: 1.125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  /* The grid: measure names stick on the left; each player owns an equal column. */
  .h2h {
    table-layout: fixed;
    width: 100%;
    min-width: calc(8.5rem + var(--cols, 2) * 9rem);
  }
  .h2h :global(td.corner),
  .h2h :global(tbody th) {
    width: 8.5rem;
  }
  .h2h :global(thead th.card) {
    position: relative;
    padding: 0 8px 14px;
    text-align: center;
    vertical-align: bottom;
    border-bottom: 1px solid var(--rule-strong);
    font-weight: 400;
  }
  .h2h :global(thead td.corner) {
    border-bottom: 1px solid var(--rule-strong);
  }
  .h2h :global(th.card svg.shirt) {
    display: block;
    margin: 0 auto 8px;
  }
  .h2h :global(.shirt-edge) {
    stroke: var(--rule-strong);
    stroke-width: 1.2;
  }
  .h2h :global(svg.shirt text) {
    font-family: var(--font);
  }
  .h2h :global(th.card .nm) {
    display: block;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
