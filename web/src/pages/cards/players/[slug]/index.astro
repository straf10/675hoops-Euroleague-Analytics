---
// A player's share card as a page (so its use can be counted): /cards/players/{slug}/ shows the PNG
// from /cards/players/{slug}.png. Only the live season's players have one (lib/cards/players.ts).
import Base from "../../../../layouts/Base.astro";
import { currentPlayers } from "../../../../lib/cards/players";
import "../../../../styles/stats.css";

export async function getStaticPaths() {
  return (await currentPlayers()).map((p) => ({ params: { slug: p.slug }, props: { name: p.name } }));
}

const { slug } = Astro.params;
const { name } = Astro.props as { name: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const src = `${base}/cards/players/${slug}.png`;
const title = `${name} share card`;
const description = `${name}'s share card for the live EuroLeague season.`;
---

<Base title={title} description={description} current="players" noindex>
  <header class="wrap head">
    <h1>{title}</h1>
    <p class="lede">
      The card as a 1080 x 1350 PNG. <a href={`${base}/players/${slug}/`}>Back to {name}</a>.
    </p>
  </header>
  <section class="wrap band">
    <figure class="card-figure">
      <img src={src} width="1080" height="1350" alt={`${name}: the live-season card with projection, shot chart and comparable players.`} />
      <figcaption><a href={src} download>Download PNG</a></figcaption>
    </figure>
  </section>
</Base>

<style>
  .card-figure {
    margin: 0;
  }
  .card-figure img {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .card-figure figcaption {
    margin-top: 0.75rem;
  }
</style>
