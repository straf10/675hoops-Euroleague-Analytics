---
// A round's share cards as a page (so their use can be counted): /cards/round-{n}/ shows the PNGs
// from /cards/round-{n}.png (the open round's card, while it is open) and /cards/round-{n}-recap.png
// (the recap, once it is finished), where they exist.
import Base from "../../../layouts/Base.astro";
import CardFigure from "../../../components/CardFigure.astro";
import { euroleague, roundCardNames } from "../../../lib/cards/site";
import "../../../styles/stats.css";

export function getStaticPaths() {
  const c = euroleague();
  if (!c) return [];
  const names = roundCardNames(c);
  const rounds = [...new Set(names.map((r) => r.round))];
  return rounds.map((round) => ({
    params: { n: String(round) },
    props: { round, cards: names.filter((r) => r.round === round) },
  }));
}

const { round, cards } = Astro.props as {
  round: number;
  cards: { name: string; kind: "open" | "recap" }[];
};
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = `Round ${round} share card`;
const description = `Share cards for round ${round} of the EuroLeague season: the forecasts and the recap.`;
const alt = {
  open: `EuroLeague round ${round}: forecasts for each game, with the results so far.`,
  recap: `EuroLeague round ${round} recap: results and scoring, game by game.`,
};
---

<Base title={title} description={description} current="forecasts" noindex>
  <header class="wrap head">
    <h1>{title}</h1>
    <p class="lede">
      Each card as a 1080 x 1350 PNG. <a href={`${base}/forecasts/`}>Back to Forecasts</a>.
    </p>
  </header>
  {
    cards.map((card) => (
      <section class="wrap band">
        <CardFigure path={`${base}/cards/${card.name}`} alt={alt[card.kind]} width={1080} height={1350} />
      </section>
    ))
  }
</Base>
