---
import Base from "../../layouts/Base.astro";
import ForecastRecord from "../../components/ForecastRecord.astro";
import "../../styles/stats.css";
import raw from "../../data/site.json";
import type { SiteData } from "../../lib/format";

import { openRoundCards, recapCards } from "../../lib/cards/site";

const data = raw as SiteData;
const description =
  "The season's forecast record, round by round and game by game.";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// Share-card links: each open round's card (earliest first) and the latest finished round's recap,
// each on its own HTML page (/cards/round-{n}/), where the PNG is shown and downloaded.
const shareLinks = (c: SiteData["competitions"][number]) => {
  const open = openRoundCards(c);
  const recap = recapCards(c).at(-1);
  return { open, recap };
};
---

<Base title="Forecast record" description={description} current="forecasts">
  <header class="wrap head">
    <h1>Forecast record</h1>
    <p class="lede">
      Every forecast this season is logged before tip-off, then scored against the results and a home-win baseline.
    </p>
  </header>

  {
    data.competitions.map((c) => (
      <section class="wrap band" aria-labelledby={`rec-${c.key}`}>
        <header class="sec-head">
          <h2 id={`rec-${c.key}`}>{c.title}</h2>
        </header>
        <ForecastRecord comp={c} />
        {
          (() => {
            const s = shareLinks(c);
            if (!s.open.length && !s.recap) return null;
            return (
              <p class="note">
                Share cards:{" "}
                {s.open.map((r, i) => (
                  <>
                    {i > 0 && ", "}
                    <a href={`${base}/cards/round-${r.round}/`}>Round {r.round} card</a>
                  </>
                ))}
                {s.open.length > 0 && s.recap && ", "}
                {s.recap && <a href={`${base}/cards/round-${s.recap.round}/`}>Round {s.recap.round} recap</a>}
              </p>
            );
          })()
        }
      </section>
    ))
  }
</Base>
