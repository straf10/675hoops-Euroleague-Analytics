---
import Base from "../../layouts/Base.astro";
import { FIRST_OVERVIEW_SEASON, SCOPES, boards, entries } from "../../lib/leaders";
import { boardsHtml } from "../../lib/leaders_html";
import { defaultSeason, leaderPool, meta } from "../../lib/stats";
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import "../../styles/stats.css";

const m = await meta();
const base = import.meta.env.BASE_URL;
// The overview offers 2022-23 on: the live season (once it has a sample) or the last full one opens.
const seasons = m ? [...m.seasons].reverse().filter((s) => s.season >= FIRST_OVERVIEW_SEASON) : [];
const first = m ? defaultSeason(m) : null;
const start = first && seasons.some((s) => s.season === first.season) ? first.season : (seasons[0]?.season ?? 0);
const pool = seasons.length ? await leaderPool(start) : null;
const board = pool ? boards(entries(pool), pool.most, false) : null;
const cfg = { base, defaultSeason: start, seasons: seasons.map((s) => s.season) };
const description =
  "The EuroLeague's leaders on sixteen boards: points, rebounds, efficiency and more, for one season or for careers since 2007-08. Each board links to its full list on the Players page.";
---

<Base title="Leaders" description={description} current="leaders">
  <section class="wrap head" aria-labelledby="leaders-title">
    <h1 id="leaders-title">Leaders</h1>
    <p>The league's best on sixteen boards. Pick a season, or switch to careers. Each board's full list is on the Players page.</p>
  </section>

  {
    !m || !pool || !board ? (
      <section class="wrap">
        <p class="empty-state">Stats are not available yet.</p>
      </section>
    ) : (
      <section class="wrap" id="leaders" data-cfg={JSON.stringify(cfg)}>
        <form class="filters" id="filters" aria-label="Filters">
          <fieldset class="field">
            <legend>Scope</legend>
            <div class="seg" style="--seg-w: 14.891rem">
              {SCOPES.map((s) => (
                <>
                  <input type="radio" name="scope" id={`s-${s.key}`} value={s.key} checked={s.key === "season"} />
                  <label for={`s-${s.key}`}>{s.label}</label>
                </>
              ))}
            </div>
          </fieldset>

          <label class="field" id="season-field">
            <span>Season</span>
            <span class="select">
              <select name="season" style="--select-w: 7.875rem">
                {seasons.map((s) => (
                  <option value={s.season} selected={s.season === start}>
                    {s.label}
                  </option>
                ))}
              </select>
              <span class="caret" set:html={caret} />
            </span>
          </label>
        </form>

        <div class="boards busy-fade" id="boards" set:html={boardsHtml(board, base, start, false)} />
        <p class="board-error" id="boards-error" hidden></p>
      </section>
    )
  }
</Base>

<script>
  import { boards, entries, type Pool } from "../../lib/leaders";
  import { boardsHtml } from "../../lib/leaders_html";

  const host = document.getElementById("leaders");
  if (host) {
    const cfg = JSON.parse(host.dataset.cfg ?? "{}") as { base: string; defaultSeason: number; seasons: number[] };
    const root = cfg.base.replace(/\/$/, "");
    const form = document.getElementById("filters") as HTMLFormElement;
    const seasonField = document.getElementById("season-field") as HTMLElement;
    const boardsEl = document.getElementById("boards") as HTMLElement;
    const errorEl = document.getElementById("boards-error") as HTMLElement;
    const cache = new Map<string, Promise<Pool>>();
    const load = (path: string) => {
      if (!cache.has(path)) {
        cache.set(
          path,
          fetch(`${root}/data/leaders/${path}.json`).then((r) => {
            if (!r.ok) throw new Error(`${path}: ${r.status}`);
            return r.json();
          }),
        );
      }
      return cache.get(path)!;
    };

    // The URL carries the scope and season, so a reload or a shared link opens the same board.
    const params = new URLSearchParams(location.search);
    let career = params.get("scope") === "career";
    const asked = Number(params.get("season"));
    let season = cfg.seasons.includes(asked) ? asked : cfg.defaultSeason;
    (form.elements.namedItem("scope") as RadioNodeList).value = career ? "career" : "season";
    (form.elements.namedItem("season") as HTMLSelectElement).value = String(season);
    seasonField.hidden = career;

    let pending = 0;
    const update = async () => {
      const ticket = ++pending;
      host.setAttribute("aria-busy", "true");
      try {
        const pool = await load(career ? "career" : String(season));
        if (ticket !== pending) return;
        boardsEl.innerHTML = boardsHtml(boards(entries(pool), pool.most, career), cfg.base, season, career);
        errorEl.hidden = true;
        history.replaceState(null, "", `${location.pathname}?${career ? "scope=career" : `season=${season}`}`);
      } catch {
        if (ticket === pending) {
          errorEl.textContent = "Could not load these boards. Reload the page to try again.";
          errorEl.hidden = false;
        }
      } finally {
        if (ticket === pending) host.removeAttribute("aria-busy");
      }
    };

    host.addEventListener("input", (e) => {
      const el = e.target as HTMLInputElement | HTMLSelectElement;
      if (el.form !== form) return;
      if (el.name === "scope") {
        career = el.value === "career";
        seasonField.hidden = career;
      }
      if (el.name === "season") season = Number(el.value);
      update();
    });
    form.addEventListener("submit", (e) => e.preventDefault());
  }
</script>

<style>
  .head p {
    margin-top: 10px;
    max-width: 64ch;
    color: var(--ink-2);
  }
  .filters {
    margin: 32px 0 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }
  [hidden] {
    display: none !important;
  }
  .board-error {
    margin-top: 16px;
    color: var(--muted);
  }

  /* The overview: one card per board, three or four across on a wide screen, one per row on a phone. */
  .boards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 28px 24px;
    align-items: start;
  }
  .boards :global(.board) {
    min-width: 0;
    padding-top: 12px;
    border-top: 1px solid var(--rule-strong);
  }
  .boards :global(h2) {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .boards :global(.lead) {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
  }
  .boards :global(.shirt-link) {
    display: block;
    width: 40px;
  }
  .boards :global(.shirt-link svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  .boards :global(.who) {
    display: grid;
    min-width: 0;
    line-height: 1.25;
  }
  .boards :global(.who a) {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .boards :global(.who small),
  .boards :global(.nm small) {
    color: var(--muted);
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
  }
  .boards :global(.val) {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .boards :global(.lead .val) {
    text-align: right;
  }
  .boards :global(.none) {
    margin: 12px 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .boards :global(.rest) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .boards :global(.rest li) {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 8px;
    padding: 6px 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.8125rem;
  }
  .boards :global(.rk) {
    color: var(--muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .boards :global(.nm) {
    display: flex;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
  }
  .boards :global(.nm a) {
    min-width: 0;
    color: var(--ink);
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .boards :global(.rest .val) {
    font-size: 0.875rem;
  }
  .boards :global(footer) {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .boards :global(footer a) {
    color: var(--ink-2);
  }
  @media (max-width: 620px) {
    .boards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
