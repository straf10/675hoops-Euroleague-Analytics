---
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import up from "@phosphor-icons/core/assets/fill/caret-up-fill.svg?raw";
import down from "@phosphor-icons/core/assets/fill/caret-down-fill.svg?raw";
import Base from "../../layouts/Base.astro";
import "../../styles/stats.css";
import { SEASON_COLS } from "../../lib/player";
import { clubShots, defaultSeason, meta, teamIndex, teamSeason, type TeamIndexRow } from "../../lib/stats";
import { DEFENSE, OFFENSE, factorRowHtml, factorRows, headCells, rosterHtml, teamBands, teamCharts } from "../../lib/team";
import { sourceCode, teamFactors } from "../../lib/live";
import { tip } from "../../lib/tip";
import InfoTip from "../../components/InfoTip.astro";
import Continuity from "../../components/team/Continuity.astro";
import Passing from "../../components/team/Passing.astro";
import { FULL, peakShots, shotPair, teamColour } from "../../lib/heat";
import { GROUPS, colsHtml } from "../../lib/cols";
import { markChart } from "../../lib/shotmarks";
import { ZONES, zoneRowsHtml, type ClubShots } from "../../lib/zones";
import JsonLd from "../../components/JsonLd.astro";
import ScheduleStrength from "../../components/team/ScheduleStrength.astro";
import { hasSchedule } from "../../lib/strength";
import { sportsTeam } from "../../lib/jsonld";
import { clubLineups } from "../../lib/stats";
import Lineups from "../../components/team/Lineups.astro";

export async function getStaticPaths() {
  // A club gets a page only when it has a published season (teamIndex keeps published seasons only).
  return (await teamIndex()).map((t) => ({ params: { code: t.code.toLowerCase() }, props: { club: t } }));
}

const { club } = Astro.props as { club: TeamIndexRow };
const m = (await meta())!;
const open = defaultSeason(m).season;
const year = [...club.seasons].reverse().find((s) => s <= open) ?? club.seasons[club.seasons.length - 1];
const t = (await teamSeason(club.code, year))!;
const lineups = await clubLineups(club.code);
// The club's orange details take its make colour, the same as the players' shot charts.
const pair = shotPair(club.code);
const accentStyle = `--data-1: ${pair.make}; --data-1-wash: color-mix(in srgb, ${pair.make} 12%, transparent); --make: ${pair.make}; --miss: ${pair.miss}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const radius = m.hex_radius_m;
const head = headCells(t);
const charts = teamCharts(t, radius);
const bands = teamBands(t, up, down);
const labels = new Map(m.seasons.map((s) => [s.season, s.label]));
const description = `${club.name}: EuroLeague record, ratings, four factors, shot charts and roster.`;
const abs = (path: string) => new URL(path, Astro.site ?? "https://675hoops.com").href;
// Schedule strength comes from the API's live-season file, keyed by source code.
const factors = await teamFactors("euroleague", sourceCode("euroleague", club.code));
const liveSeason = factors?.season ?? m.seasons.find((s) => s.live)?.season ?? open;
const schedule = factors?.schedule_strength;
// The live season's shots are inlined; any other season is fetched when the visitor picks it.
const liveShots: ClubShots | null = club.seasons.includes(liveSeason) ? await clubShots(club.code, liveSeason) : null;
// When the page opens on the live season, its chart is drawn here too, so it shows without JavaScript.
const preShots = liveShots && t.season === liveShots.season ? liveShots : null;
const shotLabel = `${t.name}: shots taken, ${t.season}`;
const bandHead = [
  ["Shots", ""],
  ["Share", ""],
  ["League", "League share of attempts from this distance"],
  ["FG%", ""],
  ["League", "League FG% from this distance"],
  ["Diff", "FG% minus the league's, in points, from 10 attempts up"],
];
---

<Base title={club.name} description={description} current="teams">
  <JsonLd
    slot="head"
    data={sportsTeam({
      name: t.name,
      url: abs(`${base}/teams/${club.code.toLowerCase()}/`),
      athletes: t.roster
        .filter((p) => p.slug)
        .map((p) => ({ name: p.name, url: abs(`${base}/players/${p.slug}/`) })),
    })}
  />
  <div class="accented" style={accentStyle}>
  <script is:inline define:vars={{ shown: String(t.season) }}>
    // Tabs need JavaScript; without it every panel shows, stacked.
    document.documentElement.classList.add("js");
    // A link to another season: hide the season's numbers until they arrive, so they never flash.
    const asked = new URLSearchParams(location.search).get("season");
    if (asked && asked !== shown) document.documentElement.classList.add("season-pending");
  </script>
  <header
    class="wrap head team-head"
    id="team"
    data-code={t.code.toLowerCase()}
    data-base={base}
    data-radius={radius}
    data-year={t.season}
  >
    <div>
      <h1 id="t-name">{t.name}</h1>
    </div>
    {
      club.seasons.length > 1 && (
        <label class="field">
          <span>Season</span>
          <span class="select">
            <select id="season" aria-controls="cells ranks roster shots attempts-court">
              {[...club.seasons].reverse().map((s) => (
                <option value={s} selected={s === t.season}>
                  {labels.get(s) ?? s}
                </option>
              ))}
            </select>
            <span class="caret" set:html={caret} />
          </span>
        </label>
      )
    }
  </header>

  <div class="wrap">
    <nav class="tabs" aria-label="Team sections">
      <div role="tablist" aria-label="Team sections" class="tablist">
        <button type="button" role="tab" id="tab-overview" data-tab="overview" aria-controls="panel-overview" aria-selected="true" tabindex="0">Overview</button>
        <button type="button" role="tab" id="tab-shots" data-tab="shots" aria-controls="panel-shots" aria-selected="false" tabindex="-1">Shots</button>
        <button type="button" role="tab" id="tab-lineups" data-tab="lineups" aria-controls="panel-lineups" aria-selected="false" tabindex="-1">Lineups</button>
        <button type="button" role="tab" id="tab-passing" data-tab="passing" aria-controls="panel-passing" aria-selected="false" tabindex="-1">Passing</button>
        {
          hasSchedule(schedule) && (
            <button
              type="button"
              role="tab"
              id="tab-schedule"
              data-tab="schedule"
              data-season={liveSeason}
              aria-controls="panel-schedule"
              aria-selected="false"
              tabindex="-1"
              hidden={t.season !== liveSeason}
            >
              Schedule
            </button>
          )
        }
      </div>
    </nav>
  </div>

  <div class="wrap tabpanel" role="tabpanel" id="panel-overview" aria-labelledby="tab-overview">
    <dl class="cells seasonal" id="cells">
      <div class="cell">
        <dt>Record</dt>
        <dd id="c-record" set:html={head.record} />
      </div>
      <div class="cell">
        <dt>
          <span data-tip={tip`<b>Net rating</b><br>Points scored minus points allowed per 100 possessions. Its sign is the comparison with the league average, which is 0.`} tabindex="0">Net rating</span>
        </dt>
        <dd id="c-net" set:html={head.net} />
        <dd class="sub" id="c-net-sub">{head.netSub}</dd>
      </div>
      <div class="cell">
        <dt>
          <span data-tip={tip`<b>Pace</b><br>Possessions per 40 minutes, both teams averaged`} tabindex="0">Pace</span>
        </dt>
        <dd id="c-pace">{head.pace}</dd>
        <dd class="sub" id="c-pace-sub">{head.paceSub}</dd>
      </div>
      <div class="cell">
        <dt>EuroLeague seasons</dt>
        <dd id="c-seasons">{head.seasons}</dd>
        <dd class="sub" id="c-seasons-sub">{head.seasonsSub}</dd>
      </div>
      <div class="cell">
        <dt>
          <span data-tip={tip`<b>League rank</b><br>Regular-season standings position; 1 is the top`} tabindex="0">League rank</span>
        </dt>
        <dd id="c-rank" set:html={head.rank} />
      </div>
      <div class="cell">
        <dt>Playoffs</dt>
        <dd id="c-playoff">{head.playoff}</dd>
        <dd class="sub" id="c-playoff-sub">{head.playoffSub}</dd>
      </div>
    </dl>
    <Continuity continuity={t.continuity} />

  <section class="band" id="ranks" aria-labelledby="ranks-title">
    <header class="sec-head">
      <h2 id="ranks-title">Where they rank</h2>
      <p class="ff-key">
        <span>Right is better on every row.</span>
        <span><i class="k-me" aria-hidden="true"></i><span id="t-code">{t.code}</span></span>
        <span><i class="k-avg" aria-hidden="true"></i>League average</span>
        <span><i class="k-med" aria-hidden="true"></i>League median<InfoTip text={tip`<b>League median</b><br>The middle club: half the league is above it and half below. Unlike the average, one extreme club can't pull it up or down.`} /></span>
      </p>
    </header>
    <div class="ranks busy-fade seasonal">
      <div class="side" id="offense" role="group" aria-labelledby="h-offense">
        <h3 id="h-offense">Offense</h3>
        <div class="ff-cols" aria-hidden="true"><span>Club</span><span>Rank</span><span>vs league</span></div>
        <Fragment set:html={factorRows(t, OFFENSE).map(factorRowHtml).join("")} />
      </div>
      <div class="side" id="defense" role="group" aria-labelledby="h-defense">
        <h3 id="h-defense">Defense</h3>
        <div class="ff-cols" aria-hidden="true"><span>Club</span><span>Rank</span><span>vs league</span></div>
        <Fragment set:html={factorRows(t, DEFENSE).map(factorRowHtml).join("")} />
      </div>
    </div>
    <p class="note">Ranks count from the best. The arrow compares with the league average.</p>
  </section>

  <section class="band" id="roster" aria-labelledby="roster-title">
    <header class="sec-head">
      <h2 id="roster-title">Roster</h2>
      <p>Everyone who played for the club that season, by minutes. Per game, for this club only.</p>
    </header>
    <Fragment set:html={colsHtml("rc", GROUPS.line)} />
    <div class="scroll busy-fade seasonal">
      <table class="grid roster">
        <thead>
          <tr>
            <th scope="col" class="num">#</th>
            <th scope="col">Player</th>
            {SEASON_COLS.map((c) => (
              <th scope="col" class="num">
                <span data-tip={tip`<b>${c.head}</b><br>${c.about}`} tabindex="0">{c.head}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody id="roster-body" set:html={rosterHtml(t, base)} />
      </table>
    </div>
  </section>
  </div>

  <div class="wrap tabpanel" role="tabpanel" id="panel-shots" aria-labelledby="tab-shots">
  <!-- Heavy markup (two courts of heat squares per side). With JavaScript, a noscript is raw text: no elements are built
       until the tab is first needed. Without it, the markup shows as usual. -->
  <noscript id="tpl-shots">
  <section class="band" id="attempts" aria-labelledby="attempts-title">
    <header class="sec-head split">
      <div>
        <h2 id="attempts-title">Shot attempts</h2>
        <p>Every shot the club took, or every shot taken against it, by where it was taken. Filled circles are makes, crosses misses.</p>
      </div>
      <div class="controls">
        <fieldset class="seg" aria-label="Shots taken or allowed" style="--seg-w:14rem">
          <input type="radio" name="attempts-side" id="as-taken" value="taken" checked />
          <label for="as-taken">Taken</label>
          <input type="radio" name="attempts-side" id="as-allowed" value="allowed" />
          <label for="as-allowed">Allowed</label>
        </fieldset>
      </div>
    </header>
    <div class="chips" role="group" aria-label="Shot zones">
      <button type="button" class="chip" data-zone="" aria-pressed="true">All</button>
      {ZONES.map(([zone, label]) => (
        <button type="button" class="chip" data-zone={zone} aria-pressed="false">
          {label}
        </button>
      ))}
    </div>
    <div class="attempts">
      <figure class="chart-box">
        <div id="attempts-court" set:html={preShots ? markChart(preShots.taken, shotLabel) : ""} />
      </figure>
      <div>
        <div class="scroll">
          <table class="grid zones">
            <caption class="sr-only">Shots by zone: attempts, field-goal percentage, share, points per shot and the league's field-goal percentage in the same zone</caption>
            <thead>
              <tr>
                <th scope="col">Zone</th>
                <th scope="col" class="num">FGA</th>
                <th scope="col" class="num">FG%</th>
                <th scope="col" class="num">Share</th>
                <th scope="col" class="num">Pts/shot</th>
                <th scope="col" class="num">
                  <span data-tip={tip`<b>vs league</b><br>The club's FG% in the zone minus the league's, in points.`} tabindex="0">vs league</span>
                </th>
              </tr>
            </thead>
            <tbody id="zone-body" set:html={preShots ? zoneRowsHtml(preShots, "taken", new Set()) : ""} />
          </table>
        </div>
      </div>
    </div>
    <p class="note" id="attempts-note">{preShots ? "" : "The shots for this season load with JavaScript."}</p>
  </section>

  <section class="band" id="shots" aria-labelledby="shots-title">
    <header class="sec-head split">
      <div>
        <h2 id="shots-title">Shots taken and allowed</h2>
        <p>Where the club shot from and where it let opponents shoot, and how the shots scored against the league from the same spot.</p>
      </div>
      <div class="controls">
        <fieldset class="seg" aria-label="Shot view" style="--seg-w:14rem">
          <input type="radio" name="team-shot-view" id="tv-freq" value="freq" checked />
          <label for="tv-freq" data-tip="Shaded by how often the club shot from each spot">Frequency</label>
          <input type="radio" name="team-shot-view" id="tv-quality" value="quality" />
          <label for="tv-quality" data-tip="Points per shot above or below the league's from each spot">Shot making</label>
        </fieldset>
      </div>
    </header>
    <div class="pair busy-fade seasonal">
      {
        (["taken", "allowed"] as const).map((side) => (
          <div class="half">
            <figure class="chart-box" style={`--team: ${teamColour(t.code)}`}>
              <figcaption class="half-title">
                <h3>{side === "taken" ? "Taken" : "Allowed"}</h3>
              </figcaption>
              <div id={`court-${side}`} class="v-freq" set:html={charts.freq[side]} />
              <div id={`court-${side}-q`} class="v-quality" set:html={charts.quality[side]} />
              <p class="key v-freq">
                <span class="scale">
                  <span>FEWER</span>
                  <span class="ramp freq" aria-hidden="true" />
                  <span>MORE</span>
                </span>
                <span>
                  up to <b data-peak={side}>{peakShots(t[side], radius)}</b> per area
                </span>
              </p>
              <p class="key v-quality">
                <span class="scale">
                  <span>-{FULL.toFixed(1)}</span>
                  <span class="ramp quality" aria-hidden="true" />
                  <span>+{FULL.toFixed(1)}</span>
                </span>
                <span>
                  {side === "taken"
                    ? "Points per shot against the league's from the same spot: red-orange below, teal above"
                    : "Opponents' points per shot against the league's from the same spot: red-orange below, teal above"}
                </span>
              </p>
              <p class="note" data-zone-line={side} hidden></p>
            </figure>
            <div>
              <Fragment set:html={colsHtml(`bc-${side}`, GROUPS.bands)} />
              <div class="scroll">
                <table class="grid bands">
                  <caption class="sr-only">
                    {side === "taken" ? "Shots taken" : "Shots allowed"} by distance against the league
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Distance</th>
                      {bandHead.map(([h, about]) => (
                        <th scope="col" class="num">
                          {about ? (
                            <span data-tip={tip`${about}`} tabindex="0">
                              {h}
                            </span>
                          ) : (
                            h
                          )}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody id={`bands-${side}`} set:html={bands[side]} />
                </table>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <p class="note">
      An orange caret on Allowed means opponents shot worse than the league from that distance.
    </p>
  </section>
  </noscript>
  </div>

  <div class="wrap tabpanel" role="tabpanel" id="panel-lineups" aria-labelledby="tab-lineups">
    <Lineups season={t.season} seasons={lineups.seasons} names={lineups.names} />
  </div>

  <Passing code={club.code} season={t.season} roster={t.roster} fields={t.rosterFields} />
  {
    hasSchedule(schedule) && (
      <div class="wrap tabpanel" role="tabpanel" id="panel-schedule" aria-labelledby="tab-schedule" hidden={t.season !== liveSeason}>
        <section class="band" id="schedule" aria-labelledby="schedule-title" data-season={liveSeason}>
          <header class="sec-head">
            <h2 id="schedule-title">Schedule strength</h2>
            <p>Opponent strength for the games played, the games left and the next few.</p>
          </header>
          <ScheduleStrength strength={schedule} />
        </section>
      </div>
    )
  }
  </div>
  {
    liveShots && (
      <script type="application/json" id="attempts-live" set:html={JSON.stringify(liveShots)} />
    )
  }
</Base>

<script>
  import up from "@phosphor-icons/core/assets/fill/caret-up-fill.svg?raw";
  import down from "@phosphor-icons/core/assets/fill/caret-down-fill.svg?raw";
  import type { SeasonShared, TeamOwn, TeamSeason } from "../../lib/stats";
  import { DEFENSE, OFFENSE, factorRows, headCells, patchFactorRow, rosterHtml, teamBands, teamCharts } from "../../lib/team";
  import { peakShots } from "../../lib/heat";
  import { markChart } from "../../lib/shotmarks";
  import { BAND_LABELS } from "../../lib/player";
  import { bandDimmed, sideDots, zoneLineText, zoneLit, zoneRowsHtml, type ClubShots, type ClubSide, type Zone } from "../../lib/zones";

  const head = document.getElementById("team");
  if (head) {
    const select = document.getElementById("season") as HTMLSelectElement | null;
    const { code, base, radius, year } = head.dataset;
    const root = document.documentElement;
    const fetchJson = <T,>(url: string): Promise<T> =>
      fetch(url).then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      });
    const cache = new Map<string, Promise<TeamSeason>>();
    const get = (s: string) => {
      if (!cache.has(s))
        cache.set(
          s,
          Promise.all([
            fetchJson<TeamOwn>(`${base}/data/team/${code}/${s}.json`),
            fetchJson<SeasonShared>(`${base}/data/season/${s}.json`),
          ]).then(([t, shared]) => ({ ...t, clubs: shared.clubs, leagueBands: shared.bands })),
        );
      return cache.get(s)!;
    };
    const text = (id: string, value: string) => (document.getElementById(id)!.textContent = value);
    const html = (id: string, value: string) => (document.getElementById(id)!.innerHTML = value);

    // The picked shot zones (the chips), shared by the attempts chart, the heatmaps and the band tables.
    const picked = new Set<Zone>();
    const bandKeys = Object.keys(BAND_LABELS); // the band table's rows, in this order

    // The heatmaps and band tables of one season: the squares and rows outside the picked zones are dimmed.
    function drawHeat(t: TeamSeason) {
      const charts = teamCharts(t, Number(radius), zoneLit(picked));
      const bands = teamBands(t, up, down);
      for (const side of ["taken", "allowed"] as const) {
        document.getElementById(`court-${side}`)!.innerHTML = charts.freq[side];
        document.getElementById(`court-${side}-q`)!.innerHTML = charts.quality[side];
        document.querySelector<HTMLElement>(`[data-peak="${side}"]`)!.textContent = String(peakShots(t[side], Number(radius)));
        const rows = document.getElementById(`bands-${side}`) as HTMLTableSectionElement;
        rows.innerHTML = bands[side];
        [...rows.rows].forEach((row, i) => row.classList.toggle("off", bandDimmed(bandKeys[i], picked)));
      }
    }
    // The chips change the heatmaps too; the season's file is fetched once (the cache) when first needed.
    async function redrawHeat() {
      const s = String(current);
      try {
        const t = await get(s);
        if (s === String(current)) drawHeat(t);
      } catch {
        // The heatmaps stay as they are; the attempts chart still filters.
      }
    }

    // Patch the rows in place so each mark slides to its new place.
    function patchRows(root: HTMLElement, rows: ReturnType<typeof factorRows>) {
      for (const r of rows) patchFactorRow(root.querySelector<HTMLElement>(`.ff-row[data-key="${r.key}"]`)!, r);
    }

    // ---- Tabs: one panel at a time, the choice in the URL hash. Arrow keys move between tabs.
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    let selected = "overview";
    function pick(name: string, hash: boolean, focus = false) {
      const shown = tabs.filter((t) => !t.hidden);
      const tab = shown.find((t) => t.dataset.tab === name) ?? shown[0];
      if (!tab) return;
      selected = tab.dataset.tab!;
      if (selected === "shots") ensureShots();
      for (const t of tabs) {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls")!);
        if (panel) panel.hidden = !on;
      }
      if (focus) tab.focus();
      if (hash) {
        const url = new URL(location.href);
        url.hash = selected;
        history.replaceState(null, "", url);
      }
    }
    document.querySelector('[role="tablist"]')?.addEventListener("keydown", (e) => {
      const ev = e as KeyboardEvent;
      const shown = tabs.filter((t) => !t.hidden);
      const i = shown.findIndex((t) => t.dataset.tab === selected);
      const next = {
        ArrowRight: (i + 1) % shown.length,
        ArrowLeft: (i - 1 + shown.length) % shown.length,
        Home: 0,
        End: shown.length - 1,
      }[ev.key];
      if (next === undefined) return;
      ev.preventDefault();
      pick(shown[next].dataset.tab!, true, true);
    });
    tabs.forEach((t) => t.addEventListener("click", () => pick(t.dataset.tab!, true)));
    window.addEventListener("hashchange", () => pick(location.hash.slice(1), false));

    // The Schedule tab exists for the live season only, as its panel did.
    function syncSchedule(s: string) {
      const tab = document.getElementById("tab-schedule");
      if (!tab) return;
      const off = s !== tab.dataset.season;
      tab.hidden = off;
      document.getElementById("panel-schedule")!.hidden = off;
      pick(selected, false);
    }

    // ---- Shot attempts: the live season is inlined; other seasons are fetched on first use.
    const live: ClubShots | null = JSON.parse(document.getElementById("attempts-live")?.textContent || "null");
    const chartCache = new Map<number, Promise<ClubShots | null>>();
    const chartFile = (s: number): Promise<ClubShots | null> => {
      if (live && live.season === s) return Promise.resolve(live);
      if (!chartCache.has(s)) chartCache.set(s, fetchJson<ClubShots | null>(`${base}/data/shots/club/${code}/${s}.json`));
      return chartCache.get(s)!;
    };
    let shown: ClubShots | null = null;
    let current = Number(year);
    const side = (): ClubSide => (document.querySelector<HTMLInputElement>('input[name="attempts-side"]:checked')?.value ?? "taken") as ClubSide;

    // The line under each chart: the picked zones' share and FG% of that side's attempts.
    function drawZoneLines() {
      for (const el of document.querySelectorAll<HTMLElement>("[data-zone-line]")) {
        const v = el.dataset.zoneLine as ClubSide;
        el.textContent = shown ? zoneLineText(shown[v], picked, "attempts") : "";
        el.hidden = !shown || picked.size === 0;
      }
    }

    function drawAttempts() {
      const court = document.getElementById("attempts-court")!;
      drawZoneLines();
      if (!shown) {
        court.innerHTML = "";
        document.getElementById("zone-body")!.innerHTML = "";
        return;
      }
      const name = document.getElementById("t-name")?.textContent ?? "";
      const s = side();
      court.innerHTML = markChart(sideDots(shown, s, picked), `${name}: shots ${s === "taken" ? "taken" : "allowed"}, ${shown.season}`);
      document.getElementById("zone-body")!.innerHTML = zoneRowsHtml(shown, s, picked);
    }

    async function loadAttempts(s: number) {
      current = s;
      const note = document.getElementById("attempts-note")!;
      note.textContent = "";
      try {
        const file = await chartFile(s);
        if (s !== current) return; // the visitor has moved on
        shown = file;
        note.textContent = file ? "" : "No shots are recorded for this season.";
        drawAttempts();
      } catch {
        if (s !== current) return;
        shown = null;
        note.textContent = "Could not load the shots for this season.";
        drawAttempts();
      }
    }

    // The shots tab's markup is stamped into its panel, and its controls bound, the first time it is needed:
    // when the tab opens or the season changes. Its data loads then too, once.
    let shotsStamped = false;
    function ensureShots(season = current) {
      if (shotsStamped) return;
      shotsStamped = true;
      const panel = document.getElementById("panel-shots")!;
      const holder = document.createElement("template");
      const markup = document.getElementById("tpl-shots");
      holder.innerHTML = markup?.textContent ?? "";
      markup?.remove();
      panel.append(holder.content);
      document.querySelectorAll<HTMLButtonElement>(".chip").forEach((chip) =>
        chip.addEventListener("click", () => {
          const z = chip.dataset.zone as Zone | "";
          if (!z) picked.clear();
          else if (picked.has(z)) picked.delete(z);
          else picked.add(z);
          document.querySelectorAll<HTMLButtonElement>(".chip").forEach((c) =>
            c.setAttribute("aria-pressed", String(c.dataset.zone ? picked.has(c.dataset.zone as Zone) : picked.size === 0)),
          );
          drawAttempts();
          redrawHeat();
        }),
      );
      document.querySelectorAll<HTMLInputElement>('input[name="attempts-side"]').forEach((r) =>
        r.addEventListener("change", drawAttempts),
      );
      loadAttempts(season);
    }

    async function show(s: string, push: boolean) {
      root.setAttribute("aria-busy", "true");
      try {
        const t = await get(s);
        ensureShots(Number(s));
        const c = headCells(t);
        text("t-name", t.name);
        html("c-record", c.record);
        html("c-net", c.net);
        text("c-net-sub", c.netSub);
        text("c-pace", c.pace);
        text("c-pace-sub", c.paceSub);
        text("c-seasons", c.seasons);
        text("c-seasons-sub", c.seasonsSub);
        html("c-rank", c.rank);
        text("c-playoff", c.playoff);
        text("c-playoff-sub", c.playoffSub);
        text("t-code", t.code);
        patchRows(document.getElementById("offense")!, factorRows(t, OFFENSE));
        patchRows(document.getElementById("defense")!, factorRows(t, DEFENSE));
        drawHeat(t);
        document.getElementById("roster-body")!.innerHTML = rosterHtml(t, base!);
        syncSchedule(s);
        if (select) select.value = s;
        document.title = `${t.name} · 6.75 Analytics`;
        if (push) {
          const url = new URL(location.href);
          if (s === year) url.searchParams.delete("season");
          else url.searchParams.set("season", s);
          history.replaceState(null, "", url);
        }
        await loadAttempts(Number(s));
      } catch {
        if (select) {
          select.setCustomValidity("Could not load this season");
          select.reportValidity();
        }
      } finally {
        root.removeAttribute("aria-busy");
        root.classList.remove("season-pending");
      }
    }

    if (select) select.addEventListener("change", () => show(select.value, true));
    const asked = new URLSearchParams(location.search).get("season");
    if (asked && asked !== year) {
      if (select && [...select.options].some((o) => o.value === asked)) show(asked, false);
      else root.classList.remove("season-pending");
    }
    // The page's own tab, chosen by the hash. Last, so every function it can reach is defined.
    pick(location.hash.slice(1), false);
  }
</script>

