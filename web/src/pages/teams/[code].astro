---
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import up from "@phosphor-icons/core/assets/fill/caret-up-fill.svg?raw";
import down from "@phosphor-icons/core/assets/fill/caret-down-fill.svg?raw";
import Base from "../../layouts/Base.astro";
import "../../styles/stats.css";
import { SEASON_COLS } from "../../lib/player";
import { defaultSeason, meta, teamIndex, teamSeason, type TeamIndexRow } from "../../lib/stats";
import { DEFENSE, OFFENSE, factorRowHtml, factorRows, headCells, rosterHtml, teamBands, teamCharts } from "../../lib/team";
import { plural, sourceCode, teamFactors } from "../../lib/live";
import { tip } from "../../lib/tip";
import { GROUPS, colsHtml } from "../../lib/cols";

export async function getStaticPaths() {
  return (await teamIndex()).map((t) => ({ params: { code: t.code.toLowerCase() }, props: { club: t } }));
}

const { club } = Astro.props as { club: TeamIndexRow };
const m = (await meta())!;
const open = defaultSeason(m).season;
const year = [...club.seasons].reverse().find((s) => s <= open) ?? club.seasons[club.seasons.length - 1];
const t = (await teamSeason(club.code, year))!;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const radius = m.hex_radius_m;
const head = headCells(t);
const charts = teamCharts(t, radius);
const bands = teamBands(t, up, down);
const labels = new Map(m.seasons.map((s) => [s.season, s.label]));
const description = `${club.name}: EuroLeague record, ratings, four factors, shot charts and roster.`;
// Schedule strength comes from the API's live-season file, keyed by source code.
const factors = await teamFactors("euroleague", sourceCode("euroleague", club.code));
const liveSeason = factors?.season ?? m.seasons.find((s) => s.live)?.season ?? open;
const schedule = factors?.schedule_strength;
const bandHead = [
  ["Shots", ""],
  ["Share", ""],
  ["League", "League share of attempts from this distance"],
  ["FG%", ""],
  ["League", "League FG% from this distance"],
  ["Diff", "FG% minus the league's, in points, from 10 attempts up"],
];
---

<Base title={club.name} description={description} current="teams">
  <script is:inline define:vars={{ shown: String(t.season) }}>
    // A link to another season: hide the season's numbers until they arrive, so they never flash.
    const asked = new URLSearchParams(location.search).get("season");
    if (asked && asked !== shown) document.documentElement.classList.add("season-pending");
  </script>
  <header
    class="wrap head team-head"
    id="team"
    data-code={t.code.toLowerCase()}
    data-base={base}
    data-radius={radius}
    data-year={t.season}
  >
    <div>
      <h1 id="t-name">{t.name}</h1>
    </div>
    {
      club.seasons.length > 1 && (
        <label class="field">
          <span>Season</span>
          <span class="select">
            <select id="season" aria-controls="cells ranks shots roster">
              {[...club.seasons].reverse().map((s) => (
                <option value={s} selected={s === t.season}>
                  {labels.get(s) ?? s}
                </option>
              ))}
            </select>
            <span class="caret" set:html={caret} />
          </span>
        </label>
      )
    }
  </header>

  <div class="wrap">
    <dl class="cells seasonal" id="cells">
      <div class="cell">
        <dt>Record</dt>
        <dd id="c-record" set:html={head.record} />
      </div>
      <div class="cell">
        <dt>
          <span data-tip={tip`<b>Net rating</b><br>Points scored minus points allowed per 100 possessions. The arrow compares with the league average, which is 0.`} tabindex="0">Net rating</span>
        </dt>
        <dd id="c-net" set:html={head.net} />
        <dd class="sub" id="c-net-sub">{head.netSub}</dd>
      </div>
      <div class="cell">
        <dt>
          <span data-tip={tip`<b>Pace</b><br>Possessions per 40 minutes, both teams averaged`} tabindex="0">Pace</span>
        </dt>
        <dd id="c-pace">{head.pace}</dd>
        <dd class="sub" id="c-pace-sub">{head.paceSub}</dd>
      </div>
      <div class="cell">
        <dt>EuroLeague seasons</dt>
        <dd id="c-seasons">{head.seasons}</dd>
        <dd class="sub" id="c-seasons-sub">{head.seasonsSub}</dd>
      </div>
      <div class="cell">
        <dt>
          <span data-tip={tip`<b>League rank</b><br>Regular-season standings position; 1 is the top`} tabindex="0">League rank</span>
        </dt>
        <dd id="c-rank" set:html={head.rank} />
      </div>
      <div class="cell">
        <dt>Playoffs</dt>
        <dd id="c-playoff">{head.playoff}</dd>
        <dd class="sub" id="c-playoff-sub">{head.playoffSub}</dd>
      </div>
    </dl>
  </div>

  <section class="wrap band" id="ranks" aria-labelledby="ranks-title">
    <header class="sec-head">
      <h2 id="ranks-title">Where they rank</h2>
      <p class="ff-key">
        <span>Right is better on every row.</span>
        <span><i class="k-me" aria-hidden="true"></i><span id="t-code">{t.code}</span></span>
        <span><i class="k-avg" aria-hidden="true"></i>League average</span>
        <span><i class="k-med" aria-hidden="true"></i>League median</span>
      </p>
    </header>
    <div class="ranks busy-fade seasonal">
      <div class="side" id="offense" role="group" aria-labelledby="h-offense">
        <h3 id="h-offense">Offense</h3>
        <div class="ff-cols" aria-hidden="true"><span>Club</span><span>Rank</span><span>vs league</span></div>
        <Fragment set:html={factorRows(t, OFFENSE).map(factorRowHtml).join("")} />
      </div>
      <div class="side" id="defense" role="group" aria-labelledby="h-defense">
        <h3 id="h-defense">Defense</h3>
        <div class="ff-cols" aria-hidden="true"><span>Club</span><span>Rank</span><span>vs league</span></div>
        <Fragment set:html={factorRows(t, DEFENSE).map(factorRowHtml).join("")} />
      </div>
    </div>
    <p class="note">Ranks count from the best. The arrow compares with the league average.</p>
  </section>

  {
    schedule && schedule.value !== null && (
      <section class="wrap band" id="schedule" aria-labelledby="schedule-title" data-season={liveSeason} hidden={t.season !== liveSeason}>
        <header class="sec-head">
          <h2 id="schedule-title">Schedule strength</h2>
          <p>
            Mean opponent rating <b class="strength">{schedule.value.toFixed(1)}</b> over {plural(schedule.games ?? 0, "scheduled game")}.
          </p>
        </header>
      </section>
    )
  }

  <section class="wrap band" id="shots" aria-labelledby="shots-title">
    <header class="sec-head split">
      <div>
        <h2 id="shots-title">Shots taken and allowed</h2>
        <p>Where the club shot from and where it let opponents shoot, against the league from the same spot.</p>
      </div>
    </header>
    <div class="pair busy-fade seasonal">
      {
        (["taken", "allowed"] as const).map((side) => (
          <div class="half">
            <figure class="chart-box">
              <figcaption class="half-title">
                <h3>{side === "taken" ? "Taken" : "Allowed"}</h3>
              </figcaption>
              <div id={`court-${side}`} set:html={charts[side]} />
              <p class="key">
                {side === "taken" ? (
                  <>
                    <span class="scale" aria-hidden="true">
                      <i class="t-2" />
                      <i class="t-1" />
                      <i class="t0" />
                      <i class="t1" />
                      <i class="t2" />
                    </span>
                    <span>Colour: FG% against the league's from that spot, below to above</span>
                  </>
                ) : (
                  <>
                    <span class="scale" aria-hidden="true">
                      <i class="t2" />
                      <i class="t1" />
                      <i class="t0" />
                      <i class="t-1" />
                      <i class="t-2" />
                    </span>
                    <span>Colour: opponents' FG% against the league's, below to above</span>
                  </>
                )}
                <span class="sizes" aria-hidden="true">
                  <i class="s1" />
                  <i class="s2" />
                  <i class="s3" />
                </span>
                <span>Size: how often {side === "taken" ? "the club" : "opponents"} shot from there</span>
              </p>
            </figure>
            <div>
              <Fragment set:html={colsHtml(`bc-${side}`, GROUPS.bands)} />
              <div class="scroll">
                <table class="grid bands">
                  <caption class="sr-only">
                    {side === "taken" ? "Shots taken" : "Shots allowed"} by distance against the league
                  </caption>
                  <thead>
                    <tr>
                      <th scope="col">Distance</th>
                      {bandHead.map(([h, about]) => (
                        <th scope="col" class="num">
                          {about ? (
                            <span data-tip={tip`${about}`} tabindex="0">
                              {h}
                            </span>
                          ) : (
                            h
                          )}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody id={`bands-${side}`} set:html={bands[side]} />
                </table>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <p class="note">
      An orange caret on Allowed means opponents shot worse than the league from that distance.
    </p>
  </section>

  <section class="wrap band" id="roster" aria-labelledby="roster-title">
    <header class="sec-head">
      <h2 id="roster-title">Roster</h2>
      <p>Everyone who played for the club that season, by minutes. Per game, for this club only.</p>
    </header>
    <Fragment set:html={colsHtml("rc", GROUPS.line)} />
    <div class="scroll busy-fade seasonal">
      <table class="grid roster">
        <thead>
          <tr>
            <th scope="col" class="num">#</th>
            <th scope="col">Player</th>
            {SEASON_COLS.map((c) => (
              <th scope="col" class="num">
                <span data-tip={tip`<b>${c.head}</b><br>${c.about}`} tabindex="0">{c.head}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody id="roster-body" set:html={rosterHtml(t, base)} />
      </table>
    </div>
  </section>
</Base>

<script>
  import up from "@phosphor-icons/core/assets/fill/caret-up-fill.svg?raw";
  import down from "@phosphor-icons/core/assets/fill/caret-down-fill.svg?raw";
  import type { SeasonShared, TeamOwn, TeamSeason } from "../../lib/stats";
  import { DEFENSE, OFFENSE, factorRows, headCells, patchFactorRow, rosterHtml, teamBands, teamCharts } from "../../lib/team";

  const head = document.getElementById("team");
  const select = document.getElementById("season") as HTMLSelectElement | null;
  if (head && select) {
    const { code, base, radius, year } = head.dataset;
    const fetchJson = <T,>(url: string): Promise<T> =>
      fetch(url).then((r) => {
        if (!r.ok) throw new Error(String(r.status));
        return r.json();
      });
    const cache = new Map<string, Promise<TeamSeason>>();
    const get = (s: string) => {
      if (!cache.has(s))
        cache.set(
          s,
          Promise.all([
            fetchJson<TeamOwn>(`${base}/data/team/${code}/${s}.json`),
            fetchJson<SeasonShared>(`${base}/data/season/${s}.json`),
          ]).then(([t, shared]) => ({ ...t, clubs: shared.clubs, leagueBands: shared.bands })),
        );
      return cache.get(s)!;
    };
    const text = (id: string, value: string) => (document.getElementById(id)!.textContent = value);
    const html = (id: string, value: string) => (document.getElementById(id)!.innerHTML = value);

    // Patch the rows in place so each mark slides to its new place.
    function patchRows(root: HTMLElement, rows: ReturnType<typeof factorRows>) {
      for (const r of rows) patchFactorRow(root.querySelector<HTMLElement>(`.ff-row[data-key="${r.key}"]`)!, r);
    }

    async function show(s: string, push: boolean) {
      const root = document.documentElement;
      root.setAttribute("aria-busy", "true");
      try {
        const t = await get(s);
        const c = headCells(t);
        text("t-name", t.name);
        html("c-record", c.record);
        html("c-net", c.net);
        text("c-net-sub", c.netSub);
        text("c-pace", c.pace);
        text("c-pace-sub", c.paceSub);
        text("c-seasons", c.seasons);
        text("c-seasons-sub", c.seasonsSub);
        html("c-rank", c.rank);
        text("c-playoff", c.playoff);
        text("c-playoff-sub", c.playoffSub);
        text("t-code", t.code);
        patchRows(document.getElementById("offense")!, factorRows(t, OFFENSE));
        patchRows(document.getElementById("defense")!, factorRows(t, DEFENSE));
        const charts = teamCharts(t, Number(radius));
        const bands = teamBands(t, up, down);
        for (const side of ["taken", "allowed"] as const) {
          document.getElementById(`court-${side}`)!.innerHTML = charts[side];
          document.getElementById(`bands-${side}`)!.innerHTML = bands[side];
        }
        document.getElementById("roster-body")!.innerHTML = rosterHtml(t, base!);
        const sched = document.getElementById("schedule");
        if (sched) sched.hidden = s !== sched.dataset.season;
        select!.value = s;
        document.title = `${t.name} · 6.75 Analytics`;
        if (push) {
          const url = new URL(location.href);
          if (s === year) url.searchParams.delete("season");
          else url.searchParams.set("season", s);
          history.replaceState(null, "", url);
        }
      } catch {
        select!.setCustomValidity("Could not load this season");
        select!.reportValidity();
      } finally {
        root.removeAttribute("aria-busy");
        root.classList.remove("season-pending");
      }
    }

    select.addEventListener("change", () => show(select.value, true));
    const asked = new URLSearchParams(location.search).get("season");
    if (asked && asked !== year) {
      if ([...select.options].some((o) => o.value === asked)) show(asked, false);
      else document.documentElement.classList.remove("season-pending");
    }
  }
</script>

<style>
  :global(.season-pending) .seasonal {
    visibility: hidden;
  }
  #schedule[hidden] {
    display: none;
  }
  .strength {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .team-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }

  /* Header cells: one row split by hairlines; no fill, no shadow */
  .cells {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    margin: 28px 0 0;
    border-top: 1px solid var(--rule-strong);
    border-bottom: 1px solid var(--rule);
  }
  .cell {
    min-width: 0;
    padding: 14px 16px;
    border-left: 1px solid var(--rule);
  }
  .cell:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .cell dt {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .cell dd {
    margin: 0;
  }
  .cell dd:not(.sub) {
    margin-top: 4px;
    font-size: 1.125rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
  }
  .cell .sub {
    min-height: 1.25em;
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .cell :global(.muted) {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 400;
  }
  @media (max-width: 980px) {
    .cells {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .cell,
    .cell:first-child {
      padding-left: 16px;
      border-left: 1px solid var(--rule);
    }
    .cell:nth-child(3n + 1) {
      padding-left: 0;
      border-left: 0;
    }
    .cell:nth-child(n + 4) {
      border-top: 1px solid var(--rule);
    }
  }
  @media (max-width: 560px) {
    .cells {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cell:nth-child(3n + 1) {
      padding-left: 16px;
      border-left: 1px solid var(--rule);
    }
    .cell:nth-child(2n + 1) {
      padding-left: 0;
      border-left: 0;
    }
    .cell:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }
  }

  /* Four Factors rows: Offense beside Defense */
  .ranks {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
  }
  h3 {
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule-strong);
    font-size: 1rem;
    font-weight: 600;
  }
  .ff-key {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 18px;
  }
  .ff-key > span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ff-key i {
    display: inline-block;
    flex: none;
  }
  .k-me {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--data-1);
  }
  .k-avg {
    width: 2px;
    height: 14px;
    background: var(--data-2);
  }
  .k-med {
    box-sizing: border-box;
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--data-2);
    border-radius: 50%;
  }
  .side :global(.ff-cols),
  .side :global(.ff-row) {
    display: grid;
    grid-template-columns: minmax(0, 9.5rem) 3rem 4.75rem minmax(0, 1fr) 4.5rem;
    align-items: center;
    gap: 12px;
  }
  .side :global(.ff-cols) {
    padding: 8px 0 2px;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .side :global(.ff-cols span:nth-child(1)) {
    grid-column: 2;
    text-align: right;
  }
  .side :global(.ff-cols span:nth-child(2)) {
    grid-column: 3;
  }
  .side :global(.ff-cols span:nth-child(3)) {
    grid-column: 5;
    text-align: right;
  }
  .side :global(.ff-row) {
    min-height: 48px;
    border-bottom: 1px solid var(--rule);
    font-size: 0.8125rem;
  }
  .side :global(.ff-name) {
    color: var(--ink-2);
  }
  .side :global(.ff-val) {
    text-align: right;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .side :global(.ff-rank) {
    color: var(--ink-2);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .side :global(.ff-delta) {
    text-align: right;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  /* The rail is bare: one hairline. Marks sit on it; the orange bar runs from the league average
     to the club, so its length and side show how far above or below, and right is always better. */
  .side :global(.ff-rail) {
    position: relative;
    height: 24px;
  }
  .side :global(.ff-rail)::before {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    border-top: 1px solid var(--axis);
  }
  .side :global(:is(.ff-me, .ff-avg, .ff-med)) {
    position: absolute;
    top: 50%;
    translate: -50% -50%;
  }
  .side :global(:is(.ff-me, .ff-avg, .ff-med))::after {
    content: "";
    position: absolute;
    inset: -8px;
  }
  .side :global(.ff-bar) {
    position: absolute;
    top: 50%;
    height: 3px;
    translate: 0 -50%;
    border-radius: 1.5px;
    background: var(--data-1);
  }
  .side :global(.ff-avg) {
    width: 2px;
    height: 16px;
    background: var(--data-2);
  }
  .side :global(.ff-med) {
    box-sizing: border-box;
    width: 8px;
    height: 8px;
    border: 1.5px solid var(--data-2);
    border-radius: 50%;
    background: var(--page);
  }
  .side :global(.ff-me) {
    z-index: 1;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--data-1);
    box-shadow: 0 0 0 2px var(--page);
  }
  .side :global(:is(.ff-me, .ff-avg, .ff-med):focus-visible) {
    outline: 2px solid var(--data-1);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .side :global(:is(.ff-me, .ff-avg, .ff-med)) {
      transition: left 200ms var(--ease-out);
    }
    .side :global(.ff-bar) {
      transition:
        left 200ms var(--ease-out),
        width 200ms var(--ease-out);
    }
  }


  /* Shots: two courts, each over its band table */
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: start;
  }
  .half {
    display: grid;
    gap: 24px;
  }
  .half-title h3 {
    margin-bottom: 14px;
  }
  .bands :global(th small) {
    display: inline;
    margin-left: 6px;
  }
  /* On a phone the distance goes under the band name, as on the player page, so Diff stays in view. */
  @media (max-width: 560px) {
    .bands :global(th small) {
      display: block;
      margin-left: 0;
    }
  }
  .roster :global(tr.empty td) {
    padding: 24px 0;
    color: var(--ink-2);
  }

  @media (max-width: 980px) {
    .pair,
    .ranks {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }
    .chart-box {
      max-width: 560px;
    }
  }
  @media (max-width: 560px) {
    .team-head {
      flex-direction: column;
      align-items: start;
    }
    .side :global(.ff-cols) {
      display: none;
    }
    .side :global(.ff-row) {
      grid-template-columns: minmax(0, 1fr) auto auto auto;
      gap: 2px 12px;
      padding: 10px 0 6px;
    }
    .side :global(.ff-rail) {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .side :global(.ff-delta) {
      min-width: 4rem;
    }
  }
</style>
