---
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import Base from "../../layouts/Base.astro";
import "../../styles/stats.css";
import { teamHref } from "../../lib/players";
import { clubIndex, defaultSeason, meta, published, season, type TeamIndexRow } from "../../lib/stats";
import { clubRowsHtml, type ClubCells } from "../../lib/clubs";
import { tip } from "../../lib/tip";
import { GROUPS, colsHtml } from "../../lib/cols";
import { clubCells, clubPlot } from "../../lib/team";
import { paceChart, ratingsChart, type ClubPlot } from "../../lib/scatter";
import raw from "../../data/site.json";
import type { SiteData } from "../../lib/format";

const m = await meta();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const open = m ? defaultSeason(m).season : 0;
const tables = m
  ? await Promise.all(
      [...m.seasons].reverse().map(async (s) => {
        const data = await season(s.season, "teams");
        return { s, rows: clubCells(data.fields, data.teams), plot: clubPlot(data.fields, data.teams, data.league) };
      }),
    )
  : [];
const shown = tables.find(({ s }) => s.season === open);
// Only the open season is in the page; the switch draws the others from these cells.
// The charts' points come from the same factors, so the season switch redraws them from this too.
const others: Record<string, [string, ClubCells[], ClubPlot]> = Object.fromEntries(
  tables.filter((t) => t !== shown).map(({ s, rows, plot }) => [s.season, [s.label, rows, plot]]),
);
const clubs = await clubIndex();
// EuroLeague titles, all-time since 1958, by display code (clubs with at least one).
const titles = (raw as SiteData).el_titles.titles;
// Clubs with a pre-2007 title and no code in our data: listed by name, with no page or seasons.
const uncoded = (raw as SiteData).el_titles.uncoded ?? [];
// Clubs with a season in the published window have a page; the others are listed without one.
const linked = (c: TeamIndexRow) => (m ? published(c, m) : false);
// A phone shows them in groups (Record, Ratings, Pace), with Net, the ranking, in every group.
const COLS = [
  ["W–L", "Wins and losses"],
  ["ORtg", "Points scored per 100 possessions"],
  ["DRtg", "Points allowed per 100 opponent possessions"],
  ["Net", "Offensive minus defensive rating"],
  ["Pace", "Possessions per 40 minutes"],
];
---

<Base title="Teams" description="Every EuroLeague club since 2007-08: record, ratings and pace by season." current="teams">
  <header class="wrap head">
    <h1>Teams</h1>
    <p class="lede">Every club of a EuroLeague season, ranked by net rating: points scored minus points allowed per 100 possessions.</p>
  </header>

  {
    !m ? (
      <section class="wrap band">
        <p class="note">No stats exported yet. Run eurohoops export-stats and rebuild.</p>
      </section>
    ) : (
      <section class="wrap band" aria-labelledby="table-title">
        <header class="sec-head split">
          <h2 id="table-title">By net rating</h2>
          <label class="field">
            <span>Season</span>
            <span class="select">
              <select id="season">
                {tables.map(({ s }) => (
                  <option value={s.season} selected={s.season === open}>
                    {s.label}
                  </option>
                ))}
              </select>
              <span class="caret" set:html={caret} />
            </span>
          </label>
        </header>
        {shown && <Fragment set:html={colsHtml("cc", GROUPS.clubs)} />}
        {shown && (
          <div class="scroll" id="clubs" data-base={base} data-others={JSON.stringify(others)}>
            <table class="grid clubs">
              <caption class="sr-only">{shown.s.label} clubs by net rating</caption>
              <thead>
                <tr>
                  <th scope="col" class="num">#</th>
                  <th scope="col">Club</th>
                  {COLS.map(([h, about]) => (
                    <th scope="col" class="num">
                      <span data-tip={tip`<b>${h}</b><br>${about}`} tabindex="0">
                        {h}
                      </span>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody set:html={clubRowsHtml(base, undefined, shown.rows)} />
            </table>
          </div>
        )}
      </section>
    )
  }

  {
    shown && (
      <section class="wrap band" aria-labelledby="charts-title">
        <header class="sec-head">
          <h2 id="charts-title">Offence, defence and pace</h2>
          <p>One dot per club for the season selected above, from the same ratings as the table.</p>
        </header>
        <div class="charts">
          <figure class="panel">
            <figcaption class="cap">
              <h3>Offence against defence</h3>
              <p>Up and right is better: the defensive axis is reversed. Dashed lines are the league average; the diagonal is net 0.</p>
            </figcaption>
            <div id="ratings-chart" set:html={ratingsChart(shown.plot, shown.s.label)} />
          </figure>
          <figure class="panel">
            <figcaption class="cap">
              <h3>Pace against net rating</h3>
              <p>Right is faster, up is better. Dashed lines are the league pace and net 0.</p>
            </figcaption>
            <div id="pace-chart" set:html={paceChart(shown.plot, shown.s.label)} />
          </figure>
        </div>
      </section>
    )
  }

  {
    clubs.length > 0 && (
      <section class="wrap band" aria-labelledby="all-title">
        <header class="sec-head">
          <h2 id="all-title">Every club since 2007-08</h2>
          <p>{clubs.length + uncoded.length} clubs, with the EuroLeague seasons each played and, in brackets, EuroLeague titles, all-time since 1958.</p>
        </header>
        <ul class="all">
          {clubs.map((c) => {
            const cells = [
              <span class="code">{c.code}</span>,
              <span class="nm">{c.name}</span>,
              <span class="n" title={`${c.seasons[0]}–${c.seasons.at(-1)} seasons played`}>
                {c.seasons.length}
              </span>,
              <span class="t" title="EuroLeague titles, all-time since 1958">
                {titles[c.code] ? `(${titles[c.code]})` : ""}
              </span>,
            ];
            return (
              <li>
                {linked(c) ? (
                  <a href={teamHref(base, c.code)}>{cells}</a>
                ) : (
                  <span class="row">{cells}</span>
                )}
              </li>
            );
          })}
          {uncoded.map((u) => (
            <li>
              <span class="row">
                <span class="code" aria-hidden="true">–</span>
                <span class="nm">{u.club}</span>
                <span class="n" title="No EuroLeague season since 2007-08 in our data">pre-2007</span>
                <span class="t" title="EuroLeague titles, all-time since 1958">({u.titles})</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<script>
  import { clubRowsHtml, type ClubCells } from "../../lib/clubs";
  import { paceChart, ratingsChart, type ClubPlot } from "../../lib/scatter";

  const select = document.getElementById("season") as HTMLSelectElement | null;
  const box = document.getElementById("clubs");
  const ratings = document.getElementById("ratings-chart");
  const pace = document.getElementById("pace-chart");
  if (select && box) {
    const others = JSON.parse(box.dataset.others!) as Record<string, [string, ClubCells[], ClubPlot]>;
    const caption = box.querySelector("caption")!;
    const body = box.querySelector("tbody")!;
    const open = [caption.textContent!, body.innerHTML, ratings?.innerHTML ?? "", pace?.innerHTML ?? ""];
    select.addEventListener("change", () => {
      const s = others[select.value];
      if (s) {
        caption.textContent = `${s[0]} clubs by net rating`;
        body.innerHTML = clubRowsHtml(box.dataset.base!, Number(select.value), s[1]);
        if (ratings) ratings.innerHTML = ratingsChart(s[2], s[0]);
        if (pace) pace.innerHTML = paceChart(s[2], s[0]);
      } else {
        caption.textContent = open[0];
        body.innerHTML = open[1];
        if (ratings) ratings.innerHTML = open[2];
        if (pace) pace.innerHTML = open[3];
      }
    });
  }
</script>

<style is:global>
  /* The scatter SVG is built in lib/scatter.ts and also swapped in by the season switch, so its
   * classes are global rather than scoped to this page. */
  .scatter {
    display: block;
    width: 100%;
    max-width: 460px;
    height: auto;
    overflow: visible;
  }
  .scatter .plot {
    fill: var(--surface);
  }
  .scatter .grid line {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .scatter .ref {
    stroke: var(--ink-2);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    opacity: 0.6;
  }
  .scatter .zero {
    stroke: var(--ink-2);
    stroke-width: 1;
    opacity: 0.35;
  }
  .scatter .tick,
  .scatter .axis {
    fill: var(--muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .scatter .pt circle {
    fill: var(--data-2);
    stroke: var(--surface);
    stroke-width: 1;
  }
  .scatter .pt text {
    fill: var(--ink-2);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
</style>

<style>
  .code,
  .scroll :global(.code) {
    display: inline-block;
    width: 3.25em;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .clubs :global(td.strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .all {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 0 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .all a,
  .all .row {
    display: flex;
    align-items: baseline;
    gap: 4px;
    padding: 9px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .all .nm {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .all .row {
    color: var(--ink-2);
  }
  .all .n {
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .all .t {
    min-width: 3.25em;
    color: var(--ink);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .all a:focus-visible {
    outline: 2px solid var(--data-1);
    outline-offset: 2px;
  }
  .charts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 48px 56px;
  }
  .panel {
    margin: 0;
    min-width: 0;
  }
  .cap {
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .cap h3 {
    font-size: 1.0625rem;
  }
  .cap p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 60ch;
  }
  @media (max-width: 560px) {
    /* Long club names wrap so Net, the ranking, stays on screen. */
    .clubs tbody :global(th) {
      white-space: normal;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .all a:hover .nm {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
</style>
