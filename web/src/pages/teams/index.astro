---
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import Base from "../../layouts/Base.astro";
import "../../styles/stats.css";
import { teamHref } from "../../lib/players";
import { clubIndex, defaultSeason, meta, published, type TeamIndexRow } from "../../lib/stats";
import { clubHeadHtml, clubRowsHtml } from "../../lib/clubs";
import { GROUPS, colsHtml } from "../../lib/cols";
import { indexSeason } from "../../lib/clubs_season";
import { paceChart, ratingsChart } from "../../lib/scatter";
import {
  DEFAULT_METRIC,
  METRIC_GROUPS,
  bestDir,
  captionOf,
  headingOf,
  metricOf,
  plotOf,
  sortRows,
  type IndexSeason,
  type View,
} from "../../lib/ranking";
import raw from "../../data/site.json";
import type { SiteData } from "../../lib/format";

const m = await meta();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const open = m ? defaultSeason(m).season : 0;
// Every published season, by season number: the page opens on one and the season switch and the metric sort
// draw the others from the same figures (no second fetch).
// Schedule strength (SoS) comes from each club's factors file, which the API writes for the live season
// only: the live season's rows take it, and the other seasons show a dash.
// Only the season the page opens on is built into the page; the others load on the season switch
// (data/clubs/{season}.json), so the page does not grow with every season.
const openRef = m?.seasons.find((s) => s.season === open);
const shown: IndexSeason | undefined = openRef ? await indexSeason(openRef) : undefined;
const bySeason: Record<string, IndexSeason> = shown ? { [String(open)]: shown } : {};

const view: View = { season: open, metric: DEFAULT_METRIC, dir: bestDir(DEFAULT_METRIC) };
const rows = shown ? sortRows(shown.rows, view.metric, view.dir) : [];
const clubs = await clubIndex();
// EuroLeague titles, all-time since 1958, by display code (clubs with at least one).
const titles = (raw as SiteData).el_titles.titles;
// Clubs with a pre-2007 title and no code in our data: listed by name, with no page or seasons.
const uncoded = (raw as SiteData).el_titles.uncoded ?? [];
// Clubs with a season in the published window have a page; the others are listed without one.
const linked = (c: TeamIndexRow) => (m ? published(c, m) : false);
const seasons = m ? [...m.seasons].reverse() : [];
---

<Base title="Teams" description="Every EuroLeague club since 2007-08: record, ratings and pace by season." current="teams">
  <header class="wrap head">
    <h1>Teams</h1>
    <p class="lede">Every club of a EuroLeague season, ranked by net rating: points scored minus points allowed per 100 possessions.</p>
  </header>

  {
    !m || !shown ? (
      <section class="wrap band">
        <p class="note">Team stats are being updated. Check back after the next daily update.</p>
      </section>
    ) : (
      <section class="wrap band" aria-labelledby="table-title">
        <header class="sec-head split">
          <h2 id="table-title">{headingOf(view.metric)}</h2>
          <div class="filters">
            <label class="field">
              <span>Metric</span>
              <span class="select">
                <select id="metric" name="metric" style="--select-w: 11.5rem">
                  {METRIC_GROUPS.map((g) => (
                    <optgroup label={g.label}>
                      {g.keys.map((k) => (
                        <option value={k} selected={k === view.metric}>
                          {metricOf(k)?.name}
                        </option>
                      ))}
                    </optgroup>
                  ))}
                </select>
                <span class="caret" set:html={caret} />
              </span>
            </label>
            <label class="field">
              <span>Season</span>
              <span class="select">
                <select id="season" name="season" style="--select-w: 7.875rem">
                  {seasons.map((s) => (
                    <option value={s.season} selected={s.season === view.season}>
                      {s.label}
                    </option>
                  ))}
                </select>
                <span class="caret" set:html={caret} />
              </span>
            </label>
          </div>
        </header>
        <Fragment set:html={colsHtml("cc", GROUPS.clubs)} />
        <div class="scroll" id="clubs" data-base={base} data-open={open} data-seasons={JSON.stringify(bySeason)}>
          <table class="grid clubs">
            <caption class="sr-only">{captionOf(shown.label, view.metric)}</caption>
            <thead set:html={clubHeadHtml(view.metric, view.dir)} />
            <tbody set:html={clubRowsHtml(base, undefined, rows, view.metric)} />
          </table>
        </div>
      </section>
    )
  }

  {
    shown && (
      <section class="wrap band" aria-labelledby="charts-title">
        <header class="sec-head">
          <h2 id="charts-title">Offence, defence and pace</h2>
          <p>One mark per club for the season selected above, from the same ratings as the table.</p>
        </header>
        <div class="charts">
          <figure class="panel">
            <figcaption class="cap">
              <h3>Offence against defence</h3>
              <p>Up and right is better: the defensive axis is reversed. Dashed lines are the league average; the diagonal is net 0.</p>
            </figcaption>
            <div id="ratings-chart" set:html={ratingsChart(plotOf(shown), shown.label)} />
          </figure>
          <figure class="panel">
            <figcaption class="cap">
              <h3>Pace against net rating</h3>
              <p>Right is faster, up is better. Dashed lines are the league pace and net 0.</p>
            </figcaption>
            <div id="pace-chart" set:html={paceChart(plotOf(shown), shown.label)} />
          </figure>
        </div>
      </section>
    )
  }

  {
    clubs.length > 0 && (
      <section class="wrap band" aria-labelledby="all-title">
        <header class="sec-head">
          <h2 id="all-title">All clubs</h2>
          <p>{clubs.length + uncoded.length} clubs: every EuroLeague club since 2007-08 with its seasons played since then, plus earlier champions. In brackets, EuroLeague titles, all-time since 1958.</p>
        </header>
        <ul class="all">
          {clubs.map((c) => {
            const cells = [
              <span class="code">{c.code}</span>,
              <span class="nm">{c.name}</span>,
              <span class="n" title={`${c.seasons[0]}–${c.seasons.at(-1)} seasons played`}>
                {c.seasons.length}
              </span>,
              <span class="t" title="EuroLeague titles, all-time since 1958">
                {titles[c.code] ? `(${titles[c.code]})` : ""}
              </span>,
            ];
            return (
              <li>
                {linked(c) ? (
                  <a href={teamHref(base, c.code)}>{cells}</a>
                ) : (
                  <span class="row">{cells}</span>
                )}
              </li>
            );
          })}
          {uncoded.map((u) => (
            <li>
              <span class="row">
                <span class="code" aria-hidden="true">-</span>
                <span class="nm">{u.club}</span>
                <span class="n" title="No EuroLeague season since 2007-08 in our data">pre-2007</span>
                <span class="t" title="EuroLeague titles, all-time since 1958">({u.titles})</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<script>
  import { clubHeadHtml, clubRowsHtml } from "../../lib/clubs";
  import { paceChart, ratingsChart } from "../../lib/scatter";
  import {
    bestDir,
    captionOf,
    fromQuery,
    headingOf,
    phoneGroup,
    plotOf,
    sortRows,
    toQuery,
    type IndexSeason,
    type View,
  } from "../../lib/ranking";

  const host = document.getElementById("clubs");
  const season = document.getElementById("season") as HTMLSelectElement | null;
  const metric = document.getElementById("metric") as HTMLSelectElement | null;
  const title = document.getElementById("table-title");
  const ratings = document.getElementById("ratings-chart");
  const pace = document.getElementById("pace-chart");
  const groups = [...document.querySelectorAll<HTMLInputElement>('input[name="cc"]')];
  if (host && season && metric && title) {
    // Only the open season is embedded; the rest are fetched once each, on the season switch.
    const seasons = JSON.parse(host.dataset.seasons ?? "{}") as Record<string, IndexSeason>;
    const allSeasons = Array.from(season.options, (o) => Number(o.value));
    const open = Number(host.dataset.open);
    const base = host.dataset.base ?? "";
    const caption = host.querySelector("caption")!;
    const thead = host.querySelector("thead")!;
    const body = host.querySelector("tbody")!;
    let view: View = fromQuery(location.search, allSeasons, open);
    const loadSeason = async (n: number): Promise<IndexSeason | undefined> => {
      if (!seasons[String(n)]) {
        const r = await fetch(`${base}/data/clubs/${n}.json`);
        if (!r.ok) return undefined;
        seasons[String(n)] = (await r.json()) as IndexSeason;
      }
      return seasons[String(n)];
    };

    // Each club's dot centre, relative to its chart's SVG, in screen pixels. Read before a redraw.
    type Spot = Map<string, { x: number; y: number }>;
    const spots = (chart: HTMLElement | null): Spot => {
      const spot: Spot = new Map();
      const svg = chart?.querySelector("svg");
      if (!svg) return spot;
      const origin = svg.getBoundingClientRect();
      svg.querySelectorAll<SVGGElement>("g.pt[data-key]").forEach((g) => {
        const r = g.getBoundingClientRect();
        spot.set(g.dataset.key!, { x: r.left + r.width / 2 - origin.left, y: r.top + r.height / 2 - origin.top });
      });
      return spot;
    };
    // After the redraw, each club's dot starts at its old place and slides to the new one.
    // transform only; WAAPI, so a switch made mid-slide starts from where the dot is now.
    const slide = (chart: HTMLElement | null, was: Spot) => {
      const svg = chart?.querySelector("svg");
      if (!svg) return;
      const origin = svg.getBoundingClientRect();
      const k = svg.getScreenCTM()?.a || 1; // screen pixels per chart unit (uniform scale)
      const moves: [SVGGElement, number, number][] = [];
      svg.querySelectorAll<SVGGElement>("g.pt[data-key]").forEach((g) => {
        const p = was.get(g.dataset.key!);
        if (!p) return;
        const r = g.getBoundingClientRect();
        moves.push([g, (p.x - (r.left + r.width / 2 - origin.left)) / k, (p.y - (r.top + r.height / 2 - origin.top)) / k]);
      });
      for (const [g, dx, dy] of moves) {
        if (Math.abs(dx) > 0.05 || Math.abs(dy) > 0.05)
          g.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "none" }], { duration: 200, easing: "cubic-bezier(0.23, 1, 0.32, 1)" });
      }
    };

    // Redraws the table, the heading and the charts from the view, then writes the view to the query string.
    // The season switch passes animate = true, so the dots slide; the first draw and the sort do not.
    const paint = async (sorted = false, animate = false) => {
      const wanted = view.season;
      const s = await loadSeason(wanted);
      if (!s || view.season !== wanted) return; // a later switch has taken over
      // Read the dots' places before any write, so the switch can slide them (see slide).
      const was = animate && !matchMedia("(prefers-reduced-motion: reduce)").matches ? [spots(ratings), spots(pace)] : undefined;
      season.value = String(view.season);
      metric.value = view.metric;
      title.textContent = headingOf(view.metric);
      caption.textContent = captionOf(s.label, view.metric);
      thead.innerHTML = clubHeadHtml(view.metric, view.dir);
      // A column sort slides each row from its old place to its new one (FLIP, transform only).
      const before = sorted ? new Map([...body.rows].map((r) => [r.dataset.key, r.getBoundingClientRect().top] as const)) : undefined;
      body.innerHTML = clubRowsHtml(base, view.season === open ? undefined : view.season, sortRows(s.rows, view.metric, view.dir), view.metric);
      if (before && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        for (const r of body.rows) {
          const was = before.get(r.dataset.key);
          if (was === undefined) continue;
          const dy = was - r.getBoundingClientRect().top;
          if (Math.abs(dy) > 0.5)
            r.animate([{ transform: `translateY(${dy}px)` }, { transform: "none" }], { duration: 200, easing: "cubic-bezier(0.23, 1, 0.32, 1)" });
        }
      }
      if (ratings) ratings.innerHTML = ratingsChart(plotOf(s), s.label);
      if (pace) pace.innerHTML = paceChart(plotOf(s), s.label);
      if (was) {
        slide(ratings, was[0]);
        slide(pace, was[1]);
      }
      // On a phone, the column group that holds the ranked column shows.
      const at = phoneGroup(view.metric);
      if (at >= 0 && groups[at]) groups[at].checked = true;
      history.replaceState(null, "", location.pathname + toQuery(view, open));
    };

    season.addEventListener("change", () => {
      view = { ...view, season: Number(season.value) };
      void paint(false, true);
    });
    // A new metric starts from its best end (lowest for defensive rating, highest for the rest).
    metric.addEventListener("change", () => {
      view = { ...view, metric: metric.value, dir: bestDir(metric.value) };
      void paint();
    });
    thead.addEventListener("click", (e) => {
      const button = (e.target as Element).closest<HTMLButtonElement>("button[data-sort]");
      if (!button) return;
      const key = button.dataset.sort!;
      // The same head again flips the order; another head starts from its best end.
      const dir = key === view.metric ? (view.dir === "desc" ? "asc" : "desc") : bestDir(key);
      view = { ...view, metric: key, dir };
      void paint(true);
      (thead.querySelector(`[data-sort="${key}"]`) as HTMLElement | null)?.focus({ preventScroll: true });
    });
    if (location.search) void paint();
  }
</script>

<style is:global>
  /* The scatter SVG is built in lib/scatter.ts and also swapped in by the season switch, so its
   * classes are global rather than scoped to this page. */
  .scatter {
    display: block;
    width: 100%;
    max-width: 460px;
    height: auto;
    overflow: visible;
  }
  .scatter .plot {
    fill: var(--surface);
  }
  .scatter .grid line {
    stroke: var(--rule);
    stroke-width: 1;
  }
  .scatter .ref {
    stroke: var(--ink-2);
    stroke-width: 1;
    stroke-dasharray: 4 4;
    opacity: 0.6;
  }
  .scatter .zero {
    stroke: var(--ink-2);
    stroke-width: 1;
    opacity: 0.35;
  }
  .scatter .tick,
  .scatter .axis {
    fill: var(--muted);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
  }
  .scatter .note {
    fill: var(--muted);
    font-size: 10px;
  }
  /* A club's mark: a two-tone disc (fills set in lib/scatter.ts) with a hairline edge in the ink, so a
   * dark or pale club reads on the paper and in dark mode. Hover and focus darken the edge. */
  .scatter .pt {
    cursor: default;
    outline: none;
  }
  .scatter .pt .edge {
    fill: none;
    stroke: var(--ink-2);
    stroke-width: 0.75;
    opacity: 0.55;
  }
  @media (hover: hover) and (pointer: fine) {
    .scatter .pt:hover .edge {
      stroke: var(--ink);
      stroke-width: 1.5;
      opacity: 1;
    }
  }
  .scatter .pt:focus-visible .edge {
    stroke: var(--data-1);
    stroke-width: 2;
    opacity: 1;
  }
</style>

<style>
  .code,
  .scroll :global(.code) {
    display: inline-block;
    width: 3.25em;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .clubs :global(td.strong) {
    color: var(--ink);
    font-weight: 600;
  }
  /* The sortable heads (lib/clubs.ts): a button that fills its cell, and the sorted column marked. */
  .clubs :global(thead button) {
    width: 100%;
    padding: 8px 0 8px 10px;
    border: 0;
    border-radius: 4px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: right;
    cursor: pointer;
  }
  .clubs :global(thead th.on),
  .clubs :global(thead th[aria-sort="ascending"]),
  .clubs :global(thead th[aria-sort="descending"]) {
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--ink);
  }
  .clubs :global(thead button:focus-visible) {
    outline: 2px solid var(--data-1);
    outline-offset: 2px;
  }
  @media (hover: hover) and (pointer: fine) {
    .clubs :global(thead button:hover) {
      color: var(--ink);
    }
  }
  .all {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 0 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .all a,
  .all .row {
    display: flex;
    align-items: baseline;
    gap: 4px;
    padding: 9px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    font-size: 0.875rem;
    text-decoration: none;
  }
  .all .nm {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .all .row {
    color: var(--ink-2);
  }
  .all .n {
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .all .t {
    min-width: 3.25em;
    color: var(--ink);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .all a:focus-visible {
    outline: 2px solid var(--data-1);
    outline-offset: 2px;
  }
  .charts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 48px 56px;
  }
  .panel {
    margin: 0;
    min-width: 0;
  }
  .cap {
    padding-bottom: 12px;
    margin-bottom: 14px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .cap h3 {
    font-size: 1.0625rem;
  }
  .cap p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 60ch;
  }
  @media (max-width: 560px) {
    /* Long club names wrap so the ranked column, Net by default, stays on screen. */
    .clubs tbody :global(th) {
      white-space: normal;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .all a:hover .nm {
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }
</style>
