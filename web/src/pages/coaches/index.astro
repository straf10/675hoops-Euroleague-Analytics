---
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import Base from "../../layouts/Base.astro";
import "../../styles/stats.css";
import {
  DEFAULT_METRIC,
  DEFAULT_SECTION,
  SECTIONS,
  SEASON_MIN_SAMPLE,
  coachCaption,
  coachHeadHtml,
  coachRowsHtml,
  coachViewFromQuery,
  namedSeasons,
  placementShown,
  seasonLabel,
  seasonOf,
  seasonRows,
  sortCoaches,
  type CoachSearchEntry,
  type CoachView,
} from "../../lib/coaches";
import { coachIndex, coachSeasons } from "../../lib/coach_files";

const index = await coachIndex();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const allRows = await coachSeasons();
// The season options: every season the box scores name coaches for, newest first.
const seasons = index ? namedSeasons(index.coverage) : [];
const firstLabel = seasons.length ? seasonLabel(seasons[seasons.length - 1]) : "";
const description =
  "EuroLeague head coaches season by season since the box scores name them: record, expected wins, placement, after-timeout scoring, clutch games, challenges and rotation.";

// The page opens on the current season (the latest one with coach rows).
const fallback = index?.current_season ?? seasons[0] ?? 0;
const through = index?.current_through ?? "";
const view: CoachView = { season: fallback, section: DEFAULT_SECTION, metric: DEFAULT_METRIC, dir: "desc" };
const rows = seasonRows(allRows, view.season, base);
const shown = sortCoaches(rows, view.metric, view.dir);
// The table's caption (for screen readers) names the season.
const title = `${seasonLabel(view.season)} EuroLeague coaches`;
// Placement is shown for completed seasons only: the open season has none yet.
const showsPlacement = placementShown(view.season, fallback);

// Every coach, any season, for the search box (the page script reads this list).
const entries: CoachSearchEntry[] = (index?.coaches ?? []).map((c) => ({
  name: c.name,
  href: `${base}/coaches/${c.slug}/`,
  seasons: c.seasons_played,
  clubs: c.clubs,
}));
const embedded = JSON.stringify(entries).replace(/</g, "\\u003c");
// Only the open season's rows are embedded; the season switch fetches the others (data/coaches/{season}.json).
const embeddedRows = JSON.stringify(seasonOf(allRows, view.season)).replace(/</g, "\\u003c");
const seasonsJson = JSON.stringify(seasons);
---

<Base title="EuroLeague coaches"description={description} current="coaches">
  <section class="wrap head" aria-labelledby="coaches-title">
    <h1 id="coaches-title">Coaches</h1>
    <p>
      Every EuroLeague coach the box scores name{firstLabel ? ` since ${firstLabel}` : ""}, current or
      not, season by season. Expected wins sum each game's pre-game Elo win probability.
    </p>
  </section>

  {
    !index ? (
      <section class="wrap">
        <p class="empty-state">
          The coach data has not been exported yet. Run <code>eurohoops export-stats</code> and
          rebuild.
        </p>
      </section>
    ) : (
      <section class="wrap">
        <div class="filters" role="group" aria-label="Filters">
          <div class="field find" role="search">
            <span id="coach-q-label">Find a coach</span>
            <div class="find-box">
              <input
                type="search"
                id="coach-q"
                aria-labelledby="coach-q-label"
                placeholder="Type part of a name"
                autocomplete="off"
                spellcheck="false"
                aria-controls="coach-results"
              />
              <button type="button" class="find-clear" id="coach-clear" aria-label="Clear search" hidden>×</button>
              <div class="find-panel" id="coach-panel">
                <p class="find-count" id="coach-count" aria-live="polite"></p>
                <ul class="find-results" id="coach-results"></ul>
                <noscript>
                  <p class="find-count">Search needs JavaScript. The table below links to every coach's page.</p>
                </noscript>
              </div>
            </div>
            <script type="application/json" id="coach-search" set:html={embedded} />
          </div>

          {rows.length > 0 && (
            <>
              <label class="field">
                <span>Season</span>
                <span class="select">
                  <select id="season" name="season" style="--select-w: 7.875rem">
                    {seasons.map((s) => (
                      <option value={s} selected={s === view.season}>
                        {seasonLabel(s)}
                      </option>
                    ))}
                  </select>
                  <span class="caret" set:html={caret} />
                </span>
              </label>
              <fieldset class="field">
                <legend>Section</legend>
                <div class="seg" role="radiogroup" aria-label="Column set">
                  {SECTIONS.map((s) => (
                    <>
                      <input
                        type="radio"
                        name="section"
                        id={`sec-${s.key}`}
                        value={s.key}
                        checked={s.key === view.section}
                      />
                      <label for={`sec-${s.key}`}>{s.label}</label>
                    </>
                  ))}
                </div>
              </fieldset>
            </>
          )}
        </div>

        {rows.length > 0 && (
          <>
            <p class="lede-sm">
              <span id="lede-count">{shown.length} {shown.length === 1 ? "coach" : "coaches"}</span> with games that season.
              {through && ` The latest season's box scores run through ${through}.`}{" "}
              Tap a heading to sort; tap it again to reverse.
            </p>
            <p class="coach-status" id="coach-status" role="status" hidden></p>
            <div
              class="scroll"
              id="coaches"
              data-base={base}
              data-seasons={seasonsJson}
              data-fallback={fallback}
            >
              <table class="grid coach-table">
                <caption class="sr-only">{coachCaption(view, title)}</caption>
                <thead set:html={coachHeadHtml(view, showsPlacement)} />
                <tbody set:html={coachRowsHtml(shown, view, showsPlacement)} />
              </table>
            </div>
            <p class="note">
              Rates need a minimum sample within the season: win %, players used, top 7 minutes and
              challenges per game {SEASON_MIN_SAMPLE.games} games; after timeout {SEASON_MIN_SAMPLE.possessions}{" "}
              possessions; clutch win % {SEASON_MIN_SAMPLE.clutch} clutch games. A figure below its
              sample is greyed and sorts last, as does a dash (no value: challenges start in 2021-22,
              and style needs a coach page). Placement is the furthest stage the season reached:
              play-in, playoffs, Final Four, runner-up or champion, counted from 2015-16 on, when the
              box scores name the coach. It is not shown for the season in progress. Clutch challenges
              count the challenges in the last 5:00 of the 4th quarter or overtime of clutch games.
              The club column lists every club the coach managed that season.
            </p>
            <script type="application/json" id="coach-rows" set:html={embeddedRows} />
          </>
        )}
      </section>
    )
  }
</Base>

<script>
  import {
    coachCaption,
    coachHeadHtml,
    coachRowsHtml,
    coachViewFromQuery,
    coachViewToQuery,
    searchCoaches,
    seasonLabel,
    seasonRange,
    seasonRows,
    sortCoaches,
    switchSection,
    switchSeason,
    placementShown,
    type CoachSearchEntry,
    type CoachSeasonRow,
    type CoachView,
    type SectionKey,
  } from "../../lib/coaches";

  const data = JSON.parse(document.getElementById("coach-search")?.textContent ?? "[]") as CoachSearchEntry[];
  const input = document.getElementById("coach-q") as HTMLInputElement | null;
  const list = document.getElementById("coach-results");
  const count = document.getElementById("coach-count");
  const panel = document.getElementById("coach-panel") as HTMLDivElement | null;
  const clear = document.getElementById("coach-clear") as HTMLButtonElement | null;
  // The results panel shows only while there is a query.
  if (panel) panel.hidden = true;

  function render() {
    if (!input || !list || !count || !panel) return;
    const hits = searchCoaches(data, input.value);
    list.replaceChildren(
      ...hits.map((c) => {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = c.href;
        link.textContent = c.name;
        const meta = document.createElement("span");
        meta.className = "meta";
        meta.textContent = `${seasonRange(c.seasons)} · ${c.clubs.join(" · ")}`;
        item.append(link, " ", meta);
        return item;
      }),
    );
    count.textContent =
      input.value.trim() === ""
        ? ""
        : hits.length === 0
          ? "No coach matches."
          : hits.length === 1
            ? "1 coach"
            : `${hits.length} coaches`;
    panel.hidden = input.value.trim() === "";
    if (clear) clear.hidden = input.value === "";
  }

  input?.addEventListener("input", render);
  clear?.addEventListener("click", () => {
    if (!input) return;
    input.value = "";
    input.dispatchEvent(new Event("input"));
    input.focus();
  });

  // The season select, the section buttons and the sortable heads redraw the table from the view, then write the view to the query string.
  const host = document.getElementById("coaches");
  const seasonSel = document.getElementById("season") as HTMLSelectElement | null;
  const sectionRadios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="section"]'));
  if (host && seasonSel && sectionRadios.length) {
    const base = host.dataset.base ?? "";
    const seasons = JSON.parse(host.dataset.seasons ?? "[]") as number[];
    const fallback = Number(host.dataset.fallback);
    const status = document.getElementById("coach-status")!;
    const lede = document.getElementById("lede-count");
    const caption = host.querySelector("caption")!;
    const thead = host.querySelector("thead")!;
    const body = host.querySelector("tbody")!;
    let view: CoachView = coachViewFromQuery(location.search, seasons, fallback);

    // The open season is embedded; each other season is fetched once and kept for the visit.
    const cache = new Map<number, CoachSeasonRow[]>([
      [fallback, JSON.parse(document.getElementById("coach-rows")?.textContent ?? "[]") as CoachSeasonRow[]],
    ]);
    const pending = new Map<number, Promise<CoachSeasonRow[] | undefined>>();
    const loadSeason = (n: number): Promise<CoachSeasonRow[] | undefined> => {
      const have = cache.get(n);
      if (have) return Promise.resolve(have);
      let request = pending.get(n);
      if (!request) {
        request = fetch(`${base}/data/coaches/${n}.json`)
          .then((r) => (r.ok ? (r.json() as Promise<CoachSeasonRow[]>) : undefined))
          .then((rows) => {
            if (rows) cache.set(n, rows);
            return rows;
          })
          .catch(() => undefined)
          .finally(() => pending.delete(n));
        pending.set(n, request);
      }
      return request;
    };

    // Redraws the table, the caption and the count from the view, then writes the view to the query string.
    // A season already held draws at once (the sorted head keeps focus); a season being fetched shows a
    // loading line until it arrives, and a later switch wins over an earlier fetch.
    const draw = (all: CoachSeasonRow[]) => {
      const rows = sortCoaches(seasonRows(all, view.season, base), view.metric, view.dir);
      const heading = `${seasonLabel(view.season)} EuroLeague coaches`;
      status.hidden = true;
      host.removeAttribute("aria-busy");
      seasonSel.value = String(view.season);
      for (const radio of sectionRadios) radio.checked = radio.value === view.section;
      caption.textContent = coachCaption(view, heading);
      const shows = placementShown(view.season, fallback);
      thead.innerHTML = coachHeadHtml(view, shows);
      body.innerHTML = coachRowsHtml(rows, view, shows);
      if (lede) lede.textContent = `${rows.length} ${rows.length === 1 ? "coach" : "coaches"}`;
      history.replaceState(null, "", location.pathname + coachViewToQuery(view, fallback));
    };
    const paint = () => {
      const wanted = view.season;
      const held = cache.get(wanted);
      if (held) return draw(held);
      status.hidden = false;
      status.textContent = `Loading the ${seasonLabel(wanted)} coaches…`;
      host.setAttribute("aria-busy", "true");
      void loadSeason(wanted).then((all) => {
        if (view.season !== wanted) return; // a later switch has taken over
        if (all) return draw(all);
        status.textContent = `The ${seasonLabel(wanted)} coaches could not be loaded. Try again.`;
        host.removeAttribute("aria-busy");
      });
    };

    seasonSel.addEventListener("change", () => {
      view = switchSeason(view, Number(seasonSel.value), fallback);
      paint();
    });
    for (const radio of sectionRadios) {
      radio.addEventListener("change", () => {
        view = switchSection(view, radio.value as SectionKey, placementShown(view.season, fallback));
        paint();
      });
    }
    // The same head again flips the order; another head starts from the highest figure.
    thead.addEventListener("click", (e) => {
      const button = (e.target as Element).closest<HTMLButtonElement>("button[data-sort]");
      if (!button) return;
      const key = button.dataset.sort!;
      const dir = key === view.metric ? (view.dir === "desc" ? "asc" : "desc") : "desc";
      view = { ...view, metric: key, dir };
      paint();
      (thead.querySelector(`[data-sort="${key}"]`) as HTMLElement | null)?.focus({ preventScroll: true });
    });
    if (location.search) paint();
  }
</script>

<style>
  /* Title block and filter bar: the same spacing and rules as the players page. */
  .head p {
    margin-top: 10px;
    max-width: 64ch;
    color: var(--ink-2);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 14px 20px;
    margin: 32px 0 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--rule);
  }

  /* The search sits inline with the other controls, its results in a panel beneath it. */
  .find {
    position: relative;
  }
  .find-box {
    position: relative;
    width: 16rem;
    max-width: 100%;
  }
  .find input[type="search"] {
    appearance: none;
    display: block;
    width: 100%;
    height: 32px;
    padding: 0 32px 0 10px;
    border: 0;
    border-radius: 8px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    color: var(--ink);
    font: 500 0.8125rem/1 var(--font);
    transition: box-shadow 150ms ease;
  }
  input[type="search"]::placeholder {
    color: var(--muted);
  }
  input[type="search"]::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
    display: none;
  }
  .find-clear {
    position: absolute;
    top: 50%;
    right: 4px;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    color: var(--muted);
    font: 400 1.125rem/1 var(--font);
    cursor: pointer;
  }
  .find-clear[hidden] {
    display: none;
  }
  .find-clear:focus-visible {
    outline: 2px solid var(--data-1);
    outline-offset: 1px;
  }
  @media (hover: hover) and (pointer: fine) {
    .find-clear:hover {
      color: var(--ink);
    }
  }
  input[type="search"]:focus-visible {
    outline: 2px solid var(--data-1);
    outline-offset: 1px;
  }
  @media (hover: hover) and (pointer: fine) {
    .find input[type="search"]:hover {
      box-shadow: inset 0 0 0 1px var(--ink-2);
    }
  }
  .find-panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    z-index: 5;
    width: max(100%, 18rem);
    max-width: min(24rem, calc(100vw - 32px));
    max-height: 60vh;
    overflow-y: auto;
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--surface);
    box-shadow:
      0 0 0 1px var(--rule-strong),
      0 8px 24px rgb(17 17 16 / 0.08);
  }
  .find-panel[hidden] {
    display: none;
  }
  .find-count {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .find-results {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .find-results:empty {
    display: none;
  }
  .find-results a {
    color: var(--ink);
    font-weight: 550;
    text-decoration: none;
  }
  .find-results .meta {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .find-results a:hover {
      text-decoration: underline;
    }
  }

  .lede-sm {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 68ch;
  }
  .coach-status {
    margin: 0 0 10px;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  /* The table fits the content width on desktop: headers and the coach name wrap instead of widening it,
     and the cells take less padding. A phone still scrolls the table inside .scroll. */
  .coach-table.grid :global(th),
  .coach-table.grid :global(td) {
    white-space: normal;
    padding-left: 10px;
  }
  .coach-table.grid :global(th:first-child),
  .coach-table.grid :global(td:first-child) {
    padding-left: 0;
  }
  /* The table is built in lib/coaches.ts (and redrawn by the page script): its classes are global. */
  .coach-table :global(td.club) {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .coach-table :global(td.strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .coach-table :global(td.thin) {
    color: var(--muted);
  }
  .coach-table :global(thead th) {
    vertical-align: bottom;
  }
  .coach-table :global(thead .head) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  /* The sortable heads: a button that fills its cell, and the sorted column marked. */
  .coach-table :global(thead button[data-sort]) {
    padding: 8px 0 8px 10px;
    border: 0;
    border-radius: 4px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: right;
    cursor: pointer;
  }
  .coach-table :global(thead th.on),
  .coach-table :global(thead th[aria-sort="ascending"]),
  .coach-table :global(thead th[aria-sort="descending"]) {
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--ink);
  }
  .coach-table :global(thead button:focus-visible) {
    outline: 2px solid var(--data-1);
    outline-offset: 2px;
  }
  .coach-table :global(thead .info-tip) {
    margin-left: 0;
  }
  /* The last head's ? hit area reaches 6px past the table's right edge and widened it; it reaches left instead. */
  .coach-table :global(thead .info-tip::after) {
    inset: -6px 0 -6px -6px;
  }
  @media (hover: hover) and (pointer: fine) {
    .coach-table :global(thead button[data-sort]:hover) {
      color: var(--ink);
    }
  }
</style>
