---
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import Base from "../../layouts/Base.astro";
import "../../styles/stats.css";
import {
  DEFAULT_METRIC,
  DEFAULT_SECTION,
  SECTIONS,
  SEASON_MIN_SAMPLE,
  coachCaption,
  coachHeadHtml,
  coachRowsHtml,
  coachViewFromQuery,
  namedSeasons,
  seasonLabel,
  seasonRows,
  sortCoaches,
  type CoachSearchEntry,
  type CoachView,
} from "../../lib/coaches";
import { coachIndex, coachSeasons } from "../../lib/coach_files";

const index = await coachIndex();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const allRows = await coachSeasons();
// The season options: every season the box scores name coaches for, newest first.
const seasons = index ? namedSeasons(index.coverage) : [];
const firstLabel = seasons.length ? seasonLabel(seasons[seasons.length - 1]) : "";
const description =
  "EuroLeague head coaches season by season since the box scores name them: record, expected wins, finish, after-timeout scoring, clutch games, challenges and rotation.";

// The page opens on the current season (the latest one with coach rows).
const fallback = index?.current_season ?? seasons[0] ?? 0;
const through = index?.current_through ?? "";
const view: CoachView = { season: fallback, section: DEFAULT_SECTION, metric: DEFAULT_METRIC, dir: "desc" };
const rows = seasonRows(allRows, view.season, base);
const shown = sortCoaches(rows, view.metric, view.dir);
const title = `${seasonLabel(view.season)} EuroLeague coaches`;

// Every coach, any season, for the search box (the page script reads this list).
const entries: CoachSearchEntry[] = (index?.coaches ?? []).map((c) => ({
  name: c.name,
  href: `${base}/coaches/${c.slug}/`,
  seasons: c.seasons_played,
  clubs: c.clubs,
}));
const embedded = JSON.stringify(entries).replace(/</g, "\\u003c");
const embeddedRows = JSON.stringify(allRows).replace(/</g, "\\u003c");
const seasonsJson = JSON.stringify(seasons);
---

<Base title="Coaches" description={description} current="coaches">
  <section class="wrap head" aria-labelledby="coaches-title">
    <h1 id="coaches-title">Coaches</h1>
    <p>
      Every EuroLeague coach the box scores name{firstLabel ? `, from ${firstLabel} on` : ""}, season
      by season. Expected wins sum each game's pre-game Elo win probability.
    </p>
  </section>

  {
    !index ? (
      <section class="wrap">
        <p class="empty-state">
          The coach data has not been exported yet. Run <code>eurohoops export-stats</code> and
          rebuild.
        </p>
      </section>
    ) : (
      <>
        <section class="wrap band" aria-labelledby="find-title">
          <header class="sec-head">
            <h2 id="find-title">Find a coach</h2>
            <p>Every coach since {firstLabel || "the box scores name them"}, current or not.</p>
          </header>
          <div class="find" role="search">
            <label class="find-label" for="coach-q">Coach name</label>
            <input
              type="search"
              id="coach-q"
              placeholder="Type part of a name"
              autocomplete="off"
              spellcheck="false"
              aria-controls="coach-results"
            />
          </div>
          <p class="find-count" id="coach-count" aria-live="polite"></p>
          <ul class="find-results" id="coach-results"></ul>
          <noscript>
            <p class="find-count">Search needs JavaScript. The season table below links to every coach's page.</p>
          </noscript>
          <script type="application/json" id="coach-search" set:html={embedded} />
        </section>

        {rows.length > 0 && (
          <section class="wrap band" aria-labelledby="table-title">
            <header class="sec-head split">
              <h2 id="table-title">{title}</h2>
              <div class="filters">
                <label class="field">
                  <span>Season</span>
                  <span class="select">
                    <select id="season" name="season" style="--select-w: 7.875rem">
                      {seasons.map((s) => (
                        <option value={s} selected={s === view.season}>
                          {seasonLabel(s)}
                        </option>
                      ))}
                    </select>
                    <span class="caret" set:html={caret} />
                  </span>
                </label>
                <label class="field">
                  <span>Section</span>
                  <span class="select">
                    <select id="section" name="section" style="--select-w: 9.5rem">
                      {SECTIONS.map((s) => (
                        <option value={s.key} selected={s.key === view.section}>
                          {s.label}
                        </option>
                      ))}
                    </select>
                    <span class="caret" set:html={caret} />
                  </span>
                </label>
              </div>
            </header>
            <p class="lede-sm">
              {shown.length} {shown.length === 1 ? "coach" : "coaches"} with games that season.
              {through && ` The latest season's box scores run through ${through}.`}{" "}
              Tap a heading to sort; tap it again to reverse.
            </p>
            <div
              class="scroll"
              id="coaches"
              data-base={base}
              data-seasons={seasonsJson}
              data-fallback={fallback}
            >
              <table class="grid coach-table">
                <caption class="sr-only">{coachCaption(view, title)}</caption>
                <thead set:html={coachHeadHtml(view)} />
                <tbody set:html={coachRowsHtml(shown, view)} />
              </table>
            </div>
            <p class="note">
              Rates need a minimum sample within the season: win %, players used, top 7 minutes and
              challenges {SEASON_MIN_SAMPLE.games} games; after timeout {SEASON_MIN_SAMPLE.possessions}{" "}
              possessions; clutch win % {SEASON_MIN_SAMPLE.clutch} clutch games. A figure below its
              sample is greyed and sorts last, as does a dash (no value: challenges start in 2021-22,
              and style needs a coach page). Finish is the furthest stage the season reached; playoffs,
              Final Four and titles are counted from 2015-16 on, when the box scores name the coach.
              The club column lists every club the coach managed that season.
            </p>
            <script type="application/json" id="coach-rows" set:html={embeddedRows} />
          </section>
        )}
      </>
    )
  }
</Base>

<script>
  import {
    SECTIONS,
    coachCaption,
    coachHeadHtml,
    coachRowsHtml,
    coachViewFromQuery,
    coachViewToQuery,
    searchCoaches,
    seasonLabel,
    seasonRange,
    seasonRows,
    sortCoaches,
    switchSection,
    type CoachSearchEntry,
    type CoachSeasonRow,
    type CoachView,
    type SectionKey,
  } from "../../lib/coaches";

  const data = JSON.parse(document.getElementById("coach-search")?.textContent ?? "[]") as CoachSearchEntry[];
  const input = document.getElementById("coach-q") as HTMLInputElement | null;
  const list = document.getElementById("coach-results");
  const count = document.getElementById("coach-count");

  function render() {
    if (!input || !list || !count) return;
    const hits = searchCoaches(data, input.value);
    list.replaceChildren(
      ...hits.map((c) => {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = c.href;
        link.textContent = c.name;
        const meta = document.createElement("span");
        meta.className = "meta";
        meta.textContent = `${seasonRange(c.seasons)} · ${c.clubs.join(" · ")}`;
        item.append(link, " ", meta);
        return item;
      }),
    );
    count.textContent =
      input.value.trim() === ""
        ? ""
        : hits.length === 0
          ? "No coach matches."
          : hits.length === 1
            ? "1 coach"
            : `${hits.length} coaches`;
  }

  input?.addEventListener("input", render);

  // The season and section selects and the sortable heads redraw the table from the view, then write the view to the query string.
  const host = document.getElementById("coaches");
  const seasonSel = document.getElementById("season") as HTMLSelectElement | null;
  const sectionSel = document.getElementById("section") as HTMLSelectElement | null;
  const title = document.getElementById("table-title");
  if (host && seasonSel && sectionSel && title) {
    const all = JSON.parse(document.getElementById("coach-rows")?.textContent ?? "[]") as CoachSeasonRow[];
    const base = host.dataset.base ?? "";
    const seasons = JSON.parse(host.dataset.seasons ?? "[]") as number[];
    const fallback = Number(host.dataset.fallback);
    const caption = host.querySelector("caption")!;
    const thead = host.querySelector("thead")!;
    const body = host.querySelector("tbody")!;
    let view: CoachView = coachViewFromQuery(location.search, seasons, fallback);

    const paint = () => {
      const heading = `${seasonLabel(view.season)} EuroLeague coaches`;
      seasonSel.value = String(view.season);
      sectionSel.value = view.section;
      title.textContent = heading;
      caption.textContent = coachCaption(view, heading);
      thead.innerHTML = coachHeadHtml(view);
      body.innerHTML = coachRowsHtml(sortCoaches(seasonRows(all, view.season, base), view.metric, view.dir), view);
      history.replaceState(null, "", location.pathname + coachViewToQuery(view, fallback));
    };

    seasonSel.addEventListener("change", () => {
      view = { ...view, season: Number(seasonSel.value) };
      paint();
    });
    sectionSel.addEventListener("change", () => {
      view = switchSection(view, sectionSel.value as SectionKey);
      paint();
    });
    // The same head again flips the order; another head starts from the highest figure.
    thead.addEventListener("click", (e) => {
      const button = (e.target as Element).closest<HTMLButtonElement>("button[data-sort]");
      if (!button) return;
      const key = button.dataset.sort!;
      const dir = key === view.metric ? (view.dir === "desc" ? "asc" : "desc") : "desc";
      view = { ...view, metric: key, dir };
      paint();
      (thead.querySelector(`[data-sort="${key}"]`) as HTMLElement | null)?.focus({ preventScroll: true });
    });
    if (location.search) paint();
  }
</script>

<style>
  .find {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 420px;
  }
  .find-label {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  input[type="search"] {
    appearance: none;
    width: 100%;
    height: 36px;
    padding: 0 10px;
    border: 0;
    border-radius: 8px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    color: var(--ink);
    font: 500 0.875rem/1 var(--font);
  }
  input[type="search"]::placeholder {
    color: var(--muted);
  }
  input[type="search"]::-webkit-search-cancel-button {
    display: none;
  }
  .find-count {
    margin: 12px 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .find-results {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .find-results a {
    color: var(--ink);
    font-weight: 550;
    text-decoration: none;
  }
  .find-results .meta {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .find-results a:hover {
      text-decoration: underline;
    }
  }
</style>

<style>
  .lede-sm {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 68ch;
  }
  /* The table is built in lib/coaches.ts (and redrawn by the page script): its classes are global. */
  .coach-table :global(td.club) {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .coach-table :global(td.strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .coach-table :global(td.thin) {
    color: var(--muted);
  }
  .coach-table :global(thead th) {
    vertical-align: bottom;
  }
  .coach-table :global(thead .head) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  /* The sortable heads: a button that fills its cell, and the sorted column marked. */
  .coach-table :global(thead button[data-sort]) {
    padding: 8px 0 8px 10px;
    border: 0;
    border-radius: 4px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: right;
    cursor: pointer;
  }
  .coach-table :global(thead th.on),
  .coach-table :global(thead th[aria-sort="ascending"]),
  .coach-table :global(thead th[aria-sort="descending"]) {
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--ink);
  }
  .coach-table :global(thead button:focus-visible) {
    outline: 2px solid var(--data-1);
    outline-offset: 2px;
  }
  .coach-table :global(thead .info-tip) {
    margin-left: 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .coach-table :global(thead button[data-sort]:hover) {
      color: var(--ink);
    }
  }
</style>
