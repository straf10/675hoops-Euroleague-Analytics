---
import caret from "@phosphor-icons/core/assets/bold/caret-down-bold.svg?raw";
import Base from "../../layouts/Base.astro";
import "../../styles/stats.css";
import {
  DEFAULT_METRIC,
  MIN_SAMPLE,
  coachCaption,
  coachHeadHtml,
  coachRows,
  coachRowsHtml,
  coachViewFromQuery,
  scopeRows,
  seasonRange,
  sortCoaches,
  type CoachRow,
  type CoachSearchEntry,
  type CoachView,
  type Scope,
} from "../../lib/coaches";
import { coachIndex, coachStyles } from "../../lib/coach_files";

const index = await coachIndex();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// The first season in which most games name their coaches (2014-15 has a single named side).
const named = index ? index.coverage.filter((c) => 2 * c.with_coach >= c.games) : [];
const first = named.length ? Math.min(...named.map((c) => c.season)) : null;
const firstLabel = first === null ? "" : seasonRange([first]);
const description =
  "EuroLeague head coaches since the box scores name them: record, playoffs, and coaching style such as after-timeout scoring, clutch games, rotation and challenges.";

const season = index?.current_season ?? null;
const through = index?.current_through ?? "";
const currentTitle = season === null ? "" : `${seasonRange([season])} EuroLeague coaches`;
const allTitle = `All coaches${firstLabel ? ` since ${firstLabel}` : ""}`;
// Every coach with the figures the table sorts by (career); the style figures come from each coach's page.
const rows: CoachRow[] = index
  ? coachRows(index, await coachStyles(index.coaches.map((c) => c.slug)), base)
  : [];
// The page opens on this season's coaches, or on every coach when no season is published.
const fallback: Scope = season === null ? "all" : "current";
const view: CoachView = { scope: fallback, metric: DEFAULT_METRIC, dir: "desc" };
const shown = sortCoaches(scopeRows(rows, view.scope), view.metric, view.dir);
const shownTitle = view.scope === "all" ? allTitle : currentTitle;
// Every coach, any season, for the search box (the page script reads this list).
const entries: CoachSearchEntry[] = (index?.coaches ?? []).map((c) => ({
  name: c.name,
  href: `${base}/coaches/${c.slug}/`,
  seasons: c.seasons_played,
  clubs: c.clubs,
}));
const embedded = JSON.stringify(entries).replace(/</g, "\\u003c");
const embeddedRows = JSON.stringify(rows).replace(/</g, "\\u003c");
---

<Base title="EuroLeague coaches"description={description} current="coaches">
  <section class="wrap head" aria-labelledby="coaches-title">
    <h1 id="coaches-title">Coaches</h1>
    <p>
      Every EuroLeague coach the box scores name{firstLabel ? `, from ${firstLabel} on` : ""}. Wins
      above expectation is wins minus the sum of each game's pre-game Elo win probability.
    </p>
  </section>

  {
    !index ? (
      <section class="wrap">
        <p class="empty-state">
          The coach data has not been exported yet. Run <code>eurohoops export-stats</code> and
          rebuild.
        </p>
      </section>
    ) : (
      <>
        <section class="wrap band" aria-labelledby="find-title">
          <header class="sec-head">
            <h2 id="find-title">Find a coach</h2>
            <p>Every coach since {firstLabel || "the box scores name them"}, current or not.</p>
          </header>
          <div class="find" role="search">
            <label class="find-label" for="coach-q">Coach name</label>
            <input
              type="search"
              id="coach-q"
              placeholder="Type part of a name"
              autocomplete="off"
              spellcheck="false"
              aria-controls="coach-results"
            />
          </div>
          <p class="find-count" id="coach-count" aria-live="polite"></p>
          <ul class="find-results" id="coach-results"></ul>
          <noscript>
            <p class="find-count">Search needs JavaScript. The current coaches below link to their pages.</p>
          </noscript>
          <script type="application/json" id="coach-search" set:html={embedded} />
        </section>

        {rows.length > 0 && (
          <section class="wrap band" aria-labelledby="table-title">
            <header class="sec-head split">
              <h2 id="table-title">{shownTitle}</h2>
              <div class="filters">
                <label class="field">
                  <span>Show</span>
                  <span class="select">
                    <select id="scope" name="scope" style="--select-w: 11.5rem">
                      <option value="current" selected={view.scope === "current"}>
                        This season's coaches
                      </option>
                      <option value="all" selected={view.scope === "all"}>All coaches</option>
                    </select>
                    <span class="caret" set:html={caret} />
                  </span>
                </label>
              </div>
            </header>
            <p class="lede-sm">
              Career EuroLeague figures from the box scores that name each coach.
              {through && ` This season's coaches are the coach of each club's latest game, through ${through}.`}
              {" "}Tap a heading to sort; tap it again to reverse.
            </p>
            <div
              class="scroll"
              id="coaches"
              data-current-title={currentTitle}
              data-all-title={allTitle}
              data-fallback={fallback}
            >
              <table class="grid coach-table">
                <caption class="sr-only">{coachCaption(view, shownTitle)}</caption>
                <thead set:html={coachHeadHtml(view)} />
                <tbody set:html={coachRowsHtml(shown, view.metric)} />
              </table>
            </div>
            <p class="note">
              Rates need a minimum sample: win % {MIN_SAMPLE.games} games; after timeout{" "}
              {MIN_SAMPLE.possessions} possessions; clutch win % {MIN_SAMPLE.clutch} clutch games;
              players used and top 7 minutes {MIN_SAMPLE.games} games; challenges {MIN_SAMPLE.games}{" "}
              games. A figure below its sample is greyed and sorts last, as does a dash (no value:
              challenges start in 2021-22, and style needs a coach page). League figures over the
              same seasons are on each coach's page. Playoffs, Final Four and titles are counted from
              2015-16 on, when the box scores name the coach; earlier seasons are not counted.
            </p>
            <script type="application/json" id="coach-rows" set:html={embeddedRows} />
          </section>
        )}
      </>
    )
  }
</Base>

<script>
  import {
    coachCaption,
    coachHeadHtml,
    coachRowsHtml,
    coachViewFromQuery,
    coachViewToQuery,
    scopeRows,
    searchCoaches,
    seasonRange,
    sortCoaches,
    type CoachRow,
    type CoachSearchEntry,
    type CoachView,
    type Scope,
  } from "../../lib/coaches";

  const data = JSON.parse(document.getElementById("coach-search")?.textContent ?? "[]") as CoachSearchEntry[];
  const input = document.getElementById("coach-q") as HTMLInputElement | null;
  const list = document.getElementById("coach-results");
  const count = document.getElementById("coach-count");

  function render() {
    if (!input || !list || !count) return;
    const hits = searchCoaches(data, input.value);
    list.replaceChildren(
      ...hits.map((c) => {
        const item = document.createElement("li");
        const link = document.createElement("a");
        link.href = c.href;
        link.textContent = c.name;
        const meta = document.createElement("span");
        meta.className = "meta";
        meta.textContent = `${seasonRange(c.seasons)} · ${c.clubs.join(" · ")}`;
        item.append(link, " ", meta);
        return item;
      }),
    );
    count.textContent =
      input.value.trim() === ""
        ? ""
        : hits.length === 0
          ? "No coach matches."
          : hits.length === 1
            ? "1 coach"
            : `${hits.length} coaches`;
  }

  input?.addEventListener("input", render);

  // The scope switch and the sortable heads redraw the table from the view, then write the view to the query string.
  const host = document.getElementById("coaches");
  const scope = document.getElementById("scope") as HTMLSelectElement | null;
  const title = document.getElementById("table-title");
  if (host && scope && title) {
    const rows = JSON.parse(document.getElementById("coach-rows")?.textContent ?? "[]") as CoachRow[];
    const fallback = (host.dataset.fallback ?? "current") as Scope;
    const caption = host.querySelector("caption")!;
    const thead = host.querySelector("thead")!;
    const body = host.querySelector("tbody")!;
    let view: CoachView = coachViewFromQuery(location.search, fallback);

    const paint = () => {
      const heading = view.scope === "all" ? host.dataset.allTitle ?? "" : host.dataset.currentTitle ?? "";
      scope.value = view.scope;
      title.textContent = heading;
      caption.textContent = coachCaption(view, heading);
      thead.innerHTML = coachHeadHtml(view);
      body.innerHTML = coachRowsHtml(sortCoaches(scopeRows(rows, view.scope), view.metric, view.dir), view.metric);
      history.replaceState(null, "", location.pathname + coachViewToQuery(view, fallback));
    };

    scope.addEventListener("change", () => {
      view = { ...view, scope: scope.value as Scope };
      paint();
    });
    // The same head again flips the order; another head starts from the highest figure.
    thead.addEventListener("click", (e) => {
      const button = (e.target as Element).closest<HTMLButtonElement>("button[data-sort]");
      if (!button) return;
      const key = button.dataset.sort!;
      const dir = key === view.metric ? (view.dir === "desc" ? "asc" : "desc") : "desc";
      view = { ...view, metric: key, dir };
      paint();
      (thead.querySelector(`[data-sort="${key}"]`) as HTMLElement | null)?.focus({ preventScroll: true });
    });
    if (location.search) paint();
  }
</script>

<style>
  .find {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 420px;
  }
  .find-label {
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  input[type="search"] {
    appearance: none;
    width: 100%;
    height: 36px;
    padding: 0 10px;
    border: 0;
    border-radius: 8px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--rule-strong);
    color: var(--ink);
    font: 500 0.875rem/1 var(--font);
  }
  input[type="search"]::placeholder {
    color: var(--muted);
  }
  input[type="search"]::-webkit-search-cancel-button {
    display: none;
  }
  .find-count {
    margin: 12px 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .find-results {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .find-results a {
    color: var(--ink);
    font-weight: 550;
    text-decoration: none;
  }
  .find-results .meta {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  @media (hover: hover) and (pointer: fine) {
    .find-results a:hover {
      text-decoration: underline;
    }
  }
</style>

<style>
  .lede-sm {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 68ch;
  }
  /* The table is built in lib/coaches.ts (and redrawn by the page script): its classes are global. */
  .coach-table :global(td.now) {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .coach-table :global(td.strong) {
    color: var(--ink);
    font-weight: 600;
  }
  .coach-table :global(td.thin) {
    color: var(--muted);
  }
  .coach-table :global(thead th) {
    vertical-align: bottom;
  }
  .coach-table :global(thead .head) {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }
  /* The sortable heads: a button that fills its cell, and the sorted column marked. */
  .coach-table :global(thead button[data-sort]) {
    padding: 8px 0 8px 10px;
    border: 0;
    border-radius: 4px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: right;
    cursor: pointer;
  }
  .coach-table :global(thead th.on),
  .coach-table :global(thead th[aria-sort="ascending"]),
  .coach-table :global(thead th[aria-sort="descending"]) {
    color: var(--ink);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--ink);
  }
  .coach-table :global(thead button:focus-visible) {
    outline: 2px solid var(--data-1);
    outline-offset: 2px;
  }
  .coach-table :global(thead .info-tip) {
    margin-left: 0;
  }
  @media (hover: hover) and (pointer: fine) {
    .coach-table :global(thead button[data-sort]:hover) {
      color: var(--ink);
    }
  }
</style>
