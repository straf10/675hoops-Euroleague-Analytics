---
import Base from "../layouts/Base.astro";
import BrierByRound from "../components/BrierByRound.astro";
import Ratings from "../components/Ratings.astro";
import MarginChart, { type MarginGame } from "../components/MarginChart.astro";
import TrendChart from "../components/TrendChart.astro";
import Matchday from "../components/Matchday.astro";
import GamesJsonLd from "../components/GamesJsonLd.astro";
import raw from "../data/site.json";
import type { SiteData } from "../lib/format";
import { share, score3, type TrendPoint } from "../lib/forecasts";
import { headlineNumbers } from "../lib/volume";

const data = raw as SiteData;
const comps = data.competitions;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const description =
  "EuroLeague win forecasts, logged before tip-off and scored against a home-win baseline.";

// The headline is the published model's record on the games it called before tip-off, the same
// figures as the forecast record page.
const main = comps[0];
const fc = main.forecasts;
const model = fc ? (fc.published ?? fc.models[0]?.key) : undefined;
const label = fc?.models.find((m) => m.key === model)?.label ?? "Our forecast";
const ours = fc?.season.find((r) => r.model === model) ?? null;
const live = main.scorecard;
const nums = headlineNumbers(data.data_volume);

// The running win-chance edge, from the record (eval/forecasts.py _trend), with the origin first.
const trend = fc?.trend ?? [];
const logloss: TrendPoint[] = [
  { n: 0, label: "", baseline: 0 },
  ...trend.map((t) => ({ n: t.n, label: t.label, baseline: t.logloss.baseline })),
];
// The points comparison: each finished game's predicted home margin and the final one, in order.
const finished = [...(fc?.games ?? [])].reverse().filter((g) => model && g.models[model]);
const margins: MarginGame[] = finished.map((g, i) => ({
  n: i + 1,
  label: `${g.home.code} ${g.home_score}-${g.away_score} ${g.away.code}`,
  predicted: g.models[model!]!.exp_margin,
  actual: g.home_score - g.away_score,
}));
const games = finished.length;
const homeWins = (fc?.games ?? []).filter((g) => model && g.models[model] && g.home_score > g.away_score).length;
// Same games, two ways.
const b0 = live.b0;
const scoreRows = [
  ours && { name: label, n: ours.n, hit: share(ours.right_pct), brier: score3(ours.brier), log: score3(ours.log_loss) },
  games > 0 && {
    name: "Home-win baseline",
    n: b0?.n ?? games,
    hit: share(homeWins / games),
    brier: score3(b0?.brier ?? null),
    log: score3(b0?.log_loss ?? null),
  },
].filter(Boolean) as { name: string; n: number; hit: string; brier: string; log: string }[];
---

<Base title="EuroLeague 2026-27 win forecasts" description={description} current="forecasts">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "6.75 Analytics",
    url: "https://675hoops.com/",
    description,
  })} />
  <GamesJsonLd slot="head" />

  <section class="numbers wrap" aria-label="How much data is behind the forecasts">
    <p class="figures">
      <span><b>{nums.seasons}</b> seasons</span>
      <span class="sep" aria-hidden="true">·</span>
      <span><b>{nums.games}</b> games</span>
      {
        nums.actions && (
          <>
            <span class="sep" aria-hidden="true">·</span>
            <span><b>{nums.actions}</b> actions</span>
          </>
        )
      }
    </p>
    <p class="scope">EuroLeague only. An action is one play-by-play entry.</p>
  </section>

  <header class="page-head wrap">
    <h1>Forecasts</h1>
    <p class="links">
      <a href={`${base}/methodology/`}>How it works</a>
      {" · "}
      <a href={`${base}/forecasts/`}>Full forecast record</a>
    </p>
  </header>

  <section class="band wrap" id="matchday" aria-labelledby="matchday-title">
    <header class="sec-head">
      <h2 id="matchday-title">Matchday</h2>
      <p>Our chance for each game before tip-off, then the result and whether the pick held.</p>
    </header>
    {comps.map((c) => <Matchday comp={c} />)}
  </section>

  <section class="band wrap" id="ratings" aria-labelledby="ratings-title">
    <header class="sec-head">
      <h2 id="ratings-title">Power ratings</h2>
      <p>Each team's rating this season, and how far it has moved since the season began.</p>
    </header>
    {comps.map((c) => <Ratings comp={c} />)}
  </section>

  <section class="band wrap" id="scoring" aria-labelledby="scoring-title">
    <header class="sec-head">
      <h2 id="scoring-title">How the model scores</h2>
      <p>The same finished games, three scores: hit rate (higher is better), Brier and log loss (lower is better).</p>
    </header>
    <table class="score-table">
      <caption class="sr-only">Forecast scores on the same games</caption>
      <thead>
        <tr>
          <th scope="col">Forecast</th>
          <th scope="col" class="num">Games</th>
          <th scope="col" class="num">Called right</th>
          <th scope="col" class="num">Brier</th>
          <th scope="col" class="num">Log loss</th>
        </tr>
      </thead>
      <tbody>
        {
          scoreRows.map((r, i) => (
            <tr class={i === 0 ? "ours" : undefined}>
              <th scope="row">{r.name}</th>
              <td class="num">{r.n}</td>
              <td class="num">{r.hit}</td>
              <td class="num">{r.brier}</td>
              <td class="num">{r.log}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    {comps.map((c) => <BrierByRound comp={c} />)}

    {
      games > 0 && (
        <div class="trend-wrap">
          <TrendChart
            id="trend-logloss"
            title="Win chances"
            caption="How much better each forecast's chance was than the baseline's (a home-win pick), summed game by game. Log loss: lower loss per game is better."
            unit="log loss, summed"
            digits={2}
            points={logloss}
            better="Above 0 = model ahead"
          />
          <MarginChart
            id="margin-points"
            title="Points"
            caption="Each game's predicted home margin (orange line) against the final home margin (grey bars), in tip-off order. Where the line meets the top of a bar, the model called the margin exactly."
            games={margins}
            miss={fc?.season.find((r) => r.model === model)?.margin_mae ?? null}
            better="Closer = better"
          />
        </div>
      )
    }
  </section>

  <p class="wrap more"><a href={`${base}/forecasts/#every-game`}>Read the log</a></p>
</Base>

<style>
  .numbers {
    padding-top: 56px;
  }
  .figures {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    font-size: 1.125rem;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .figures b {
    font-size: 2.5rem;
    font-weight: 620;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--ink);
    margin-right: 4px;
  }
  .sep {
    color: var(--rule-strong);
  }
  .scope {
    margin-top: 10px;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .page-head {
    padding-top: 64px;
  }
  h1 {
    font-size: 2.75rem;
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 620;
  }
  .links {
    margin-top: 12px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .links a {
    color: var(--ink-2);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 3px;
  }
  .band {
    padding-top: 88px;
  }
  .sec-head {
    margin-bottom: 28px;
  }
  .sec-head p {
    margin-top: 6px;
    color: var(--ink-2);
    max-width: 64ch;
  }
  .score-table {
    width: 100%;
    margin: 0 0 56px;
    border-collapse: collapse;
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
  }
  .score-table th,
  .score-table td {
    padding: 10px 12px 10px 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: baseline;
  }
  .score-table thead th {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
    border-bottom-color: var(--rule-strong);
  }
  .score-table .num {
    text-align: right;
  }
  .score-table tbody th {
    font-weight: 500;
    color: var(--ink-2);
  }
  .score-table .ours th,
  .score-table .ours td {
    color: var(--ink);
    font-weight: 600;
  }
  .trend-wrap {
    display: grid;
    gap: 56px;
    margin-top: 56px;
  }
  .more {
    padding-top: 48px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 980px) {
    .band {
      padding-top: 64px;
    }
  }
  @media (max-width: 560px) {
    .figures b {
      font-size: 2rem;
    }
    .figures {
      font-size: 1rem;
    }
    h1 {
      font-size: 2.25rem;
    }
  }
</style>
