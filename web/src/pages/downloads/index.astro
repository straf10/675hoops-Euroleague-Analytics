---
import { readdirSync } from "node:fs";
import { fileURLToPath } from "node:url";
import Base from "../../layouts/Base.astro";
import JsonLd from "../../components/JsonLd.astro";
import { dataset, type JsonLdObject } from "../../lib/jsonld";
import "../../styles/stats.css";

interface Entry {
  dataset: string;
  season: number;
  path: string;
  rows: number;
  bytes: number;
  sha256: string;
}
interface Manifest {
  built: string;
  files: Entry[];
}
interface Dictionary {
  datasets: Record<string, { name: string; meaning: string }[]>;
}

// The files are a build output (eurohoops export-stats); a build without them still renders.
const manifests = import.meta.glob<Manifest>("../../../public/downloads/manifest.json", {
  eager: true,
  import: "default",
});
const dictionaries = import.meta.glob<Dictionary>("../../../public/downloads/columns.json", {
  eager: true,
  import: "default",
});
const manifest = Object.values(manifests)[0];
const dictionary = Object.values(dictionaries)[0];
if (!manifest || !dictionary) {
  console.warn("downloads: manifest.json or columns.json is missing; the page shows no files.");
}

const LABELS: Record<string, string> = {
  games: "Games",
  team_games: "Team games",
  player_box: "Player box scores",
  shots: "Shots",
};
const season = (s: number) => `${s}-${String((s + 1) % 100).padStart(2, "0")}`;
const size = (b: number) =>
  b >= 1048576 ? `${(b / 1048576).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`;
const built = manifest ? manifest.built.slice(0, 10) : "";
const description =
  "Download 6.75 Analytics EuroLeague data as CSV: games, team and player box scores and shots, one gzipped file per season.";

const origin = Astro.site ?? "https://675hoops.com";
const abs = (path: string) => new URL(path, origin).href;
const root = import.meta.env.BASE_URL.replace(/\/$/, "");
const EUROLEAGUE = { name: "Euroleague Basketball", url: "https://www.euroleaguebasketball.net" };
const EUROLEAGUE_CREDIT =
  "Source: Euroleague Basketball. These statistics remain the property of Euroleague Basketball; they are shared for non-commercial analysis and are not covered by our licence.";
const CC_BY = "https://creativecommons.org/licenses/by/4.0/";
const RAW = "https://raw.githubusercontent.com/straf10/675hoops-Euroleague-Analytics/main";

// One Dataset per EuroLeague-derived dataset (games, team lines, ...), its files as DataDownloads.
// The statistics are Euroleague's and carry no licence of ours: `license` points to this page's
// terms section, which says so (Google wants a licence or terms URL on every Dataset).
const TERMS = abs(`${root}/downloads/#terms`);

const DESCRIPTIONS: Record<string, string> = {
  games: "One row per EuroLeague game, one gzipped CSV file per season.",
  team_games: "One row per club in each EuroLeague game, one gzipped CSV file per season.",
  player_box: "One row per player in each EuroLeague game (box score), one gzipped CSV file per season.",
  shots: "One row per shot in EuroLeague games, one gzipped CSV file per season.",
};
const byDataset = new Map<string, Entry[]>();
for (const f of manifest?.files ?? []) byDataset.set(f.dataset, [...(byDataset.get(f.dataset) ?? []), f]);
const leagueDatasets: JsonLdObject[] = [...byDataset].map(([name, files]) => {
  const seasons = files.map((f) => f.season);
  return dataset({
    name: `EuroLeague ${(LABELS[name] ?? name).toLowerCase()}`,
    description: DESCRIPTIONS[name] ?? "EuroLeague data as gzipped CSV.",
    url: abs(`${root}/downloads/`),
    siteUrl: abs(`${root}/`),
    dateModified: manifest!.built.slice(0, 10),
    temporalCoverage: `${Math.min(...seasons)}/${Math.max(...seasons) + 1}`,
    license: TERMS,
    isBasedOn: EUROLEAGUE,
    creditText: EUROLEAGUE_CREDIT,
    distribution: files.map((f) => ({
      name: `${LABELS[name] ?? name} ${season(f.season)}`,
      contentUrl: abs(`${root}/${f.path}`),
      encodingFormat: "text/csv",
      compressionFormat: "application/gzip",
    })),
  });
});

// The project's own forecast log, CC BY 4.0. The files are read from the predictions folder at build
// time; this Dataset is emitted even when the downloads manifest is absent.
const predictionsDir = fileURLToPath(new URL("../../../../predictions/", import.meta.url));
const forecastFiles = readdirSync(predictionsDir)
  .filter((f) => /^euroleague(_[a-z0-9]+)*_2026-27\.csv$/.test(f))
  .sort();
const forecastLog = dataset({
  name: "6.75 Analytics pre-registered EuroLeague forecast log 2026-27",
  description:
    "Pre-registered EuroLeague 2026-27 game forecasts, one CSV per model. Rows are appended before tip-off and never edited; git history dates every row.",
  url: abs(`${root}/downloads/`),
  siteUrl: abs(`${root}/`),
  temporalCoverage: "2026/2027",
  license: CC_BY,
  distribution: forecastFiles.map((f) => ({
    name: f,
    contentUrl: `${RAW}/predictions/${f}`,
    encodingFormat: "text/csv",
  })),
});

const datasets: JsonLdObject[] = [...leagueDatasets, forecastLog];
---

<Base title="Downloads" description={description} current="downloads">
  <JsonLd slot="head" data={datasets} />
  <header class="wrap head">
    <h1>Downloads</h1>
    {
      manifest && dictionary ? (
        <p class="lede">
          EuroLeague games, box scores and shots as gzipped CSV, one file per dataset and season. Built {built}.
        </p>
      ) : (
        <p class="lede muted">Files are not available in this build.</p>
      )
    }
  </header>

  {
    manifest && dictionary && (
      <>
        <section class="wrap band" aria-labelledby="files-title">
          <header class="sec-head">
            <h2 id="files-title">Files</h2>
            <p>
              Data from the EuroLeague's public API; please cite 6.75 Analytics, see{" "}
              <a class="ink-link" href="/methodology/#citing">
                Methodology
              </a>
              .
            </p>
            <p>Team codes are the ones shown on the site.</p>
          </header>
          <div class="scroll">
            <table class="grid">
              <thead>
                <tr>
                  <th>Season</th>
                  <th>Dataset</th>
                  <th class="num">Rows</th>
                  <th class="num">Size</th>
                  <th>File</th>
                </tr>
              </thead>
              <tbody>
                {manifest.files.map((f) => (
                  <tr>
                    <td>{season(f.season)}</td>
                    <td>{LABELS[f.dataset] ?? f.dataset}</td>
                    <td class="num">{f.rows.toLocaleString("en-US")}</td>
                    <td class="num">{size(f.bytes)}</td>
                    <td>
                      <a class="ink-link" href={`/${f.path}`} download title={`sha256 ${f.sha256}`}>
                        {f.path.split("/").pop()}
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="wrap band" aria-labelledby="columns-title">
          <header class="sec-head">
            <h2 id="columns-title">Columns</h2>
          </header>
          {Object.entries(dictionary.datasets).map(([name, columns]) => (
            <>
              <h3 class="dict-head">{LABELS[name] ?? name}</h3>
              <div class="scroll">
                <table class="grid">
                  <thead>
                    <tr>
                      <th>Column</th>
                      <th>Meaning</th>
                    </tr>
                  </thead>
                  <tbody>
                    {columns.map((c) => (
                      <tr>
                        <td>
                          <code>{c.name}</code>
                        </td>
                        <td class="meaning">{c.meaning}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </>
          ))}
        </section>
      </>
    )
  }

  <section id="terms" class="wrap band" aria-labelledby="terms-title">
    <header class="sec-head">
      <h2 id="terms-title">Data sources and terms</h2>
    </header>
    <p>
      Source: Euroleague Basketball. These statistics remain the property of Euroleague Basketball; they are
      shared for non-commercial analysis and are not covered by our licence.
    </p>
    <p>
      The forecast logs in the{" "}
      <a class="ink-link" href="https://github.com/straf10/675hoops-Euroleague-Analytics/tree/main/predictions">
        predictions/ folder
      </a>{" "}
      on GitHub are licensed under CC BY 4.0 (see{" "}
      <a class="ink-link" href="https://github.com/straf10/675hoops-Euroleague-Analytics/blob/main/LICENSE-DATA">
        LICENSE-DATA
      </a>
      ).
    </p>
  </section>
</Base>

<style>
  .muted {
    color: var(--muted);
  }
  .dict-head {
    margin: 32px 0 12px;
    font-size: 1rem;
    font-weight: 600;
  }
  .meaning {
    white-space: normal;
    color: var(--ink-2);
  }
</style>
